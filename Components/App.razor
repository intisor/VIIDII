    <base href="/" />
    <link rel="stylesheet" href="lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="css/site.css?v=20261015f" />
    <link rel="stylesheet" href="css/auth.css?v=20261015f" />
