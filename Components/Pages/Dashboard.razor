@page "/dashboard"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Dashboard - VIIDII</PageTitle>

<div class="alert alert-info">Redirecting to your dashboard...</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        var currentUser = await AuthService.GetCurrentUserAsync();
        if (currentUser is null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        switch (currentUser.Role)
        {
            case Role.Admin:
                Navigation.NavigateTo("/admin", replace: true);
                break;
            case Role.Lecturer:
                Navigation.NavigateTo("/lecturer/home", replace: true);
                break;
            case Role.Student:
                Navigation.NavigateTo("/student/home", replace: true);
                break;
            default:
                Navigation.NavigateTo("/", replace: true);
                break;
        }
    }
}
