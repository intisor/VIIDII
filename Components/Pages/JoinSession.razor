@page "/join-session"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthService AuthService
@inject SessionService SessionService
@inject NavigationManager Navigation
@using VIIDII.Models

<PageTitle>Join Session - VIIDII</PageTitle>

<style>
    .join-session-container {
        max-width: 1100px;
        margin: 2rem auto;
        padding: 0 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.125rem;
    }

    .page-header {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--r-lg);
        padding: 1.75rem;
    }

    .page-header h1 {
        font-size: 1.625rem;
        font-weight: 700;
        margin-bottom: 0.375rem;
        color: var(--text);
    }
    
    .page-header p {
        color: var(--text-mid);
        font-size: 0.875rem;
        margin: 0;
    }

    .join-methods {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.125rem;
    }

    .method-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--r-lg);
        padding: 1.375rem;
    }

    .method-card h2 {
        font-size: 0.9375rem;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 0.375rem;
    }
    
    .method-card p {
        color: var(--text-mid);
        font-size: 0.875rem;
        margin-bottom: 1rem;
    }

    .sessions-list {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--r-lg);
        padding: 1.375rem;
    }

    .sessions-list h2 {
        font-size: 0.9375rem;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 1.125rem;
    }

    .session-item {
        background: var(--surface-up);
        border: 1px solid var(--border);
        padding: 0.875rem 1rem;
        border-radius: var(--r);
        margin-bottom: 0.625rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: border-color var(--t);
    }

    .session-item:hover {
        border-color: var(--border-mid);
    }

    .session-info h3 {
        margin: 0 0 0.2rem 0;
        color: var(--text);
        font-size: 0.875rem;
        font-weight: 600;
    }

    .session-meta {
        color: var(--text-mid);
        font-size: 0.75rem;
    }

    .session-status {
        padding: 0.2rem 0.6rem;
        border-radius: 100px;
        font-size: 0.6875rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .status-active {
        background: var(--success-dim);
        color: var(--success);
        border: 1px solid rgba(34, 197, 94, 0.2);
    }

    .status-scheduled {
        background: var(--warning-dim);
        color: var(--warning);
        border: 1px solid rgba(245, 158, 11, 0.2);
    }

    .btn-join {
        padding: 0.375rem 0.875rem;
        background: var(--accent);
        color: white;
        border: none;
        border-radius: var(--r-sm);
        font-weight: 600;
        font-size: 0.8125rem;
        cursor: pointer;
        transition: background var(--t);
        margin-left: 1rem;
        font-family: inherit;
    }

    .btn-join:hover {
        background: var(--accent-hover);
    }

    @@media (max-width: 768px) {
        .join-methods {
            grid-template-columns: 1fr;
        }
    }
</style>

@if (CurrentUser == null)
{
    <div class="alert alert-warning">Please log in first.</div>
}
else
{
    <div class="join-session-container">
        <div class="page-header">
            <h1>Join a Session</h1>
            <p>Enter a session code or browse available sessions</p>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger">@ErrorMessage</div>
        }

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="alert alert-info">@SuccessMessage</div>
        }

        <div class="join-methods">
            <div class="method-card">
                <h2>Join with Code</h2>
                <p>Have a session code? Enter it here to join directly.</p>
                <div class="form-group">
                    <label class="form-label">Session Code</label>
                    <input type="text" class="form-control" @bind="SessionCode" placeholder="Enter session code" />
                </div>
                <button class="btn-primary-custom" @onclick="JoinByCode">Join Session</button>
            </div>

            <div class="method-card">
                <h2>Quick Join</h2>
                <p>Join the most recent active session automatically.</p>
                <button class="btn-primary-custom" @onclick="JoinLatestSession">Join Latest Session</button>
            </div>
        </div>

        <div class="sessions-list">
            <h2>Available Sessions</h2>
            @if (AvailableSessions == null || !AvailableSessions.Any())
            {
                <div class="alert alert-info">No active sessions available at the moment.</div>
            }
            else
            {
                @foreach (var session in AvailableSessions)
                {
                    <div class="session-item">
                        <div class="session-info">
                            <h3>@session.Title</h3>
                            <div class="session-meta">
                                <span>Lecturer: @session.LecturerId</span>
                                <span> | </span>
                                <span>Departments: @FormatDepartments(session)</span>
                                <span> | </span>
                                <span>Levels: @FormatLevels(session)</span>
                            </div>
                        </div>
                        <div style="display: flex; align-items: center;">
                            <span class="session-status @(session.IsSessionStarted ? "status-active" : "status-scheduled")">
                                @(session.IsSessionStarted ? "Live" : "Scheduled")
                            </span>
                            <button class="btn-join" @onclick="() => JoinSessionById(session.SessionId)">Join</button>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    private User? CurrentUser;
    private string SessionCode = "";
    private string ErrorMessage = "";
    private string SuccessMessage = "";
    private List<Session> AvailableSessions = new();

    protected override async Task OnInitializedAsync()
    {
        CurrentUser = await AuthService.GetCurrentUserAsync();
        if (CurrentUser == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadAvailableSessions();
    }

    private async Task LoadAvailableSessions()
    {
        try
        {
            AvailableSessions = (await SessionService.GetActiveSessionsAsync())
                .Where(IsSessionAllowedForUser)
                .OrderByDescending(s => s.IsSessionStarted)
                .ThenByDescending(s => s.CreatedAt)
                .ToList();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error loading sessions: {ex.Message}";
        }
    }

    private bool IsSessionAllowedForUser(Session session)
    {
        if (CurrentUser is null)
            return false;

        var deptAllowed = session.AllowedDepartments.Contains(User.Departments.Any) ||
                          (CurrentUser.Department is not null && session.AllowedDepartments.Contains(CurrentUser.Department.Value));

        var lvlAllowed = session.AllowedLevels.Contains(User.Levels.Any) ||
                         (CurrentUser.Level is not null && session.AllowedLevels.Contains(CurrentUser.Level.Value));

        return deptAllowed && lvlAllowed;
    }

    private async Task JoinByCode()
    {
        ErrorMessage = "";
        SuccessMessage = "";

        if (string.IsNullOrWhiteSpace(SessionCode))
        {
            ErrorMessage = "Please enter a session code.";
            return;
        }

        try
        {
            var session = await SessionService.GetSessionByIdAsync(SessionCode);
            if (session != null)
            {
                await JoinSelectedSession(session);
            }
            else
            {
                ErrorMessage = "Session not found. Please check the code and try again.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error joining session: {ex.Message}";
        }
    }

    private async Task JoinLatestSession()
    {
        ErrorMessage = "";
        SuccessMessage = "";

        try
        {
            var latestSession = AvailableSessions.FirstOrDefault();
            if (latestSession != null)
            {
                await JoinSelectedSession(latestSession);
            }
            else
            {
                ErrorMessage = "No active sessions available.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error joining session: {ex.Message}";
        }
    }

    private async Task JoinSessionById(string sessionId)
    {
        ErrorMessage = "";
        SuccessMessage = "";

        try
        {
            var session = await SessionService.GetSessionByIdAsync(sessionId);
            if (session != null)
            {
                await JoinSelectedSession(session);
            }
            else
            {
                ErrorMessage = "Session not found.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error joining session: {ex.Message}";
        }
    }

    private async Task JoinSelectedSession(Session session)
    {
        try
        {
            var (_, error) = SessionService.JoinSession(session.SessionId, CurrentUser!.MatricNo, null);
            if (error is not null)
            {
                ErrorMessage = error;
                return;
            }
            SuccessMessage = $"Successfully joined {session.Title}!";
            
            // Navigate to session view after a brief delay
            await Task.Delay(500);
            Navigation.NavigateTo($"/session/{session.SessionId}");
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error joining session: {ex.Message}";
        }
    }

    private static string FormatDepartments(Session session)
    {
        return session.AllowedDepartments.Contains(User.Departments.Any)
            ? "All Departments"
            : string.Join(", ", session.AllowedDepartments);
    }

    private static string FormatLevels(Session session)
    {
        return session.AllowedLevels.Contains(User.Levels.Any)
            ? "All Levels"
            : string.Join(", ", session.AllowedLevels);
    }
}
