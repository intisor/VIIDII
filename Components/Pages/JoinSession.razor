@page "/join-session"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthService AuthService
@inject SessionService SessionService
@inject NavigationManager Navigation
@using VIIDII.Models

<PageTitle>Join Session - VIIDII</PageTitle>

<style>
    .join-session-container {
        max-width: 1200px;
        margin: 2rem auto;
        padding: 2rem;
    }

    .join-methods {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        margin-bottom: 2rem;
    }

    .alert {
        padding: 1rem;
        border-radius: 0.5rem;
        margin-bottom: 1rem;
    }

    .alert-info {
        background: #d1ecf1;
        color: #0c5460;
        border: 1px solid #bee5eb;
    }

    .alert-warning {
        background: #fff3cd;
        color: #856404;
        border: 1px solid #ffeeba;
    }

    .alert-danger {
        background: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    @@media (max-width: 768px) {
        .join-methods {
            grid-template-columns: 1fr;
        }
    }
</style>

@if (CurrentUser == null)
{
    <div class="alert alert-warning">Please log in first.</div>
}
else
{
    <div class="join-session-container">
        <JoinSessionHeader Title="Join a Session"
                           Subtitle="Enter a session code or browse available sessions" />

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger">@ErrorMessage</div>
        }

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="alert alert-info">@SuccessMessage</div>
        }

        <div class="join-methods">
            <JoinMethodCard Title="Join with Code"
                            Description="Have a session code? Enter it here to join directly."
                            ShowInput="true"
                            InputLabel="Session Code"
                            @bind-InputValue="SessionCode"
                            InputPlaceholder="Enter session code"
                            ButtonText="Join Session"
                            OnAction="@JoinByCode" />

            <JoinMethodCard Title="Quick Join"
                            Description="Join the most recent active session automatically."
                            ShowInput="false"
                            ButtonText="Join Latest Session"
                            OnAction="@JoinLatestSession" />
        </div>

        <SessionsList Sessions="@AvailableSessions"
                      OnJoinSession="@JoinSessionById" />
    </div>
}

@code {
    private User? CurrentUser;
    private string SessionCode = "";
    private string ErrorMessage = "";
    private string SuccessMessage = "";
    private List<Session> AvailableSessions = new();

    protected override async Task OnInitializedAsync()
    {
        CurrentUser = await AuthService.GetCurrentUserAsync();
        if (CurrentUser == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadAvailableSessions();
    }

    private async Task LoadAvailableSessions()
    {
        try
        {
            AvailableSessions = SessionService.GetAllSessions()
                .Where(s => s.Status == SessionStatus.Active || s.IsSessionStarted)
                .Where(IsSessionAllowedForUser)
                .OrderByDescending(s => s.IsSessionStarted)
                .ThenByDescending(s => s.CreatedAt)
                .ToList();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error loading sessions: {ex.Message}";
        }
    }

    private bool IsSessionAllowedForUser(Session session)
    {
        if (CurrentUser is null)
            return false;

        var deptAllowed = session.AllowedDepartments.Contains(User.Departments.Any) ||
                          (CurrentUser.Department is not null && session.AllowedDepartments.Contains(CurrentUser.Department.Value));

        var levelAllowed = session.AllowedLevels.Contains(User.Levels.Any) ||
                           (CurrentUser.Level is not null && session.AllowedLevels.Contains(CurrentUser.Level.Value));

        return deptAllowed && levelAllowed;
    }

    private async Task JoinByCode()
    {
        ErrorMessage = "";
        SuccessMessage = "";

        if (string.IsNullOrWhiteSpace(SessionCode))
        {
            ErrorMessage = "Please enter a session code.";
            return;
        }

        try
        {
            var session = SessionService.GetSessionByCode(SessionCode);
            if (session != null)
            {
                await JoinSelectedSession(session);
            }
            else
            {
                ErrorMessage = "Session not found. Please check the code and try again.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error joining session: {ex.Message}";
        }
    }

    private async Task JoinLatestSession()
    {
        ErrorMessage = "";
        SuccessMessage = "";

        try
        {
            var latestSession = AvailableSessions.FirstOrDefault();
            if (latestSession != null)
            {
                await JoinSelectedSession(latestSession);
            }
            else
            {
                ErrorMessage = "No active sessions available.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error joining session: {ex.Message}";
        }
    }

    private async Task JoinSessionById(string sessionId)
    {
        ErrorMessage = "";
        SuccessMessage = "";

        try
        {
            var session = SessionService.GetSession(sessionId);
            if (session != null)
            {
                await JoinSelectedSession(session);
            }
            else
            {
                ErrorMessage = "Session not found.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error joining session: {ex.Message}";
        }
    }

    private async Task JoinSelectedSession(Session session)
    {
        try
        {
            var (_, error) = SessionService.JoinSession(session.SessionId, CurrentUser!.MatricNo, null);
            if (error is not null)
            {
                ErrorMessage = error;
                return;
            }
            SuccessMessage = $"Successfully joined {session.Title}!";
            
            await Task.Delay(500);
            Navigation.NavigateTo($"/session/{session.SessionId}");
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error joining session: {ex.Message}";
        }
    }
}
