@page "/"
@inject NavigationManager Navigation
@inject AuthService AuthService
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>VIIDII — Live Classroom Platform</PageTitle>

<div class="hero-wrap">
    <div class="hero-content">
        <div class="hero-eyebrow">Live Classroom Platform</div>
        <h1 class="hero-title">VIIDII</h1>
        <p class="hero-desc">
            Real-time video sessions, engagement tracking, and classroom tools
            for lecturers and students.
        </p>

        <div class="hero-actions">
            @if (IsAuthenticated)
            {
                <button id="go-dashboard" class="btn-hero-primary" @onclick="GoDashboard">Go to Dashboard</button>
            }
            else
            {
                <button id="go-login"  class="btn-hero-primary"   @onclick="GoLogin">Sign in</button>
                <button id="go-about" class="btn-hero-secondary"  @onclick="GoAbout">Learn more</button>
            }
        </div>

        <div class="hero-features">
            <div class="feature-pill"><i class="fas fa-video"></i> Live video</div>
            <div class="feature-pill"><i class="fas fa-chart-bar"></i> Engagement tracking</div>
            <div class="feature-pill"><i class="fas fa-comments"></i> Real-time chat</div>
        </div>
    </div>
</div>

<style>
    .hero-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: calc(100vh - 52px); /* minus nav */
        padding: 3rem 1.5rem;
        background: var(--bg);
    }

    .hero-content {
        max-width: 540px;
        text-align: center;
    }

    .hero-eyebrow {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--accent);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 1rem;
    }

    .hero-title {
        font-size: 4rem;
        font-weight: 700;
        letter-spacing: -0.04em;
        color: var(--text);
        margin-bottom: 1rem;
        line-height: 1;
    }

    .hero-desc {
        font-size: 1rem;
        color: var(--text-mid);
        line-height: 1.6;
        margin-bottom: 2rem;
    }

    .hero-actions {
        display: flex;
        gap: 0.75rem;
        justify-content: center;
        flex-wrap: wrap;
        margin-bottom: 2.5rem;
    }

    .btn-hero-primary {
        background: var(--accent);
        color: white;
        border: none;
        padding: 0.7rem 1.75rem;
        border-radius: var(--r);
        font-size: 0.9375rem;
        font-weight: 600;
        cursor: pointer;
        transition: background var(--t);
        font-family: inherit;
    }
    .btn-hero-primary:hover { background: var(--accent-hover); }

    .btn-hero-secondary {
        background: transparent;
        color: var(--text-mid);
        border: 1px solid var(--border-mid);
        padding: 0.7rem 1.75rem;
        border-radius: var(--r);
        font-size: 0.9375rem;
        font-weight: 500;
        cursor: pointer;
        transition: all var(--t);
        font-family: inherit;
    }
    .btn-hero-secondary:hover { color: var(--text); border-color: var(--border-strong); background: var(--surface-up); }

    .hero-features {
        display: flex;
        gap: 0.5rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .feature-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: var(--surface);
        border: 1px solid var(--border);
        color: var(--text-mid);
        padding: 0.35rem 0.875rem;
        border-radius: 100px;
        font-size: 0.8125rem;
        font-weight: 500;
    }

    .feature-pill i { color: var(--accent); font-size: 0.75rem; }
</style>

@code {
    private bool IsAuthenticated { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var user = await AuthService.GetCurrentUserAsync();
        IsAuthenticated = user != null;
    }

    private void GoDashboard() => Navigation.NavigateTo("/dashboard");
    private void GoLogin()     => Navigation.NavigateTo("/login");
    private void GoAbout()     => Navigation.NavigateTo("/about");
}
