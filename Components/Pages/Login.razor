@page "/login"
@using VIIDII.Components.Shared

<PageTitle>Sign in - VIIDII</PageTitle>

<AuthShell Title="Sign in"
           Subtitle="Use the staff or matric number on your records."
           Error="@ErrorMessage">

    @* Server rendered on purpose: this posts to /auth/login, which issues the
       authentication cookie in a normal HTTP response. An interactive EditForm
       runs over a websocket and cannot set a cookie. *@
    <form method="post" action="/auth/login">
        <AntiforgeryToken />

        <input type="hidden" name="returnUrl" value="@ReturnUrl" />

        <div class="auth-field">
            <label class="auth-label" for="matric-input">Staff or matric number</label>
            <input id="matric-input"
                   name="matricNo"
                   type="text"
                   class="auth-input"
                   autocomplete="username"
                   autocapitalize="characters"
                   spellcheck="false"
                   required
                   autofocus
                   maxlength="20"
                   placeholder="e.g. LEC/2019/041"
                   value="@MatricNo" />
        </div>

        <div class="auth-field">
            <label class="auth-label" for="password-input">Password</label>
            <input id="password-input"
                   name="password"
                   type="password"
                   class="auth-input"
                   autocomplete="current-password"
                   required
                   maxlength="256" />
        </div>

        <button id="login-submit" type="submit" class="auth-btn">Sign in</button>
    </form>

    <div class="auth-divider">
        <span>or</span>
    </div>

    <a href="/auth/google" class="btn-google" id="google-login-btn">
        <svg viewBox="0 0 24 24" width="18" height="18">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
        </svg>
        <span>Continue with Google</span>
    </a>

    <p class="auth-alt">
        New here? <a href="/signup">Create an account</a>
    </p>

    <a class="auth-back" href="/">Back to home</a>
</AuthShell>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorCode { get; set; }

    [SupplyParameterFromQuery(Name = "matricNo")]
    private string? MatricNo { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    private string? ErrorMessage => ErrorCode switch
    {
        "invalid" => "That number and password do not match an account.",
        "locked" => "This account is not available. Contact support.",
        "antiforgery" => "This page sat open too long. Please try again.",
        "google_unconfigured" => "Google Sign-In is not yet configured on this server.",
        "google_no_email" => "Could not retrieve your verified email from Google. Please try again.",
        "google_error" => "There was an error communicating with Google. Please try again.",
        _ => null
    };
}