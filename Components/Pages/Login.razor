@page "/login"
@layout EmptyLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Login - VIIDII</PageTitle>

<div class="min-h-screen bg-gradient-to-br from-[#8338EC]/10 via-background to-[#C19BF5]/10 flex items-center justify-center p-4">
      <div class="w-full max-w-md">
        <!-- Logo -->
        <div class="text-center mb-8">
          <div class="inline-flex items-center gap-2 mb-4">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-[#8338EC] to-[#C19BF5] flex items-center justify-center">
               <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white"><path d="m22 8-6 4 6 4V8Z"/><rect width="14" height="12" x="2" y="6" rx="2" ry="2"/></svg>
            </div>
            <span class="text-3xl font-bold bg-gradient-to-r from-[#8338EC] to-[#C19BF5] bg-clip-text text-transparent">
              VIIDII
            </span>
          </div>
          <h1 class="text-2xl font-bold mb-2">Welcome Back</h1>
          <p class="text-muted-foreground">Sign in to access your virtual classroom</p>
        </div>

        <!-- Login Card -->
        <div class="bg-card rounded-2xl shadow-xl border border-border p-8">
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="bg-destructive/15 text-destructive text-sm p-3 rounded-md border border-destructive/20 mb-6 flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
                    @ErrorMessage
                </div>
            }

            <EditForm Model="@LoginModel" OnValidSubmit="@HandleLogin" FormName="LoginForm" class="space-y-6">
                <DataAnnotationsValidator />

                <div class="space-y-2">
                    <label class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70" for="matricNumber">Matric Number</label>
                    <InputText 
                        id="matricNumber" 
                        class="flex h-11 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50" 
                        placeholder="Enter your matric number"
                        @bind-Value="LoginModel.MatricNo" />
                    <ValidationMessage For="@(() => LoginModel.MatricNo)" class="text-xs text-destructive" />
                </div>

                <div class="space-y-2">
                     <label class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70" for="password">Password</label>
                    <div class="relative">
                        <InputText 
                            type="@passwordInputType"
                            id="password" 
                            class="flex h-11 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 pr-10" 
                            placeholder="Enter your password"
                            @bind-Value="LoginModel.Password" />
                        <button
                          type="button"
                          @onclick="TogglePasswordVisibility"
                          class="absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground transition-colors"
                        >
                            @if (showPassword)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                            }
                        </button>
                    </div>
                    <ValidationMessage For="@(() => LoginModel.Password)" class="text-xs text-destructive" />
                </div>

                <div class="space-y-4">
                     <button type="submit" class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 h-11 px-4 py-2 w-full bg-gradient-to-r from-[#8338EC] to-[#C19BF5] hover:opacity-90 text-white shadow-md" disabled="@IsLoading">
                        @if (IsLoading)
                        {
                            <span>Signing in...</span>
                        }
                        else
                        {
                            <span>Sign In</span>
                        }
                    </button>
                    
                    <a href="/" class="flex items-center justify-center text-sm text-muted-foreground hover:text-foreground transition-colors">
                        ← Back to Home
                    </a>
                </div>
            </EditForm>

            <!-- Demo Credentials -->
            <div class="mt-8 pt-6 border-t border-border">
                <p class="text-sm font-medium text-muted-foreground mb-3">Login as:</p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-2 max-h-48 overflow-y-auto pr-1 custom-scrollbar">
                  @foreach (var user in AvailableUsers)
                  {
                    <button
                      type="button"
                      @onclick="() => FillCredentials(user)"
                      class="w-full text-left px-3 py-2 rounded-lg bg-secondary hover:bg-secondary/80 transition-colors text-sm border border-transparent hover:border-border"
                    >
                      <div class="font-medium truncate">@user.Name</div>
                      <div class="text-xs text-muted-foreground flex justify-between">
                          <span>@user.Role</span>
                          <span>@user.MatricNo</span>
                      </div>
                    </button>
                  }
                </div>
                <p class="text-xs text-muted-foreground mt-3 text-center">
                  Click any user to auto-fill credentials
                </p>
            </div>
        </div>
      </div>
</div>

@code {
private LoginRequest LoginModel = new();
private string? ErrorMessage;
private bool IsLoading = false;
private List<UserInfo> AvailableUsers = new();
private bool showPassword = false;
private string passwordInputType => showPassword ? "text" : "password";

protected override void OnInitialized()
{
    // Mock user data from previous implementation
    AvailableUsers = new List<UserInfo>
    {
        new UserInfo("Intisor", "123456", "Student"),
        new UserInfo("Goodluck", "654321", "Student"),
        new UserInfo("Ade", "789012", "Student"),
        new UserInfo("Umar", "383012", "Student"),
        new UserInfo("Alice", "100001", "Student"),
        new UserInfo("John doe", "Lec001", "Lecturer"),
        new UserInfo("Dr. Brown", "Lec002", "Lecturer"),
        new UserInfo("Admin", "Admin", "Admin")
    };
}

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private void FillCredentials(UserInfo user)
    {
        LoginModel.MatricNo = user.MatricNo;
        LoginModel.Password = "studpass1"; // Default password for demo
        ErrorMessage = null;
    }

    private async Task HandleLogin()
    {
        IsLoading = true;
        ErrorMessage = null;
        
        // Small artificial delay to show loading state if desired
        await Task.Delay(500);

        var (success, message, user) = await AuthService.LoginAsync(LoginModel.MatricNo, LoginModel.Password);

        if (success && user != null)
        {
            Navigation.NavigateTo("/dashboard");
        }
        else
        {
            ErrorMessage = message ?? "Login failed. Please check credentials.";
        }

        IsLoading = false;
    }

    public class LoginRequest
    {
        public string MatricNo { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    public record UserInfo(string Name, string MatricNo, string Role);
}
