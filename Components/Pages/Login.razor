@page "/login"
@using VIIDII.Components.Shared

<PageTitle>Sign in - VIIDII</PageTitle>

<AuthShell Title="Sign in"
           Subtitle="Use the staff or matric number on your records."
           Error="@ErrorMessage">

    @* Server rendered on purpose: this posts to /auth/login, which issues the
       authentication cookie in a normal HTTP response. An interactive EditForm
       runs over a websocket and cannot set a cookie. *@
    <form method="post" action="/auth/login">
        <AntiforgeryToken />

        <input type="hidden" name="returnUrl" value="@ReturnUrl" />

        <div class="auth-field">
            <label class="auth-label" for="matric-input">Staff or matric number</label>
            <input id="matric-input"
                   name="matricNo"
                   type="text"
                   class="auth-input"
                   autocomplete="username"
                   autocapitalize="characters"
                   spellcheck="false"
                   required
                   autofocus
                   maxlength="20"
                   placeholder="e.g. LEC/2019/041"
                   value="@MatricNo" />
        </div>

        <div class="auth-field">
            <label class="auth-label" for="password-input">Password</label>
            <input id="password-input"
                   name="password"
                   type="password"
                   class="auth-input"
                   autocomplete="current-password"
                   required
                   maxlength="256" />
        </div>

        <button id="login-submit" type="submit" class="auth-btn">Sign in</button>
    </form>

    <p class="auth-alt">
        New here? <a href="/signup">Create an account</a>
    </p>

    <a class="auth-back" href="/">Back to home</a>
</AuthShell>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorCode { get; set; }

    [SupplyParameterFromQuery(Name = "matricNo")]
    private string? MatricNo { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    private string? ErrorMessage => ErrorCode switch
    {
        "invalid" => "That number and password do not match an account.",
        "locked" => "This account is not available. Contact support.",
        "antiforgery" => "This page sat open too long. Please try again.",
        _ => null
    };
}