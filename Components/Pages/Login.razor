@page "/login"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Sign in — VIIDII</PageTitle>

<div class="login-wrap">
    <div class="login-card">
        <div class="login-brand">VIIDII</div>
        <h1 class="login-heading">Sign in</h1>
        <p class="login-sub">Select your account to continue.</p>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="login-error">
                <i class="fas fa-exclamation-circle"></i>
                @ErrorMessage
            </div>
        }

        <EditForm Model="@LoginModel" OnValidSubmit="@HandleLogin" FormName="LoginForm">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label class="form-label" for="user-select">Account</label>
                <InputSelect id="user-select" class="form-control" @bind-value="LoginModel.MatricNo" @bind-value:after="OnUserSelected">
                    <option value="">— Choose an account —</option>
                    @foreach (var user in AvailableUsers)
                    {
                        <option value="@user.MatricNo">@user.Name · @user.Role</option>
                    }
                </InputSelect>
            </div>

            <div class="form-group">
                <label class="form-label" for="password-input">Password</label>
                <InputText id="password-input" type="password" class="form-control" @bind-value="LoginModel.Password" placeholder="Password" />
            </div>

            <button id="login-submit" type="submit" class="login-btn" disabled="@IsLoading">
                @if (IsLoading) { <span>Signing in…</span> } else { <span>Sign in</span> }
            </button>
        </EditForm>
    </div>
</div>

<style>
    .login-wrap {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        padding: 2rem 1rem;
        background: var(--bg);
    }

    .login-card {
        width: 100%;
        max-width: 380px;
        background: var(--surface);
        border: 1px solid var(--border-mid);
        border-radius: var(--r-lg);
        padding: 2.25rem;
    }

    .login-brand {
        font-size: 0.8125rem;
        font-weight: 700;
        color: var(--text-mid);
        letter-spacing: -0.01em;
        margin-bottom: 1.75rem;
    }

    .login-heading {
        font-size: 1.375rem;
        font-weight: 700;
        color: var(--text);
        margin-bottom: 0.375rem;
    }

    .login-sub {
        font-size: 0.875rem;
        color: var(--text-mid);
        margin-bottom: 1.75rem;
    }

    .login-error {
        background: var(--danger-dim);
        color: var(--danger);
        border: 1px solid rgba(239, 68, 68, 0.2);
        padding: 0.625rem 0.875rem;
        border-radius: var(--r-sm);
        margin-bottom: 1.25rem;
        font-size: 0.8125rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .login-btn {
        width: 100%;
        padding: 0.7rem;
        background: var(--accent);
        color: white;
        border: none;
        border-radius: var(--r);
        font-size: 0.9375rem;
        font-weight: 600;
        cursor: pointer;
        transition: background var(--t);
        font-family: inherit;
        margin-top: 0.5rem;
    }
    .login-btn:hover:not(:disabled) { background: var(--accent-hover); }
    .login-btn:disabled { opacity: 0.5; cursor: not-allowed; }
</style>

@code {
    private LoginRequest LoginModel = new();
    private string? ErrorMessage;
    private bool IsLoading = false;
    private List<UserInfo> AvailableUsers = new();

    protected override void OnInitialized()
    {
        AvailableUsers = new List<UserInfo>
        {
            new UserInfo("Intisor",   "123456", "Student"),
            new UserInfo("Goodluck",  "654321", "Student"),
            new UserInfo("Ade",       "789012", "Student"),
            new UserInfo("Umar",      "383012", "Student"),
            new UserInfo("Alice",     "100001", "Student"),
            new UserInfo("Brian",     "100002", "Student"),
            new UserInfo("Cynthia",   "100003", "Student"),
            new UserInfo("John Doe",  "Lec001", "Lecturer"),
            new UserInfo("Dr. Brown", "Lec002", "Lecturer"),
            new UserInfo("Admin",     "Admin",  "Admin")
        };
    }

    private void OnUserSelected()
    {
        if (!string.IsNullOrEmpty(LoginModel.MatricNo))
            LoginModel.Password = "studpass1";
    }

    private async Task HandleLogin()
    {
        IsLoading = true;
        ErrorMessage = null;

        var (success, message, user) = await AuthService.LoginAsync(LoginModel.MatricNo, LoginModel.Password);

        if (success && user != null)
            Navigation.NavigateTo("/dashboard");
        else
            ErrorMessage = message ?? "Login failed";

        IsLoading = false;
    }

    public class LoginRequest
    {
        public string MatricNo { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    public record UserInfo(string Name, string MatricNo, string Role);
}
