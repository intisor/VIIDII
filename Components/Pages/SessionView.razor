    [JSInvokable]
    public async Task OnTabVisibilityChanged(bool isVisible)
    {
        // Only track for students in active sessions
        if (State.IsLecturer || !State.IsSessionStarted)
        {
            Console.WriteLine($"Tab visibility ignored: IsLecturer={State.IsLecturer}, SessionStarted={State.IsSessionStarted}");
            return;
        }

        Console.WriteLine($"Student tab visibility changed: {isVisible}");

        // Report to SignalR for engagement tracking
        if (_hubConnection != null && _hubConnection.State == HubConnectionState.Connected)
        {
            try
            {
                await _hubConnection.SendAsync("UpdateTabStatus", isVisible);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error updating tab status: {ex.Message}");
            }
        }
    }

