    /// <summary>
    /// Reports LiveKit's progress into the existing diagnostics panel, so the stage a
    /// student reads on their phone is identical whichever media path produced it.
    /// </summary>
    /// <summary>
    /// Media progress from either path, so a phone shows one stage line whichever
    /// media stack produced it.
    /// <para>
    /// The source is passed in rather than inferred from the stage text. Inferring it
    /// by prefixing anything unrecognised meant a PeerJS message arrived wearing the
    /// LiveKit prefix, which is how a stale PeerJS stall was read as a LiveKit fault.
    /// The stack that reports is now the stack that says so.
    /// </para>
    /// </summary>
    [JSInvokable]
    public Task OnMediaState(string stage, string detail, string source)
    {
        var label = string.IsNullOrWhiteSpace(source) ? "media" : source;
        State.MediaStage = stage;
        State.MediaDetail = (string.IsNullOrWhiteSpace(detail) ? string.Empty : detail) + $"  [{label}]";

        Console.WriteLine($"[SessionView C#] Media state ({label}): {stage} {detail}");
        return InvokeAsync(StateHasChanged);
    }

