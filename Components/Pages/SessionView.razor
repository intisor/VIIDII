@page "/session/{SessionId}"
@* No [Authorize] here on purpose. Students have no account to authenticate with;
   they hold a seat claimed against the class list, and ResolveIdentityAsync is the
   gate that accepts either a signed in member of staff or a seat for this session's
   class. Removing the attribute does not open the room, it only moves the check to
   where the two kinds of identity can both be considered. *@
@layout SessionLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable
@inject AuthService AuthService
@inject SessionService SessionService
@inject ClassService ClassService
@inject RosterService RosterService
@inject ISessionJsInterop SessionJsInterop
@inject UserService UserLookupService
@inject StudentSeatService SeatService
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@using VIIDII.Models
@using VIIDII.Services
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.JSInterop

<PageTitle>Session - @SessionId</PageTitle>

@if (_isNavigating)
{
    <div class="loading-screen">
        <div class="spinner"></div>
        <p>Loading session...</p>
    </div>
}
else if (Identity is null)
{
    <div class="alert alert-warning">Please log in, or use the link your lecturer shared.</div>
}
else if (CurrentSession == null)
{
    <div class="alert alert-danger">Session not found or you don't have access.</div>
}
else if (_sessionEndedForStudent)
{
    <div class="student-completion-screen">
        <div class="completion-card">
            <div class="completion-header">
                <div class="completion-icon-wrapper">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                </div>
                <h2>Class Concluded</h2>
                <p class="completion-subtitle">The lecture session has ended. Your verified attendance record has been preserved.</p>
            </div>

            <div class="receipt-card">
                <div class="receipt-header">
                    <span>ATTENDANCE RECEIPT</span>
                    <span class="receipt-status-badge">
                        <span class="status-dot"></span> Logged
                    </span>
                </div>
                <div class="receipt-divider"></div>
                <div class="receipt-grid">
                    <div class="receipt-row">
                        <span class="receipt-label">Session Topic</span>
                        <span class="receipt-value font-medium">@CurrentSession.Title</span>
                    </div>
                    @if (CurrentSession.Class != null)
                    {
                        <div class="receipt-row">
                            <span class="receipt-label">Course / Class</span>
                            <span class="receipt-value">@(string.IsNullOrWhiteSpace(CurrentSession.Class.Code) ? CurrentSession.Class.Name : $"{CurrentSession.Class.Code} - {CurrentSession.Class.Name}")</span>
                        </div>
                    }
                    <div class="receipt-row">
                        <span class="receipt-label">Student Name</span>
                        <span class="receipt-value font-medium">@Identity.Name</span>
                    </div>
                    <div class="receipt-row">
                        <span class="receipt-label">Matric / Identifier</span>
                        <span class="receipt-value font-mono">@Identity.MatricNo</span>
                    </div>
                    <div class="receipt-row">
                        <span class="receipt-label">Completion Time</span>
                        <span class="receipt-value">@DateTime.Now.ToString("MMM dd, yyyy · hh:mm tt")</span>
                    </div>
                    <div class="receipt-row">
                        <span class="receipt-label">Session Reference</span>
                        <span class="receipt-value font-mono">@CurrentSession.SessionId</span>
                    </div>
                </div>
            </div>

            <div class="completion-privacy-note">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                <span>All video/audio streams, peer connections, and shared temporary buffers have been securely cleared from your device. You may safely close this window.</span>
            </div>

            <div class="completion-actions">
                <a href="/" class="btn btn-primary completion-home-btn">
                    Return to Home
                </a>
                <button type="button" class="btn btn-secondary completion-close-btn" onclick="window.close();">
                    Close Tab
                </button>
            </div>
        </div>
    </div>
}
else
{
    <div class="session-container">
        <!-- Compact Top Bar -->
        <div class="session-header">
            <div class="session-header-left">
                <h1>@CurrentSession.Title</h1>
                @if (State.IsSessionStarted)
                {
                    <span class="live-badge"><span class="live-dot"></span>LIVE</span>
                }
                else
                {
                    <span class="status-badge">@State.Status</span>
                }
            </div>
            <div class="session-header-right">
                <span class="session-code">@SessionId</span>
                @if (State.IsLecturer && State.ParticipantCount > 0)
                {
                    <span class="participant-badge">
                        <i class="fas fa-users"></i>
                        @State.ParticipantCount
                    </span>
                }
            </div>
        </div>

        <!-- Error Banner -->
        @if (!string.IsNullOrEmpty(State.ErrorMessage))
        {
            <div class="error-banner">
                <i class="fas fa-exclamation-triangle"></i>
                <span>@State.ErrorMessage</span>
                @if (!State.HasExceededMaxAttempts && !State.IsLecturer)
                {
                    <button class="btn-retry" @onclick="RetryConnection">Retry</button>
                }
                else if (State.HasExceededMaxAttempts)
                {
                    <button class="btn-retry" @onclick="RefreshPage">Refresh Page</button>
                }
            </div>
        }

        <!-- Attendee list (Lecturer Only, Before Session Starts) -->
        @if (State.IsLecturer && !State.IsSessionStarted)
        {
            <div class="roster-entry-card">
                <div class="roster-entry-text">
                    <h3>Attendee list</h3>
                    <p>
                        Upload the class list so VIIDII knows who is expected. Each student gets a
                        join code, and attendance is recorded against their verified identity.
                    </p>
                </div>
                @* Class-scoped, not session-scoped: the roster belongs to the class and is reused by
               every session in it. This used to point at /session/{id}/roster, which
               does not exist, so "Manage list" was a 404. *@
                <a class="btn-control" href="/classes/@(CurrentSession?.ClassId)/roster">
                    <i class="fas fa-users"></i>
                    <span class="control-label">Manage list</span>
                </a>
            </div>
        }

        <!-- Share the student link (Lecturer Only) -->
        @if (State.IsLecturer && !string.IsNullOrWhiteSpace(JoinUrl))
        {
            <div class="roster-entry-card share-card">
                <div class="roster-entry-text">
                    <h3>Share with your students</h3>
                    <p>
                        This is the same link every week. Send it in your class group; nobody has to
                        make an account.
                    </p>
                    <code class="share-url">@JoinUrl</code>
                </div>
                <div class="share-actions">
                    <button class="btn-control" @onclick="CopyJoinLink">
                        <i class="fas fa-copy"></i>
                        <span class="control-label">@JoinLinkLabel</span>
                    </button>
                    @* WhatsApp needs no clipboard permission, which matters because
                       clipboard writes are refused on unfocused tabs, on some
                       in-app browsers, and anywhere the origin is not secure. Most
                       lecturers are forwarding this from a class group, so a button
                       that hands the text to WhatsApp is the one that reliably works. *@
                    <a class="btn-control" href="@WhatsAppHref" target="_blank" rel="noopener noreferrer">
                        <i class="fab fa-whatsapp"></i>
                        <span class="control-label">WhatsApp</span>
                    </a>
                </div>
            </div>
        }

        <!-- Setup configuration section (Lecturer Only, Before Session Starts) -->
        @if (State.IsLecturer && !State.IsSessionStarted && State.ShowTestCameraSection)
        {
            <div class="setup-layout">
                <div class="setup-card">
                    <div class="setup-header">
                        <h3>Device Preview</h3>
                        <p>Configure and verify your camera output before launching the live classroom session.</p>
                    </div>

                    <div class="test-video-container">
                        <video id="testVideo" autoplay playsinline muted class="test-video"></video>
                        @if (!State.IsTestingCamera)
                        {
                            <div class="camera-off-placeholder">
                                <i class="fas fa-video-slash"></i>
                                <span>Webcam is currently offline</span>
                            </div>
                        }
                    </div>

                    <div class="test-controls">
                        @if (!State.IsTestingCamera)
                        {
                            <button class="btn btn-primary btn-lg" @onclick="TestCamera" id="test-camera-btn">
                                <i class="fas fa-video"></i> Start Camera Test
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-secondary" @onclick="StopTestCamera" id="stop-test-btn">
                                <i class="fas fa-stop"></i> Stop Test
                            </button>
                            <button class="btn btn-success" @onclick="StartSessionWithCamera" id="start-session-btn">
                                <i class="fas fa-play"></i> Start Session
                            </button>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Mobile View Mode Segmented Switcher -->
        @if (State.IsSessionStarted)
        {
            <div class="mobile-view-tabs">
                <button type="button" class="m-tab @(_mobileViewMode == "split" ? "active" : "")" @onclick='() => _mobileViewMode = "split"'>
                    <i class="fas fa-columns"></i>
                    <span>Split</span>
                </button>
                <button type="button" class="m-tab @(_mobileViewMode == "video" ? "active" : "")" @onclick='() => _mobileViewMode = "video"'>
                    <i class="fas fa-video"></i>
                    <span>Video Focus</span>
                </button>
                <button type="button" class="m-tab @(_mobileViewMode == "chat" ? "active" : "")" @onclick='() => _mobileViewMode = "chat"'>
                    <i class="fas fa-comments"></i>
                    <span>Chat & Class</span>
                </button>
            </div>
        }

        <!-- Session Body: sidebar layout -->
        @if (State.IsSessionStarted || State.IsTestingCamera || !State.IsLecturer)
        {
            <div class="session-body mode-@_mobileViewMode">
                <div class="video-panel">
                <div class="video-container" id="videoContainer">
                    <!-- Main Video Element -->
                    <video id="sessionVideo" 
                           autoplay 
                           playsinline 
                           muted="@State.IsLecturer"
                           class="session-video @(State.IsLecturer ? "local-stream" : "") @(_isVideoFlipped ? "flipped" : "") @(State.IsScreenSharing ? "screen-share" : "")">
                    </video>

                    <!-- Live Captions Subtitle Overlay -->
                    <div class="caption-overlay-container" id="captionOverlay" style="display:none;">
                        <div class="caption-bubble">
                            <span class="caption-speaker" id="captionSpeaker"></span>
                            <span class="caption-text" id="captionText"></span>
                        </div>
                    </div>

                    <!-- Loading Overlay -->
                    @if (State.IsLoading || State.IsInitializing)
                    {
                        <div class="loading-overlay">
                            <div class="spinner"></div>
                            <p>@(State.LoadingMessage ?? (State.IsLecturer ? "Initializing camera..." : "Connecting to session..."))</p>
                        </div>
                    }

                    <!-- Pre-session: Waiting for Host (Attendee Only) -->
                    @if (!State.IsLecturer && !State.IsSessionStarted && !State.IsLoading)
                    {
                        <div class="waiting-overlay">
                            <div class="spinner"></div>
                            <p>Waiting for the host to start the session...</p>
                        </div>
                    }

                    <!-- Mobile Play Overlay -->
                    @if (State.ShowMobilePlayOverlay && !State.IsLecturer)
                    {
                        <div class="mobile-play-overlay" @onclick="PlayVideo">
                            <div class="play-button">
                                <div class="play-icon-circle">
                                    <i class="fas fa-play"></i>
                                </div>
                                <p>Tap to start stream</p>
                            </div>
                        </div>
                    }

                    <!-- Waiting for Host Stream (Student View) -->
                    @if (!State.IsLecturer && !State.HasStream && State.IsSessionStarted)
                    {
                        <div class="waiting-overlay">
                            <div class="spinner"></div>
                            <p>Waiting for host to start streaming...</p>
                        </div>
                    }

                    <!-- Stream Type Indicator -->
                    @if (State.IsLecturer && State.IsWebcamActive)
                    {
                        <div class="stream-indicator">
                            <i class="fas fa-@(State.IsScreenSharing ? "desktop" : "video")"></i>
                            <span>@(State.IsScreenSharing ? "Screen Sharing" : "Camera")</span>
                        </div>
                    }
                </div>

                <!-- Video Controls (Below Video) -->
                <div class="video-controls-container">
                    @if (State.IsLecturer && State.IsWebcamActive)
                    {
                        <div class="video-controls lecturer-controls">
                            <button class="btn-control" @onclick="ToggleScreenShare" disabled="@State.IsLoading" title="Share your screen or camera">
                                <i class="fas fa-@(State.IsScreenSharing ? "video" : "desktop")"></i>
                                <span class="control-label">@(State.IsScreenSharing ? "Camera" : "Share Screen")</span>
                            </button>

                            <button class="btn-control @(_isVideoFlipped ? "active" : "")" @onclick="ToggleVideoFlip" title="Flip camera view horizontally">
                                <i class="fas fa-arrows-alt-h"></i>
                                <span class="control-label">@(_isVideoFlipped ? "Unflip" : "Flip")</span>
                            </button>

                            <button class="btn-control @(IsCaptionsBroadcasting ? "active success" : "")" @onclick="ToggleHostCaptions" title="Broadcast live subtitles to attendees">
                                <i class="fas fa-closed-captioning"></i>
                                <span class="control-label">@(IsCaptionsBroadcasting ? "Captions Live" : "Captions")</span>
                            </button>
                            
                            <button class="btn-control btn-danger" @onclick="EndSession" title="End session for all participants">
                                <i class="fas fa-stop"></i>
                                <span class="control-label">End</span>
                            </button>
                        </div>
                    }
                    @if (!State.IsLecturer && State.IsSessionStarted)
                    {
                        <div class="video-controls student-controls">
                            <button class="btn-control @(_isVideoFlipped ? "active" : "")" @onclick="ToggleVideoFlip" title="Flip or unflip video view">
                                <i class="fas fa-arrows-alt-h"></i>
                                <span class="control-label">@(_isVideoFlipped ? "Unflip" : "Flip")</span>
                            </button>

                            <button class="btn-control @(IsCaptionsEnabled ? "active" : "")" @onclick="ToggleStudentCaptions" title="Toggle live subtitles overlay">
                                <i class="fas fa-closed-captioning"></i>
                                <span class="control-label">@(IsCaptionsEnabled ? "CC On" : "CC Off")</span>
                            </button>

                            <button class="btn-control @(_isAudioOnly ? "active warning" : "")" @onclick="ToggleAudioOnlyAsync" title="Toggle audio only to save mobile data">
                                <i class="fas fa-@(_isAudioOnly ? "headphones" : "tv")"></i>
                                <span class="control-label">@(_isAudioOnly ? "Saving Data" : "Data Saver")</span>
                            </button>

                            <button class="btn-control btn-leave" @onclick="StudentLeaveSession" title="Leave class and view attendance receipt">
                                <i class="fas fa-sign-out-alt"></i>
                                <span class="control-label">Leave</span>
                            </button>
                        </div>
                    }
                </div>
                </div> <!-- /video-panel -->

                <!-- Side Panel: chat + participants + issue buttons -->
                @if (State.IsSessionStarted)
                {
                    <div class="side-panel">
                        <div class="tab-section">
                            <!-- Tab Headers -->
                            <div class="tab-headers">
                                <button class="tab-header @(State.ActiveTab == "messages" ? "active" : "")" 
                                        @onclick='() => State.SetTab("messages")'>
                                    <i class="fas fa-comments"></i>
                                    <span>Messages</span>
                                </button>
                                <button class="tab-header @(State.ActiveTab == "participants" ? "active" : "")" 
                                        @onclick='() => State.SetTab("participants")'>
                                    <i class="fas fa-users"></i>
                                    <span>Participants (@State.ParticipantCount)</span>
                                </button>
                            </div>

                            <!-- Tab Content -->
                            <div class="tab-content">
                                @if (State.ActiveTab == "messages")
                                {
                                    <MessagingPanel SessionId="@SessionId"
                                                   IsLecturer="@State.IsLecturer"
                                                   HubConnection="@_hubConnection"
                                                   CurrentUserId="@(State.CurrentUser?.MatricNo ?? "")"
                                                   CurrentUserName="@(State.CurrentUser?.Name ?? State.CurrentUser?.MatricNo ?? "")" />
                                }
                                else
                                {
                                    <ParticipantPanel @key="@_participantPanelVersion"
                                                      ExpectedStudents="@ExpectedStudents"
                                                      Participants="@EffectiveParticipants"
                                                      ParticipantStatuses="@State.ParticipantStatuses"
                                                      HubConnection="@_hubConnection"
                                                      SessionId="@SessionId"
                                                      SessionTitle="@State.SessionTitle"
                                                      IsLecturer="@State.IsLecturer" />
                                }
                            </div>
                        </div>

                        <!-- Issue flags (student only, inside side panel) -->
                        @if (!State.IsLecturer)
                        {
                            <IssueButtons HubConnection="@_hubConnection" />
                        }
                    </div>
                }
            </div> <!-- /session-body -->
        }
    </div>

    <!-- Engagement Modal (Student Only) -->
    @if (!State.IsLecturer)
    {
        <EngagementModal HubConnection="@_hubConnection"
                         SessionId="@SessionId"
                         IsStudent="true"
                         ShouldShow="@_showEngagementModal"
                         QuizId="@_currentQuizId"
                         QuestionText="@_currentQuizQuestion"
                         Options="@_currentQuizOptions"
                         SourceQuote="@_currentQuizSourceQuote"
                         InitialTimeoutSeconds="@_currentQuizTimeout"
                         OnHidden="@HideEngagementModal" />
    }
}

@code {
    [Parameter]
    public string SessionId { get; set; } = string.Empty;

    // State
    private SessionState State = new();
    private VIIDII.Models.Session? CurrentSession;
    private HubConnection? _hubConnection;
    private DotNetObjectReference<SessionView>? _dotNetRef;
    private bool _showEngagementModal = false;
    private string? _currentQuizId;
    private string? _currentQuizQuestion;
    private string[]? _currentQuizOptions;
    private int _currentQuizTimeout = 30;
    private string? _currentQuizSourceQuote;
    private bool _isDisposed = false;
    private bool _isNavigating = false; // Prevent render after navigation
    private bool _sessionEndedForStudent = false; // Render attendance receipt
    private bool IsLecturer => State.IsLecturer;
    private bool _pendingStudentPeerSetup = false;
    // LiveKit is started once per component. Blazor re-renders often, and each
    // render would otherwise open another room connection for the same session.
    private bool _liveKitStarted = false;

    /// <summary>
    /// Where students go. One link per class, not per session, because the class list
    /// is what they need and a lecturer runs the same cohort all semester. Looking it
    /// up from the class rather than building it here keeps that single source of
    /// truth.
    /// </summary>
    private string? _joinUrl;
    private string? _classCode;

    private string? JoinUrl => _joinUrl;

    private string JoinLinkLabel => _joinLinkLabel;
    private string _joinLinkLabel = "Copy link";

    /// <summary>
    /// Opens WhatsApp with the join link already typed. The message is fixed text
    /// rather than something the lecturer writes, so it reads as a link being sent
    /// on purpose rather than an ad.
    /// </summary>
    private string? WhatsAppHref => _joinUrl is null
        ? null
        : $"https://wa.me/?text={Uri.EscapeDataString($"Join our class: {_joinUrl}")}";

    private async Task CopyJoinLink()
    {
        if (string.IsNullOrWhiteSpace(_joinUrl))
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _joinUrl);
            _joinLinkLabel = "Copied";
        }
        catch (JSException)
        {
            // Clipboard access needs a secure context, so it fails on plain HTTP.
            // The link is on screen and can still be selected by hand.
            _joinLinkLabel = "Copy unavailable";
        }
    }

    /// <summary>
    /// Everyone expected to be in the room, so the lecturer can see who has not
    /// turned up rather than only who has. Loaded once with the rest of the
    /// session: the class list cannot change while a session is running.
    /// </summary>
    private IReadOnlyList<ParticipantPanel.ExpectedStudent> ExpectedStudents { get; set; } = [];

    private async Task LoadExpectedStudentsAsync()
    {
        ExpectedStudents = [];

        if (CurrentSession?.ClassId is not int classId || classId <= 0)
        {
            return;
        }

        var entries = await RosterService.GetForClassAsync(classId);

        ExpectedStudents = entries
            .Where(e => !string.IsNullOrWhiteSpace(e.Identifier) && !string.IsNullOrWhiteSpace(e.DisplayName))
            .Select(e => new ParticipantPanel.ExpectedStudent(e.Identifier, e.DisplayName))
            .OrderBy(e => e.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    /// <summary>Resolves the student link for this session's class, if it has one.</summary>
    private async Task LoadJoinUrlAsync()
    {
        _joinUrl = null;
        _classCode = null;

        // Sessions can predate classes, and ClassId is nullable. Nothing to share then.
        if (CurrentSession?.ClassId is not int classId || classId <= 0)
        {
            return;
        }

        var cls = await ClassService.GetByIdAsync(classId);

        if (cls is null || string.IsNullOrWhiteSpace(cls.Code))
        {
            return;
        }

        _classCode = cls.Code;
        _joinUrl = $"{Navigation.BaseUri.TrimEnd('/')}/join/{_classCode}";
    }
    private int _participantPanelVersion = 0;
    private Dictionary<string, string> EffectiveParticipants
    {
        get
        {
            var participants = new Dictionary<string, string>(State.Participants, StringComparer.OrdinalIgnoreCase);
            foreach (var connectedStudent in State.ConnectedStudents)
            {
                if (!string.IsNullOrWhiteSpace(connectedStudent.Key) && !string.IsNullOrWhiteSpace(connectedStudent.Value))
                {
                    if (!participants.ContainsKey(connectedStudent.Key))
                    {
                        participants[connectedStudent.Key] = connectedStudent.Value;
                    }
                }
            }

            return participants;
        }
    }

    /// <summary>
    /// Who is in the room. A member of staff with an account, or a student holding a
    /// seat claimed against the class list.
    /// </summary>
    private sealed record RoomIdentity(User? User, string MatricNo, string Name, bool IsStudent);

    private RoomIdentity? Identity { get; set; }

    /// <summary>
    /// Works out who is in the room, or null if they should not be here.
    ///
    /// A student seat is only honoured for a session of the class it was claimed in.
    /// Without that check a seat for one class would open any session whose link
    /// reached the student.
    /// </summary>
    private async Task<RoomIdentity?> ResolveIdentityAsync()
    {
        var signedIn = await AuthService.GetCurrentUserAsync();
        if (signedIn is not null)
        {
            return new RoomIdentity(signedIn, signedIn.MatricNo, signedIn.Name, IsStudent: false);
        }

        var seat = SeatService.Read(HttpContextAccessor.HttpContext);

        if (seat is null || CurrentSession is null)
        {
            return null;
        }

        // StudentSeatService owns the rule about which seats open which room, so it can
        // be tested without standing up a whole classroom.
        if (!SeatService.Allows(HttpContextAccessor.HttpContext, CurrentSession))
        {
            return null;
        }

        // Detached, never tracked and never added. Students have no row in Users,
        // and this object must not become one. Only MatricNo and Name are read.
        var synthetic = new VIIDII.Models.User
        {
            Id = 0,
            MatricNo = seat.MatricNo,
            Name = seat.DisplayName,
            Role = VIIDII.Models.Role.Student
        };

        return new RoomIdentity(synthetic, seat.MatricNo, seat.DisplayName, IsStudent: true);
    }

    // Lifecycle Methods
    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine($"[SessionView C#] OnInitializedAsync started. SessionId: {SessionId}");
        try
        {
            // Load the session first. The seat check depends on which class it belongs
            // to, and a session that does not exist needs no further work.
            CurrentSession = await SessionService.GetSessionByIdAsync(SessionId);
            if (CurrentSession == null)
            {
                Console.WriteLine($"[SessionView C#] OnInitializedAsync: Session {SessionId} not found, redirecting to /dashboard");
                _isNavigating = true;
                Navigation.NavigateTo("/dashboard", forceLoad: true);
                return;
            }

            // Who is in the room. Either a signed in member of staff, or a student
            // holding a seat claimed against the class list.
            Identity = await ResolveIdentityAsync();

            if (Identity is null)
            {
                Console.WriteLine($"[SessionView C#] No signed in user and no valid seat, redirecting to /login");
                _isNavigating = true;
                Navigation.NavigateTo("/login", forceLoad: true);
                return;
            }

            State.CurrentUser = Identity.User;
            Console.WriteLine($"[SessionView C#] Identity loaded: MatricNo={Identity.MatricNo}, Name={Identity.Name}, IsStudent={Identity.IsStudent}");

            // NOW try to restore state (after user is loaded)
            await TryRestoreSessionStateAsync();

            // Initialize state
            State.SessionId = SessionId;
            State.SessionTitle = CurrentSession.Title;
            State.Status = CurrentSession.Status;
            State.IsSessionStarted = CurrentSession.IsSessionStarted;
            State.IsLecturer = CurrentSession.LecturerMatricNo == Identity.MatricNo;
            // Default student view to flipped so incoming remote stream is not inverted
            _isVideoFlipped = !State.IsLecturer;

            // If a student joined an ended session, forward them to the live session for their class
            if (!State.IsLecturer && CurrentSession.ClassId is int classId && CurrentSession.Status == SessionStatus.Ended)
            {
                var liveSessions = await SessionService.GetLiveSessionsForClassAsync(classId);
                var activeSession = liveSessions.FirstOrDefault();
                if (activeSession != null && activeSession.SessionId != SessionId)
                {
                    Console.WriteLine($"[SessionView C#] Student entered ended session {SessionId}; redirecting to active class session {activeSession.SessionId}");
                    _isNavigating = true;
                    Navigation.NavigateTo($"/session/{activeSession.SessionId}", forceLoad: true);
                    return;
                }
                _sessionEndedForStudent = true;
            }
            else if (!State.IsLecturer && CurrentSession.Status == SessionStatus.Ended)
            {
                _sessionEndedForStudent = true;
            }

            if (State.IsLecturer)
            {
                await RefreshParticipantsFromSessionAsync(CurrentSession);
                await LoadJoinUrlAsync();
                await LoadExpectedStudentsAsync();
            }

            Console.WriteLine($"[SessionView C#] Session initialized: IsLecturer={State.IsLecturer}, IsSessionStarted={State.IsSessionStarted}");

            // Show test camera for lecturer before session starts
            if (State.IsLecturer && !State.IsSessionStarted)
            {
                Console.WriteLine($"[SessionView C#] Lecturer view - showing test camera section");
                State.ShowTestCameraSection = true;
            }

            // Setup SignalR Hub Connection
            await SetupHubConnectionAsync();

            // Save initial state to browser storage
            await SaveSessionStateAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SessionView C#] Critical error in OnInitializedAsync: {ex.Message}");
            State.SetError($"Failed to load session: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        Console.WriteLine($"[SessionView C#] OnAfterRenderAsync. firstRender: {firstRender}, IsLecturer: {State.IsLecturer}, SessionStarted: {State.IsSessionStarted}");
        if (firstRender)
        {
            try
            {
                // Check if mobile
                State.IsMobileDevice = await SessionJsInterop.IsMobileAsync();
                Console.WriteLine($"[SessionView C#] Mobile device check: IsMobile={State.IsMobileDevice}");

                // Create DotNetObjectReference for callbacks
                _dotNetRef = DotNetObjectReference.Create(this);
                Console.WriteLine($"[SessionView C#] Created DotNetObjectReference for Javascript callback routing");

                // Initialize JS interop
                Console.WriteLine($"[SessionView C#] Initializing sessionInterop.js...");
                await SessionJsInterop.InitializeAsync(SessionId, State.IsLecturer, _dotNetRef);

                // Setup tab visibility listener for students
                if (!State.IsLecturer)
                {
                    Console.WriteLine($"[SessionView C#] Student view - setting up tab visibility listener");
                    await SessionJsInterop.SetupTabVisibilityListenerAsync();

                    // Start passive device & network telemetry monitoring (pure event-driven, zero polling)
                    if (Identity != null)
                    {
                        try
                        {
                            await JSRuntime.InvokeVoidAsync("sessionInterop.startPassiveTelemetryWatch", _dotNetRef, SessionId, Identity.MatricNo);
                        }
                        catch (Exception ex)
                        {
                            Console.WriteLine($"[SessionView C#] Passive telemetry start error: {ex.Message}");
                        }
                    }
                }

                // Bring up the LiveKit room. Deliberately after the PeerJS
                // initialisation above, and not instead of it: the two report into the
                // same diagnostics panel with distinct prefixes, so the first phone
                // test shows which of them got further.
                await StartLiveKitAsync();

                // Initialize live captions module
                try
                {
                    await JSRuntime.InvokeVoidAsync("captionInterop.init", DotNetObjectReference.Create(this), SessionId, State.IsLecturer);
                }
                catch { }

                // If student and session already started, setup peer
                if (!State.IsLecturer && State.IsSessionStarted)
                {
                    Console.WriteLine($"[SessionView C#] Student view - Session already started. Instantly triggering peer connection");
                    _pendingStudentPeerSetup = false;
                    await SetupStudentPeerConnectionAsync();
                }

                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[SessionView C#] Error in OnAfterRenderAsync: {ex.Message}");
                State.SetError($"Initialization error: {ex.Message}");
            }
        }
        else if (_pendingStudentPeerSetup && !State.IsLecturer)
        {
            Console.WriteLine($"[SessionView C#] Triggering pending student peer setup on subsequent render");
            _pendingStudentPeerSetup = false;
            await SetupStudentPeerConnectionAsync();
        }
    }

    // SignalR Setup
    private async Task SetupHubConnectionAsync()
    {
        Console.WriteLine($"[SessionView C#] SetupHubConnectionAsync starting. Target Hub: {Navigation.ToAbsoluteUri("/sessionHub")}");
        try
        {
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/sessionHub"))
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.Reconnecting += async error =>
            {
                State.IsHubConnected = false;
                await JSRuntime.InvokeVoidAsync("console.log", $"[VIIDII] SignalR reconnecting. session={SessionId}, error={error?.Message ?? "none"}");
            };

            _hubConnection.Reconnected += async connectionId =>
            {
                State.IsHubConnected = true;
                await JSRuntime.InvokeVoidAsync("console.log", $"[VIIDII] SignalR reconnected. ConnectionId={connectionId}, session={SessionId}");
                await _hubConnection.SendAsync("JoinSession", SessionId, Identity?.MatricNo);
                await JSRuntime.InvokeVoidAsync("console.log", $"[VIIDII] JoinSession resent after reconnect. session={SessionId}");
            };

            _hubConnection.Closed += async error =>
            {
                State.IsHubConnected = false;
                await JSRuntime.InvokeVoidAsync("console.log", $"[VIIDII] SignalR closed. session={SessionId}, error={error?.Message ?? "none"}");
            };

            RegisterSignalRHandlers();

            await _hubConnection.StartAsync();
            State.IsHubConnected = true;
            Console.WriteLine($"[SessionView C#] SignalR connected. ConnectionId: {_hubConnection.ConnectionId}");
            await JSRuntime.InvokeVoidAsync("console.log", $"[VIIDII] SignalR connected. ConnectionId={_hubConnection.ConnectionId}, session={SessionId}, lecturer={State.IsLecturer}");

            // Join session. The matric number is passed because this hub connection is
            // built on the server and has no cookie jar of its own, so it cannot
            // prove who it is. The hub checks the claim against the session owner and
            // the class list rather than trusting it.
            Console.WriteLine($"[SessionView C#] Sending JoinSession request to hub. SessionId: {SessionId}");
            await _hubConnection.SendAsync("JoinSession", SessionId, Identity?.MatricNo);
            await JSRuntime.InvokeVoidAsync("console.log", $"[VIIDII] JoinSession sent. session={SessionId}, lecturer={State.IsLecturer}");

            Console.WriteLine($"[SessionView C#] SignalR joined session: {SessionId}");

            if (State.IsLecturer)
            {
                var refreshedSession = await SessionService.GetSessionByIdAsync(SessionId);
                if (refreshedSession != null)
                {
                    await RefreshParticipantsFromSessionAsync(refreshedSession);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SessionView C#] SignalR connection error: {ex.Message}");
            State.SetError("Failed to connect to session. Please refresh the page.");
        }
    }

    private void RegisterSignalRHandlers()
    {
        if (_hubConnection == null) return;

        // Session lifecycle
        _hubConnection.On<string>("SessionStarted", OnSessionStarted);
        _hubConnection.On<string>("SessionEnded", OnSessionEnded);

        // Peer management
        _hubConnection.On<string, string>("ReceivePeerId", OnReceivePeerId);

        // Stream changes
        _hubConnection.On<string>("ReceiveStreamChange", OnStreamChange);

        // Live captions
        _hubConnection.On<System.Text.Json.JsonElement>("ReceiveLiveCaption", async (caption) =>
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("captionInterop.onCaptionReceived", caption);
            }
            catch { }
        });

        // Participant management (lecturer only)
        if (State.IsLecturer)
        {
            _hubConnection.On<Dictionary<string, string>>("ReceiveParticipants", OnReceiveParticipants);
                _hubConnection.On<Dictionary<string, Session.StudentStatus>>("ReceiveParticipantStatuses", OnReceiveParticipantStatuses);
        }

        // Engagement tracking (student only)
        if (!State.IsLecturer)
        {
            _hubConnection.On("AreYouThere", OnAreYouThere);
            _hubConnection.On<string, string, string[], int, string>("ReceiveEngagementQuiz", OnReceiveEngagementQuiz);
            _ = JSRuntime.InvokeVoidAsync("console.log", $"[VIIDII] Engagement handlers registered. session={SessionId}");
        }
    }

    // Lecturer Methods
    private async Task TestCamera()
    {
        if (State.IsTestingCamera) return; // Prevent multiple clicks

        Console.WriteLine("[SessionView C#] [Lecturer] TestCamera invoked");
        try
        {
            State.IsTestingCamera = true;
            State.StartLoading("Starting camera test...");

            // Use test video element
            Console.WriteLine("[SessionView C#] [Lecturer] Invoking browser getUserMedia for test video container...");
            var result = await JSRuntime.InvokeAsync<object>("eval", @"
                (async () => {
                    try {
                        const video = document.getElementById('testVideo');
                        if (!video) return { success: false, error: 'Video element not found' };
                        
                        const stream = await navigator.mediaDevices.getUserMedia({ 
                            video: { width: { ideal: 720 }, height: { ideal: 420 } }, 
                            audio: false 
                        });
                        video.muted = true;
                        video.defaultMuted = true;
                        video.volume = 0;
                        video.srcObject = stream;
                        window.testStream = stream;
                        return { success: true };
                    } catch (err) {
                        return { success: false, error: err.message };
                    }
                })()
            ");

            Console.WriteLine($"[SessionView C#] [Lecturer] browser getUserMedia response: {System.Text.Json.JsonSerializer.Serialize(result)}");
            State.StopLoading();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            State.SetError($"Camera test failed: {ex.Message}");
            State.IsTestingCamera = false;
            Console.WriteLine($"[SessionView C#] [Lecturer] TestCamera error: {ex.Message}");
        }
    }

    private async Task StopTestCamera()
    {
        Console.WriteLine("[SessionView C#] [Lecturer] StopTestCamera invoked");
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                if (window.testStream) {
                    window.testStream.getTracks().forEach(track => track.stop());
                    const video = document.getElementById('testVideo');
                    if (video) video.srcObject = null;
                    delete window.testStream;
                }
            ");
            Console.WriteLine("[SessionView C#] [Lecturer] Stopped local test stream tracks and cleared #testVideo");

            State.IsTestingCamera = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SessionView C#] [Lecturer] Error stopping test camera: {ex.Message}");
            // Don't set error here, just log it
            State.IsTestingCamera = false;
        }
    }

