    // SignalR Event Handlers
    private async Task OnSessionStarted(string sessionId)
    {
        Console.WriteLine($"[SessionView C#] SignalR: OnSessionStarted event received. SessionId: {sessionId}");

        if (!State.IsLecturer && sessionId == SessionId)
        {
            await InvokeAsync(() =>
            {
                Console.WriteLine($"[SessionView C#] [Student] Session started by lecturer. Activating peer connection.");
                State.IsSessionStarted = true;
                State.Status = SessionStatus.Started;

                if (CurrentSession != null)
                {
                    CurrentSession.IsSessionStarted = true;
                    CurrentSession.Status = SessionStatus.Started;
                }

                _pendingStudentPeerSetup = true;
                StateHasChanged();
            });
        }
    }

    private async Task OnSessionEnded(string sessionId)
    {
        if (_isDisposed) return;

        Console.WriteLine($"[SessionView C#] SignalR: OnSessionEnded event received. SessionId: {sessionId}");

        if (sessionId == SessionId)
        {
            if (State.IsLecturer)
            {
                if (!_isNavigating)
                {
                    _isNavigating = true;
                    Console.WriteLine($"[SessionView C#] [Lecturer] Session ended. Redirecting to recap page.");
                    Navigation.NavigateTo($"/session-recap/{sessionId}", forceLoad: true);
                }
            }
            else
            {
                Console.WriteLine($"[SessionView C#] [Student] Session ended. Immediately displaying post-class attendance receipt.");
                _sessionEndedForStudent = true;
                _isNavigating = false;
                State.ClearError();
                State.StopLoading();
                State.IsStreamLoaded = false;
                State.HasStream = false;
                await InvokeAsync(StateHasChanged);

                // Run cleanup safely in background without blocking UI
                try { await ClearSessionStorageAsync(); } catch { }
                try { await SessionJsInterop.CleanupAsync(); } catch { }
                try { await JSRuntime.InvokeVoidAsync("livekitInterop.disconnect"); } catch { }
            }
        }
    }

    private async Task StudentLeaveSession()
    {
        try
        {
            await SessionJsInterop.CleanupAsync();
            try
            {
                await JSRuntime.InvokeVoidAsync("livekitInterop.disconnect");
            }
            catch { }

            _sessionEndedForStudent = true;
            State.ClearError();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SessionView C#] StudentLeaveSession error: {ex.Message}");
            _sessionEndedForStudent = true;
            StateHasChanged();
        }
    }

    private async Task OnReceivePeerId(string userId, string peerId)
    {
        Console.WriteLine($"[SessionView C#] SignalR: OnReceivePeerId. Student: {userId} -> PeerId: {peerId}");

        if (State.IsLecturer)
        {
            await InvokeAsync(() =>
            {
                State.AddStudentPeer(peerId, userId);
                _participantPanelVersion++;
                StateHasChanged();
            });
        }
    }

    private async Task OnStreamChange(string streamType)
    {
        Console.WriteLine($"[SessionView C#] SignalR: OnStreamChange. StreamType: {streamType}");

        await InvokeAsync(() =>
        {
            State.CurrentStreamType = streamType;
            StateHasChanged();
        });

        if (!State.IsLecturer)
        {
            // Notify JS to handle stream change
            Console.WriteLine($"[SessionView C#] [Student] Calling SessionJsInterop.HandleStreamChangeAsync({streamType})...");
            await SessionJsInterop.HandleStreamChangeAsync(streamType);
        }
    }

    private async Task OnReceiveParticipants(Dictionary<string, string> participants)
    {
        Console.WriteLine($"[SessionView C#] SignalR: OnReceiveParticipants. Count: {participants.Count}. Payload: {string.Join(", ", participants.Select(p => $"{p.Key}={p.Value}"))}");

        await InvokeAsync(() =>
        {
            State.Participants.Clear();
            foreach (var participant in participants.OrderBy(p => p.Key))
            {
                State.AddParticipant(participant.Key, participant.Value);
            }

            Console.WriteLine($"[SessionView C#] Updated State.Participants. Count: {State.Participants.Count}. Entries: {string.Join(", ", State.Participants.Select(p => $"{p.Key}={p.Value}"))}");

            _participantPanelVersion++;
            StateHasChanged();
        });
    }

    private async Task OnReceiveParticipantStatuses(Dictionary<string, Session.StudentStatus> statuses)
    {
        Console.WriteLine($"[SessionView C#] SignalR: OnReceiveParticipantStatuses. Count: {statuses.Count}");

        await InvokeAsync(() =>
        {
            State.ParticipantStatuses.Clear();
            foreach (var status in statuses.OrderBy(s => s.Key))
            {
                State.UpdateParticipantStatus(status.Key, status.Value);
            }

            _participantPanelVersion++;
            StateHasChanged();
        });
    }

    private async Task RefreshParticipantsFromSessionAsync(Session session)
    {
        ArgumentNullException.ThrowIfNull(session);

        var participants = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var participantId in session.ParticipantIds.OrderBy(id => id, StringComparer.OrdinalIgnoreCase))
        {
            var user = await UserLookupService.GetUserByMatricNoAsync(participantId);
            participants[participantId] = user?.Name ?? participantId;
        }

        Console.WriteLine($"[SessionView C#] RefreshParticipantsFromSessionAsync. Count: {participants.Count}. Entries: {string.Join(", ", participants.Select(p => $"{p.Key}={p.Value}"))}");

        State.Participants.Clear();
        foreach (var participant in participants)
        {
            State.AddParticipant(participant.Key, participant.Value);
        }

        _participantPanelVersion++;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnReceiveEngagementQuiz(string quizId, string question, string[] options, int timeoutSeconds, string sourceQuote)
    {
        Console.WriteLine($"[SessionView C#] ReceiveEngagementQuiz: {question}, Timeout={timeoutSeconds}");
        if (State.IsLecturer) return;

        await InvokeAsync(() =>
        {
            _currentQuizId = quizId;
            _currentQuizQuestion = question;
            _currentQuizOptions = options;
            _currentQuizTimeout = timeoutSeconds;
            _currentQuizSourceQuote = sourceQuote;
            _showEngagementModal = true;
            StateHasChanged();
        });
    }

    private async Task OnAreYouThere()
    {
        Console.WriteLine($"[SessionView C#] AreYouThere received. SessionId={SessionId}, IsLecturer={State.IsLecturer}, HubConnected={State.IsHubConnected}, ConnectionId={_hubConnection?.ConnectionId}");
        await JSRuntime.InvokeVoidAsync("console.log", $"[VIIDII] AreYouThere received. session={SessionId}, lecturer={State.IsLecturer}, hubConnected={State.IsHubConnected}, connectionId={_hubConnection?.ConnectionId}");

        await InvokeAsync(() =>
        {
            if (!State.IsLecturer)
            {
                _currentQuizId = null;
                _currentQuizQuestion = null;
                _currentQuizOptions = null;
                _currentQuizSourceQuote = null;
                _showEngagementModal = true;
                Console.WriteLine($"[SessionView C#] Setting engagement modal visible for student in session {SessionId}");
            }

            StateHasChanged();
        });
    }

    private async Task HideEngagementModal()
    {
        await InvokeAsync(() =>
        {
            _showEngagementModal = false;
            _currentQuizId = null;
            _currentQuizQuestion = null;
            _currentQuizOptions = null;
            _currentQuizSourceQuote = null;
            StateHasChanged();
        });
    }

    // JSInvokable Callbacks (called from JavaScript)
    /// <summary>
    /// The student's connection stage, reported up from the browser.
    /// <para>
    /// A student on mobile data cannot open a developer console, so before this the
    /// only feedback available was "it didn't work". Knowing whether the call was
    /// ever placed, and how far ICE got, is what separates a signalling fault from a
    /// relay fault. They have different fixes.
    /// </para>
    /// </summary>
    [JSInvokable]
    public async Task OnLecturerPeerReady(string peerId)
    {
        Console.WriteLine($"[SessionView C#] [JSInvokable] OnLecturerPeerReady: PeerId={peerId}. Setting MyPeerId, IsPeerConnected=true, and triggering SessionStarted SignalR event.");
        State.MyPeerId = peerId;
        State.IsPeerConnected = true;

        // Notify SignalR that session started
        if (_hubConnection != null)
        {
            await _hubConnection.SendAsync("SessionStarted", SessionId);
        }

        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnStudentConnected(string peerId)
    {
        Console.WriteLine($"[SessionView C#] [JSInvokable] OnStudentConnected: Student PeerId={peerId}. Registering/updating student connection in state.");
        State.AddStudentPeer(peerId);
        if (State.IsLecturer)
        {
            var participantId = State.ConnectedStudents
                .FirstOrDefault(p => string.Equals(p.Key, peerId, StringComparison.OrdinalIgnoreCase)).Value;

            if (string.IsNullOrWhiteSpace(participantId))
            {
                participantId = State.StudentPeerIds.FirstOrDefault(id => string.Equals(id, peerId, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(participantId))
            {
                var user = await UserLookupService.GetUserByMatricNoAsync(participantId);
                State.AddParticipant(participantId, user?.Name ?? participantId);
            }

            _participantPanelVersion++;
        }
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnStudentDisconnected(string peerId)
    {
        Console.WriteLine($"[SessionView C#] [JSInvokable] OnStudentDisconnected: Student PeerId={peerId}. Removing student connection from state.");
        State.RemoveStudentPeer(peerId);
        if (State.IsLecturer)
        {
            _participantPanelVersion++;
        }
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnStreamTypeChanged(string streamType)
    {
        Console.WriteLine($"[SessionView C#] [JSInvokable] OnStreamTypeChanged: StreamType={streamType}. Updating local state and broadcasting stream change to students via SignalR.");
        State.CurrentStreamType = streamType;

        // Notify students via SignalR
        if (_hubConnection != null && State.IsLecturer)
        {
            await _hubConnection.SendAsync("NotifyStreamChange", SessionId, streamType);
        }

        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnStudentPeerReady(string peerId)
    {
        Console.WriteLine($"[SessionView C#] [JSInvokable] OnStudentPeerReady: Student PeerId={peerId}. Sending peer ID to SignalR Hub.");
        State.MyPeerId = peerId;

        // Send peer ID to SignalR so lecturer can connect
        if (_hubConnection != null && State.CurrentUser != null)
        {
            await _hubConnection.SendAsync("SendPeerId", SessionId, State.CurrentUser.MatricNo, peerId);
        }

        StateHasChanged();
    }

    [JSInvokable]
    public Task OnConnectedToLecturer(string lecturerPeerId)
    {
        Console.WriteLine($"[SessionView C#] [JSInvokable] OnConnectedToLecturer: Connected to lecturer peer {lecturerPeerId}. Marking peer connection active.");
        State.IsPeerConnected = true;
        State.StopLoading();
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public void OnStreamReceived()
    {
        Console.WriteLine($"[SessionView C#] [JSInvokable] OnStreamReceived: Media stream received from lecturer. Setting IsStreamLoaded=true, IsPeerConnected=true, stopping loading state.");
        State.IsSessionStarted = true;
        if (CurrentSession != null)
        {
            CurrentSession.IsSessionStarted = true;
            CurrentSession.Status = SessionStatus.Started;
        }
        State.IsStreamLoaded = true;
        State.IsPeerConnected = true;
        State.HasStream = true;
        State.MediaStage = "stream received";
        State.ShowMobilePlayOverlay = State.IsMobileDevice;
        State.StopLoading();
        StateHasChanged();
    }

    [JSInvokable]
    public void OnVideoPlaying()
    {
        Console.WriteLine("[SessionView C#] [JSInvokable] OnVideoPlaying: video element is actively playing frames.");
        State.IsSessionStarted = true;
        if (CurrentSession != null)
        {
            CurrentSession.IsSessionStarted = true;
            CurrentSession.Status = SessionStatus.Started;
        }
        State.IsStreamLoaded = true;
        State.HasStream = true;
        State.ShowMobilePlayOverlay = false;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnStreamLost()
    {
        Console.WriteLine("[SessionView C#] [JSInvokable] OnStreamLost: Media stream lost/disconnected.");
        State.IsStreamLoaded = false;
        State.HasStream = false;

        // If the session was ended by the lecturer, transition student to completion receipt immediately
        if (!State.IsLecturer)
        {
            try
            {
                var s = await SessionService.GetSessionByIdAsync(SessionId);
                if (s == null || s.Status == SessionStatus.Ended || !s.IsSessionStarted)
                {
                    Console.WriteLine("[SessionView C#] OnStreamLost: Detected session is ended. Showing attendance receipt.");
                    _sessionEndedForStudent = true;
                    State.ClearError();
                    State.StopLoading();
                    await InvokeAsync(StateHasChanged);
                    return;
                }
            }
            catch { }
        }

        // LiveKit auto-renegotiates when tracks toggle; do not flash an alarmist error banner
        StateHasChanged();
    }

    [JSInvokable]
    public void OnPeerError(string errorType)
    {
        Console.WriteLine($"[SessionView C#] [JSInvokable] OnPeerError: Error occurred: '{errorType}'. Connection attempt #{State.ConnectionAttempts}. Processing retry logic.");
        if (_sessionEndedForStudent || _isDisposed || CurrentSession?.Status == SessionStatus.Ended)
        {
            return;
        }

        State.RecordConnectionAttempt();

        if (State.HasExceededMaxAttempts)
        {
            State.SetError("Unable to establish connection. Please refresh the page.");
        }
    }

    [JSInvokable]
    public async Task OnTabVisibilityChanged(bool isVisible)
    {
        Console.WriteLine($"[SessionView C#] [JSInvokable] OnTabVisibilityChanged: isVisible={isVisible}. Updating participant activity state.");

        if (_hubConnection is null || State.IsLecturer || !State.IsSessionStarted)
        {
            return;
        }

        await _hubConnection.SendAsync("UpdateTabStatus", isVisible);
    }

    private async Task TryRestoreSessionStateAsync()
    {
        var restored = await SessionJsInterop.RestoreSessionStateAsync();
        if (restored is not System.Text.Json.JsonElement json || json.ValueKind != System.Text.Json.JsonValueKind.Object)
        {
            return;
        }

        if (json.TryGetProperty("isTestingCamera", out var isTestingCamera) && isTestingCamera.ValueKind == System.Text.Json.JsonValueKind.True || isTestingCamera.ValueKind == System.Text.Json.JsonValueKind.False)
        {
            State.IsTestingCamera = isTestingCamera.GetBoolean();
        }

        if (json.TryGetProperty("showTestCameraSection", out var showTestCameraSection) && (showTestCameraSection.ValueKind == System.Text.Json.JsonValueKind.True || showTestCameraSection.ValueKind == System.Text.Json.JsonValueKind.False))
        {
            State.ShowTestCameraSection = showTestCameraSection.GetBoolean();
        }
    }

    private Task SaveSessionStateAsync()
    {
        var state = new
        {
            sessionId = SessionId,
            isSessionStarted = State.IsSessionStarted,
            isLecturer = State.IsLecturer,
            isTestingCamera = State.IsTestingCamera,
            showTestCameraSection = State.ShowTestCameraSection
        };

        return SessionJsInterop.SaveSessionStateAsync(state);
    }

    private Task ClearSessionStorageAsync() => SessionJsInterop.ClearSessionStateAsync();

    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;

        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("sessionInterop.stopPassiveTelemetryWatch");
        }
        catch { }

        try
        {
            await JSRuntime.InvokeVoidAsync("livekitInterop.disconnect");
        }
        catch { }
    }

    [JSInvokable]
    public async Task OnPassiveTelemetryAlert(string issueType, int metricValue)
    {
        Console.WriteLine($"[SessionView C#] Passive Telemetry Alert: {issueType} metric: {metricValue}");
        if (_hubConnection != null && _hubConnection.State == HubConnectionState.Connected)
        {
            if (issueType == "BatteryLow")
            {
                await _hubConnection.SendAsync("RecordDeviceTelemetry", metricValue, false, null, null);
                await _hubConnection.SendAsync("FlagIssue", "BatteryLow");
            }
            else if (issueType == "DataFinished")
            {
                await _hubConnection.SendAsync("RecordDeviceTelemetry", null, null, metricValue, "slow");
                await _hubConnection.SendAsync("FlagIssue", "DataFinished");
            }
        }
    }
}

