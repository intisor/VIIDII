    private async Task SetupStudentPeerConnectionAsync()
    {
        if (State.IsLecturer) return;

        Console.WriteLine($"[SessionView C#] [Student] SetupStudentPeerConnectionAsync. SessionId: {SessionId}");
        try
        {
            State.StartLoading("Setting up connection...");

            Console.WriteLine($"[SessionView C#] [Student] Calling SessionJsInterop.SetupStudentPeerAsync...");
            var result = await SessionJsInterop.SetupStudentPeerAsync();
            
            // Result will have { success: true, peerId: "..." }
            Console.WriteLine($"[SessionView C#] [Student] Peer setup response: {System.Text.Json.JsonSerializer.Serialize(result)}");

            State.StopLoading();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SessionView C#] [Student] Error setting up student peer: {ex.Message}");
            State.RecordConnectionAttempt();

            if (State.ShouldRetryConnection() && !State.HasExceededMaxAttempts)
            {
                var delay = (int)(Math.Pow(2, State.ConnectionAttempts - 1) * 1000);
                Console.WriteLine($"[SessionView C#] [Student] Retrying connection attempt {State.ConnectionAttempts} in {delay}ms...");
                await Task.Delay(delay);
                await SetupStudentPeerConnectionAsync();
            }
            else if (State.HasExceededMaxAttempts)
            {
                Console.WriteLine($"[SessionView C#] [Student] Max connection attempts exceeded ({State.ConnectionAttempts})");
                State.SetError("Unable to connect to session. Please refresh the page.");
            }
        }
    }

