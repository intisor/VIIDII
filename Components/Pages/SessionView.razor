    private async Task StartLiveKitAsync()
    {
        if (_liveKitStarted)
        {
            return;
        }
        _liveKitStarted = true;

        try
        {
            // SessionId is passed in explicitly. The JS module holds no route state of
            // its own, so omitting it here produced "not configured" while PeerJS,
            // which receives the same id separately, carried on working.
            var result = await JSRuntime.InvokeAsync<object>(
                "livekitInterop.connect", SessionId, State.IsLecturer, DotNetObjectReference.Create(this));

            Console.WriteLine($"[SessionView C#] LiveKit connect returned: {result}");

            if (!State.IsLecturer)
            {
                var idToWatermark = State.CurrentUser?.MatricNo ?? "VIIDII-SECURE";
                await JSRuntime.InvokeVoidAsync("livekitInterop.enableWatermark", idToWatermark);
            }
        }
        catch (Exception ex)
        {
            _liveKitStarted = false;
            Console.WriteLine($"[SessionView C#] LiveKit connect threw: {ex.Message}");
        }
    }

