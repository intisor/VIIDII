@page "/session/{SessionId}"
@layout SessionLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable
@inject AuthService AuthService
@inject SessionService SessionService
@inject ISessionJsInterop SessionJsInterop
@inject UserService UserLookupService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@using VIIDII.Models
@using VIIDII.Services
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.JSInterop

<PageTitle>Session - @SessionId</PageTitle>

@if (_isNavigating)
{
    <div class="loading-screen">
        <div class="spinner"></div>
        <p>Loading session...</p>
    </div>
}
else if (State.CurrentUser == null)
{
    <div class="alert alert-warning">Please log in first.</div>
}
else if (CurrentSession == null)
{
    <div class="alert alert-danger">Session not found or you don't have access.</div>
}
else
{
    <div class="session-container">
        <!-- Compact Top Bar -->
        <div class="session-header">
            <div class="session-header-left">
                <h1>@CurrentSession.Title</h1>
                @if (State.IsSessionStarted)
                {
                    <span class="live-badge"><span class="live-dot"></span>LIVE</span>
                }
                else
                {
                    <span class="status-badge">@State.Status</span>
                }
            </div>
            <div class="session-header-right">
                <span class="session-code">@SessionId</span>
                @if (State.IsLecturer && State.ParticipantCount > 0)
                {
                    <span class="participant-badge">
                        <i class="fas fa-users"></i>
                        @State.ParticipantCount
                    </span>
                }
            </div>
        </div>

        <!-- Error Banner -->
        @if (!string.IsNullOrEmpty(State.ErrorMessage))
        {
            <div class="error-banner">
                <i class="fas fa-exclamation-triangle"></i>
                <span>@State.ErrorMessage</span>
                @if (!State.HasExceededMaxAttempts && !State.IsLecturer)
                {
                    <button class="btn-retry" @onclick="RetryConnection">Retry</button>
                }
                else if (State.HasExceededMaxAttempts)
                {
                    <button class="btn-retry" @onclick="RefreshPage">Refresh Page</button>
                }
            </div>
        }

        <!-- Setup configuration section (Lecturer Only, Before Session Starts) -->
        @if (State.IsLecturer && !State.IsSessionStarted && State.ShowTestCameraSection)
        {
            <div class="setup-layout">
                <div class="setup-card">
                    <div class="setup-header">
                        <h3>Device Preview</h3>
                        <p>Configure and verify your camera output before launching the live classroom session.</p>
                    </div>

                    <div class="test-video-container">
                        <video id="testVideo" autoplay playsinline muted class="test-video"></video>
                        @if (!State.IsTestingCamera)
                        {
                            <div class="camera-off-placeholder">
                                <i class="fas fa-video-slash"></i>
                                <span>Webcam is currently offline</span>
                            </div>
                        }
                    </div>

                    <div class="test-controls">
                        @if (!State.IsTestingCamera)
                        {
                            <button class="btn btn-primary btn-lg" @onclick="TestCamera" id="test-camera-btn">
                                <i class="fas fa-video"></i> Start Camera Test
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-secondary" @onclick="StopTestCamera" id="stop-test-btn">
                                <i class="fas fa-stop"></i> Stop Test
                            </button>
                            <button class="btn btn-success" @onclick="StartSessionWithCamera" id="start-session-btn">
                                <i class="fas fa-play"></i> Start Session
                            </button>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Session Body: sidebar layout -->
        @if (State.IsSessionStarted || State.IsTestingCamera || !State.IsLecturer)
        {
            <div class="session-body">
                <div class="video-panel">
                <div class="video-container" id="videoContainer">
                    <!-- Main Video Element -->
                    <video id="sessionVideo" 
                           autoplay 
                           playsinline 
                           muted="@State.IsLecturer"
                           class="session-video @(State.IsLecturer ? "local-stream" : "")">
                    </video>

                    <!-- Loading Overlay -->
                    @if (State.IsLoading || State.IsInitializing)
                    {
                        <div class="loading-overlay">
                            <div class="spinner"></div>
                            <p>@(State.IsLecturer ? "Initializing camera..." : "Connecting to session...")</p>
                        </div>
                    }

                    <!-- Pre-session: Waiting for Lecturer (Student Only) -->
                    @if (!State.IsLecturer && !State.IsSessionStarted && !State.IsLoading)
                    {
                        <div class="waiting-overlay">
                            <div class="spinner"></div>
                            <p>Waiting for lecturer to start the session...</p>
                        </div>
                    }

                    <!-- Mobile Play Overlay -->
                    @if (State.ShowMobilePlayOverlay && !State.IsLecturer && State.IsSessionStarted)
                    {
                        <div class="mobile-play-overlay" @onclick="PlayVideo">
                            <div class="play-button">
                                <i class="fas fa-play"></i>
                                <p>Tap to start video</p>
                            </div>
                        </div>
                    }

                    <!-- Waiting for Lecturer (Student View) -->
                    @if (!State.IsLecturer && !State.IsPeerConnected && State.IsSessionStarted)
                    {
                        <div class="waiting-overlay">
                            <div class="spinner"></div>
                            <p>Waiting for lecturer to start streaming...</p>
                        </div>
                    }

                    <!-- Stream Type Indicator -->
                    @if (State.IsLecturer && State.IsWebcamActive)
                    {
                        <div class="stream-indicator">
                            <i class="fas fa-@(State.IsScreenSharing ? "desktop" : "video")"></i>
                            <span>@(State.IsScreenSharing ? "Screen Sharing" : "Camera")</span>
                        </div>
                    }
                </div>

                <!-- Video Controls (Below Video) -->
                <div class="video-controls-container">
                    @if (State.IsLecturer && State.IsWebcamActive)
                    {
                        <div class="video-controls">
                            <button class="btn-control" @onclick="ToggleScreenShare" disabled="@State.IsLoading">
                                <i class="fas fa-@(State.IsScreenSharing ? "video" : "desktop")"></i>
                                <span class="control-label">@(State.IsScreenSharing ? "Camera" : "Share Screen")</span>
                            </button>
                            
                            <button class="btn-control btn-danger" @onclick="EndSession">
                                <i class="fas fa-stop"></i>
                                <span class="control-label">End Session</span>
                            </button>
                        </div>
                    }
                </div>
                </div> <!-- /video-panel -->

                <!-- Side Panel: chat + participants + issue buttons -->
                @if (State.IsSessionStarted)
                {
                    <div class="side-panel">
                        <div class="tab-section">
                            <!-- Tab Headers -->
                            <div class="tab-headers">
                                <button class="tab-header @(State.ActiveTab == "messages" ? "active" : "")" 
                                        @onclick='() => State.SetTab("messages")'>
                                    <i class="fas fa-comments"></i>
                                    <span>Messages</span>
                                </button>
                                <button class="tab-header @(State.ActiveTab == "participants" ? "active" : "")" 
                                        @onclick='() => State.SetTab("participants")'>
                                    <i class="fas fa-users"></i>
                                    <span>Participants (@State.ParticipantCount)</span>
                                </button>
                            </div>

                            <!-- Tab Content -->
                            <div class="tab-content">
                                @if (State.ActiveTab == "messages")
                                {
                                    <MessagingPanel SessionId="@SessionId"
                                                   IsLecturer="@State.IsLecturer"
                                                   HubConnection="@_hubConnection"
                                                   CurrentUserId="@(State.CurrentUser?.MatricNo ?? "")" />
                                }
                                else
                                {
                                    <ParticipantPanel @key="@_participantPanelVersion"
                                                      Participants="@EffectiveParticipants"
                                                      ParticipantStatuses="@State.ParticipantStatuses"
                                                      HubConnection="@_hubConnection"
                                                      SessionId="@SessionId"
                                                      IsLecturer="@State.IsLecturer" />
                                }
                            </div>
                        </div>

                        <!-- Issue flags (student only, inside side panel) -->
                        @if (!State.IsLecturer)
                        {
                            <IssueButtons HubConnection="@_hubConnection" />
                        }
                    </div>
                }
            </div> <!-- /session-body -->
        }
    </div>

    <!-- Engagement Modal (Student Only) -->
    @if (!State.IsLecturer)
    {
        <EngagementModal HubConnection="@_hubConnection"
                         IsStudent="true"
                         ShouldShow="@_showEngagementModal"
                         OnHidden="@HideEngagementModal" />
    }
}

@code {
    [Parameter]
    public string SessionId { get; set; } = string.Empty;

    // State
    private SessionState State = new();
    private VIIDII.Models.Session? CurrentSession;
    private HubConnection? _hubConnection;
    private DotNetObjectReference<SessionView>? _dotNetRef;
    private bool _showEngagementModal = false;
    private bool _isDisposed = false;
    private bool _isNavigating = false; // Prevent render after navigation
    private bool IsLecturer => State.IsLecturer;
    private bool _pendingStudentPeerSetup = false;
    private int _participantPanelVersion = 0;
    private Dictionary<string, string> EffectiveParticipants
    {
        get
        {
            if (State.Participants.Count > 0)
            {
                return State.Participants;
            }

            var participants = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            foreach (var connectedStudent in State.ConnectedStudents)
            {
                if (!string.IsNullOrWhiteSpace(connectedStudent.Key) && !string.IsNullOrWhiteSpace(connectedStudent.Value))
                {
                    participants[connectedStudent.Key] = connectedStudent.Value;
                }
            }

            return participants;
        }
    }

    // Lifecycle Methods
    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine($"[SessionView C#] OnInitializedAsync started. SessionId: {SessionId}");
        try
        {
            // Load user FIRST
            State.CurrentUser = await AuthService.GetCurrentUserAsync();
            if (State.CurrentUser == null)
            {
                Console.WriteLine($"[SessionView C#] OnInitializedAsync: User not logged in, redirecting to /login");
                _isNavigating = true;
                Navigation.NavigateTo("/login", forceLoad: true);
                return;
            }
            Console.WriteLine($"[SessionView C#] Current User loaded: MatricNo={State.CurrentUser.MatricNo}, Name={State.CurrentUser.Name}");

            // Load session
            CurrentSession = await SessionService.GetSessionByIdAsync(SessionId);
            if (CurrentSession == null)
            {
                Console.WriteLine($"[SessionView C#] OnInitializedAsync: Session {SessionId} not found in SessionService, redirecting to /dashboard");
                _isNavigating = true;
                Navigation.NavigateTo("/dashboard", forceLoad: true);
                return;
            }
            Console.WriteLine($"[SessionView C#] Loaded Session from SessionService: Title='{CurrentSession.Title}', Status={CurrentSession.Status}, Lecturer={CurrentSession.LecturerMatricNo}");

            // NOW try to restore state (after user is loaded)
            await TryRestoreSessionStateAsync();

            // Initialize state
            State.SessionId = SessionId;
            State.SessionTitle = CurrentSession.Title;
            State.Status = CurrentSession.Status;
            State.IsSessionStarted = CurrentSession.IsSessionStarted;
            State.IsLecturer = CurrentSession.LecturerMatricNo == State.CurrentUser.MatricNo;

            if (State.IsLecturer)
            {
                await RefreshParticipantsFromSessionAsync(CurrentSession);
            }

            Console.WriteLine($"[SessionView C#] Session initialized: IsLecturer={State.IsLecturer}, IsSessionStarted={State.IsSessionStarted}");

            // Show test camera for lecturer before session starts
            if (State.IsLecturer && !State.IsSessionStarted)
            {
                Console.WriteLine($"[SessionView C#] Lecturer view - showing test camera section");
                State.ShowTestCameraSection = true;
            }

            // Setup SignalR Hub Connection
            await SetupHubConnectionAsync();

            // Save initial state to browser storage
            await SaveSessionStateAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SessionView C#] Critical error in OnInitializedAsync: {ex.Message}");
            State.SetError($"Failed to load session: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        Console.WriteLine($"[SessionView C#] OnAfterRenderAsync. firstRender: {firstRender}, IsLecturer: {State.IsLecturer}, SessionStarted: {State.IsSessionStarted}");
        if (firstRender)
        {
            try
            {
                // Check if mobile
                State.IsMobileDevice = await SessionJsInterop.IsMobileAsync();
                Console.WriteLine($"[SessionView C#] Mobile device check: IsMobile={State.IsMobileDevice}");

                // Create DotNetObjectReference for callbacks
                _dotNetRef = DotNetObjectReference.Create(this);
                Console.WriteLine($"[SessionView C#] Created DotNetObjectReference for Javascript callback routing");

                // Initialize JS interop
                Console.WriteLine($"[SessionView C#] Initializing sessionInterop.js...");
                await SessionJsInterop.InitializeAsync(SessionId, State.IsLecturer, _dotNetRef);

                // Setup tab visibility listener for students
                if (!State.IsLecturer)
                {
                    Console.WriteLine($"[SessionView C#] Student view - setting up tab visibility listener");
                    await SessionJsInterop.SetupTabVisibilityListenerAsync();
                }

                // If student and session already started, setup peer
                if (!State.IsLecturer && State.IsSessionStarted)
                {
                    Console.WriteLine($"[SessionView C#] Student view - Session already started. Instantly triggering peer connection");
                    _pendingStudentPeerSetup = false;
                    await SetupStudentPeerConnectionAsync();
                }

                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[SessionView C#] Error in OnAfterRenderAsync: {ex.Message}");
                State.SetError($"Initialization error: {ex.Message}");
            }
        }
        else if (_pendingStudentPeerSetup && !State.IsLecturer)
        {
            Console.WriteLine($"[SessionView C#] Triggering pending student peer setup on subsequent render");
            _pendingStudentPeerSetup = false;
            await SetupStudentPeerConnectionAsync();
        }
    }

    // SignalR Setup
    private async Task SetupHubConnectionAsync()
    {
        Console.WriteLine($"[SessionView C#] SetupHubConnectionAsync starting. Target Hub: {Navigation.ToAbsoluteUri("/sessionHub")}");
        try
        {
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/sessionHub"))
                .WithAutomaticReconnect()
                .Build();

            RegisterSignalRHandlers();

            await _hubConnection.StartAsync();
            State.IsHubConnected = true;
            Console.WriteLine($"[SessionView C#] SignalR connected. ConnectionId: {_hubConnection.ConnectionId}");

            // Join session
            Console.WriteLine($"[SessionView C#] Sending JoinSession request to hub. SessionId: {SessionId}");
            await _hubConnection.SendAsync("JoinSession", SessionId);

            Console.WriteLine($"[SessionView C#] SignalR joined session: {SessionId}");

            if (State.IsLecturer)
            {
                var refreshedSession = await SessionService.GetSessionByIdAsync(SessionId);
                if (refreshedSession != null)
                {
                    await RefreshParticipantsFromSessionAsync(refreshedSession);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SessionView C#] SignalR connection error: {ex.Message}");
            State.SetError("Failed to connect to session. Please refresh the page.");
        }
    }

    private void RegisterSignalRHandlers()
    {
        if (_hubConnection == null) return;

        // Session lifecycle
        _hubConnection.On<string>("SessionStarted", OnSessionStarted);
        _hubConnection.On<string>("SessionEnded", OnSessionEnded);

        // Peer management
        _hubConnection.On<string, string>("ReceivePeerId", OnReceivePeerId);

        // Stream changes
        _hubConnection.On<string>("ReceiveStreamChange", OnStreamChange);

        // Participant management (lecturer only)
        if (State.IsLecturer)
        {
            _hubConnection.On<Dictionary<string, string>>("ReceiveParticipants", OnReceiveParticipants);
                _hubConnection.On<Dictionary<string, Session.StudentStatus>>("ReceiveParticipantStatuses", OnReceiveParticipantStatuses);
        }

        // Engagement tracking (student only)
        if (!State.IsLecturer)
        {
            _hubConnection.On("AreYouThere", OnAreYouThere);
        }
    }

    // Lecturer Methods
    private async Task TestCamera()
    {
        if (State.IsTestingCamera) return; // Prevent multiple clicks

        Console.WriteLine("[SessionView C#] [Lecturer] TestCamera invoked");
        try
        {
            State.IsTestingCamera = true;
            State.StartLoading("Starting camera test...");

            // Use test video element
            Console.WriteLine("[SessionView C#] [Lecturer] Invoking browser getUserMedia for test video container...");
            var result = await JSRuntime.InvokeAsync<object>("eval", @"
                (async () => {
                    try {
                        const video = document.getElementById('testVideo');
                        if (!video) return { success: false, error: 'Video element not found' };
                        
                        const stream = await navigator.mediaDevices.getUserMedia({ 
                            video: { width: { ideal: 720 }, height: { ideal: 420 } }, 
                            audio: true 
                        });
                        video.srcObject = stream;
                        window.testStream = stream;
                        return { success: true };
                    } catch (err) {
                        return { success: false, error: err.message };
                    }
                })()
            ");

            Console.WriteLine($"[SessionView C#] [Lecturer] browser getUserMedia response: {System.Text.Json.JsonSerializer.Serialize(result)}");
            State.StopLoading();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            State.SetError($"Camera test failed: {ex.Message}");
            State.IsTestingCamera = false;
            Console.WriteLine($"[SessionView C#] [Lecturer] TestCamera error: {ex.Message}");
        }
    }

    private async Task StopTestCamera()
    {
        Console.WriteLine("[SessionView C#] [Lecturer] StopTestCamera invoked");
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                if (window.testStream) {
                    window.testStream.getTracks().forEach(track => track.stop());
                    const video = document.getElementById('testVideo');
                    if (video) video.srcObject = null;
                    delete window.testStream;
                }
            ");
            Console.WriteLine("[SessionView C#] [Lecturer] Stopped local test stream tracks and cleared #testVideo");

            State.IsTestingCamera = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SessionView C#] [Lecturer] Error stopping test camera: {ex.Message}");
            // Don't set error here, just log it
            State.IsTestingCamera = false;
        }
    }

    private async Task StartSessionWithCamera()
    {
        Console.WriteLine("[SessionView C#] [Lecturer] StartSessionWithCamera called (stopping camera test and starting session)");
        await StopTestCamera();
        await StartSession();
    }

    private async Task StartSession()
    {
        if (CurrentSession == null || !State.IsLecturer || State.IsLoading || State.IsWebcamActive)
        {
            Console.WriteLine($"[SessionView C#] [Lecturer] StartSession ignored: Session is null, not lecturer, already loading, or webcam already active");
            return;
        }

        Console.WriteLine($"[SessionView C#] [Lecturer] Starting Session. SessionId: {SessionId}");
        try
        {
            State.StartLoading("Starting session...");

            // Update session in service
            Console.WriteLine($"[SessionView C#] [Lecturer] Calling SessionService.StartSessionAsync...");
            var updatedSession = await SessionService.StartSessionAsync(SessionId);
            
            if (updatedSession != null)
            {
                CurrentSession = updatedSession;
                CurrentSession.IsSessionStarted = true;
                State.IsSessionStarted = true;
                State.Status = CurrentSession.Status;
                State.ShowTestCameraSection = false;
                Console.WriteLine($"[SessionView C#] [Lecturer] Session status updated to: {CurrentSession.Status}");
            }

            StateHasChanged();
            await Task.Yield();

            // Start webcam via JS interop
            Console.WriteLine($"[SessionView C#] [Lecturer] Calling SessionJsInterop.StartWebcamAsync...");
            var result = await SessionJsInterop.StartWebcamAsync(SessionId);

            // Parse result safely
            if (result != null)
            {
                var resultJson = System.Text.Json.JsonSerializer.Serialize(result);
                var resultDict = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, System.Text.Json.JsonElement>>(resultJson);

                if (resultDict != null && resultDict.ContainsKey("success"))
                {
                    var success = resultDict["success"].GetBoolean();
                    if (success)
                    {
                        State.IsWebcamActive = true;
                        State.StopLoading();
                        State.ClearError();
                        Console.WriteLine("[SessionView C#] [Lecturer] Webcam started successfully on client side");
                    }
                    else
                    {
                        var error = resultDict.ContainsKey("error") 
                            ? resultDict["error"].GetString() 
                            : "Unknown error";
                        State.SetError($"Camera failed: {error}. Please check permissions and try again.");
                        Console.WriteLine($"[SessionView C#] [Lecturer] Webcam start failed: {error}");
                    }
                }
            }
            else
            {
                Console.WriteLine("[SessionView C#] [Lecturer] Webcam start returned null result");
                State.SetError("Failed to start camera. Please refresh and try again.");
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SessionView C#] [Lecturer] Error starting session: {ex.Message}");
            State.SetError($"Failed to start session: {ex.Message}");
        }
    }

    private async Task ToggleScreenShare()
    {
        if (!State.IsLecturer || !State.IsWebcamActive || State.IsLoading)
        {
            Console.WriteLine("[SessionView C#] [Lecturer] ToggleScreenShare ignored: conditions not met");
            return;
        }

        Console.WriteLine($"[SessionView C#] [Lecturer] ToggleScreenShare. Current state: IsScreenSharing={State.IsScreenSharing}");
        try
        {
            State.IsLoading = true;
            StateHasChanged();

            if (State.IsScreenSharing)
            {
                // Switch back to webcam - JS will handle this automatically when screen share stops
                State.IsScreenSharing = false;
                Console.WriteLine("[SessionView C#] [Lecturer] Disabling ScreenShare flag (reverting to webcam)");
            }
            else
            {
                // Start screen share
                Console.WriteLine("[SessionView C#] [Lecturer] Calling SessionJsInterop.StartScreenShareAsync...");
                var result = await SessionJsInterop.StartScreenShareAsync();
                
                if (result != null)
                {
                    var resultJson = System.Text.Json.JsonSerializer.Serialize(result);
                    var resultDict = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, System.Text.Json.JsonElement>>(resultJson);

                    if (resultDict != null && resultDict.ContainsKey("success"))
                    {
                        var success = resultDict["success"].GetBoolean();
                        if (success)
                        {
                            State.IsScreenSharing = true;
                            Console.WriteLine("[SessionView C#] [Lecturer] Screen share started successfully on client side");
                        }
                        else
                        {
                            var error = resultDict.ContainsKey("error") 
                                ? resultDict["error"].GetString() 
                                : "Unknown error";
                            State.SetError($"Screen share failed: {error}");
                            Console.WriteLine($"[SessionView C#] [Lecturer] Screen share failed: {error}");
                        }
                    }
                }
            }

            State.IsLoading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SessionView C#] [Lecturer] Error toggling screen share: {ex.Message}");
            State.SetError($"Screen share error: {ex.Message}");
            State.IsLoading = false;
        }
    }

    private async Task EndSession()
    {
        if (CurrentSession == null || !State.IsLecturer || State.CurrentUser == null || State.IsLoading)
            return;

        Console.WriteLine($"[SessionView C#] [Lecturer] EndSession invoked. SessionId: {SessionId}");
        try
        {
            State.StartLoading("Ending session...");

            // End session in service
            Console.WriteLine($"[SessionView C#] [Lecturer] Calling SessionService.EndSession...");
            SessionService.EndSession(SessionId, State.CurrentUser.MatricNo);

            // Notify via SignalR
            if (_hubConnection != null && _hubConnection.State == HubConnectionState.Connected)
            {
                Console.WriteLine($"[SessionView C#] [Lecturer] Sending EndSession to hub for SessionId: {SessionId}");
                await _hubConnection.SendAsync("EndSession", SessionId);
            }

            // Clear session storage
            await ClearSessionStorageAsync();

            // Cleanup JS resources
            Console.WriteLine($"[SessionView C#] [Lecturer] Cleaning up JS media/peer resources...");
            await SessionJsInterop.CleanupAsync();

            State.StopLoading();

            // Navigate after cleanup
            Console.WriteLine($"[SessionView C#] [Lecturer] Session ended successfully. Navigating to recap page.");
            _isNavigating = true;
            Navigation.NavigateTo($"/session-recap/{SessionId}", forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SessionView C#] [Lecturer] Error ending session: {ex.Message}");
            State.SetError($"Error ending session: {ex.Message}");
        }
    }

    // Student Methods
    private async Task SetupStudentPeerConnectionAsync()
    {
        if (State.IsLecturer) return;

        Console.WriteLine($"[SessionView C#] [Student] SetupStudentPeerConnectionAsync. SessionId: {SessionId}");
        try
        {
            State.StartLoading("Setting up connection...");

            Console.WriteLine($"[SessionView C#] [Student] Calling SessionJsInterop.SetupStudentPeerAsync...");
            var result = await SessionJsInterop.SetupStudentPeerAsync();
            
            // Result will have { success: true, peerId: "..." }
            Console.WriteLine($"[SessionView C#] [Student] Peer setup response: {System.Text.Json.JsonSerializer.Serialize(result)}");

            State.StopLoading();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SessionView C#] [Student] Error setting up student peer: {ex.Message}");
            State.RecordConnectionAttempt();

            if (State.ShouldRetryConnection() && !State.HasExceededMaxAttempts)
            {
                var delay = (int)(Math.Pow(2, State.ConnectionAttempts - 1) * 1000);
                Console.WriteLine($"[SessionView C#] [Student] Retrying connection attempt {State.ConnectionAttempts} in {delay}ms...");
                await Task.Delay(delay);
                await SetupStudentPeerConnectionAsync();
            }
            else if (State.HasExceededMaxAttempts)
            {
                Console.WriteLine($"[SessionView C#] [Student] Max connection attempts exceeded ({State.ConnectionAttempts})");
                State.SetError("Unable to connect to session. Please refresh the page.");
            }
        }
    }

    private async Task PlayVideo()
    {
        Console.WriteLine("[SessionView C#] [Student] PlayVideo invoked (user clicked mobile overlay to play remote stream)");
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                const video = document.getElementById('sessionVideo');
                if (video) video.play();
            ");

            State.ShowMobilePlayOverlay = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SessionView C#] [Student] Error playing video: {ex.Message}");
        }
    }

    private async Task RetryConnection()
    {
        Console.WriteLine("[SessionView C#] [Student] RetryConnection clicked");
        State.ClearError();
        State.ConnectionAttempts = 0;
        await SetupStudentPeerConnectionAsync();
    }

    private void RefreshPage()
    {
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    // SignalR Event Handlers
    private async Task OnSessionStarted(string sessionId)
    {
        Console.WriteLine($"[SessionView C#] SignalR: OnSessionStarted event received. SessionId: {sessionId}");

        if (!State.IsLecturer && sessionId == SessionId)
        {
            await InvokeAsync(() =>
            {
                Console.WriteLine($"[SessionView C#] [Student] Session started by lecturer. Activating peer connection.");
                State.IsSessionStarted = true;
                State.Status = SessionStatus.Started;

                if (CurrentSession != null)
                {
                    CurrentSession.IsSessionStarted = true;
                    CurrentSession.Status = SessionStatus.Started;
                }

                _pendingStudentPeerSetup = true;
                StateHasChanged();
            });
        }
    }

    private async Task OnSessionEnded(string sessionId)
    {
        if (_isDisposed || _isNavigating) return;

        Console.WriteLine($"[SessionView C#] SignalR: OnSessionEnded event received. SessionId: {sessionId}");

        if (sessionId == SessionId)
        {
            try
            {
                // Cleanup JS resources
                Console.WriteLine($"[SessionView C#] Cleaning up JS media/peer resources...");
                await SessionJsInterop.CleanupAsync();

                // Clear storage
                await ClearSessionStorageAsync();

                await InvokeAsync(() =>
                {
                    // Show brief message
                    State.SetError("Session has ended");
                    StateHasChanged();
                });

                await Task.Delay(2000);

                // Navigate based on role
                _isNavigating = true;
                if (State.IsLecturer)
                {
                    Console.WriteLine($"[SessionView C#] [Lecturer] Session ended. Redirecting to recap page.");
                    Navigation.NavigateTo($"/session-recap/{sessionId}", forceLoad: true);
                }
                else
                {
                    Console.WriteLine($"[SessionView C#] [Student] Session ended. Redirecting to dashboard.");
                    Navigation.NavigateTo("/dashboard", forceLoad: true);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[SessionView C#] Error in OnSessionEnded: {ex.Message}");
            }
        }
    }

    private async Task OnReceivePeerId(string userId, string peerId)
    {
        Console.WriteLine($"[SessionView C#] SignalR: OnReceivePeerId. Student: {userId} -> PeerId: {peerId}");

        if (State.IsLecturer)
        {
            await InvokeAsync(() =>
            {
                State.AddStudentPeer(peerId, userId);
                _participantPanelVersion++;
                StateHasChanged();
            });
        }
    }

    private async Task OnStreamChange(string streamType)
    {
        Console.WriteLine($"[SessionView C#] SignalR: OnStreamChange. StreamType: {streamType}");

        await InvokeAsync(() =>
        {
            State.CurrentStreamType = streamType;
            StateHasChanged();
        });

        if (!State.IsLecturer)
        {
            // Notify JS to handle stream change
            Console.WriteLine($"[SessionView C#] [Student] Calling SessionJsInterop.HandleStreamChangeAsync({streamType})...");
            await SessionJsInterop.HandleStreamChangeAsync(streamType);
        }
    }

    private async Task OnReceiveParticipants(Dictionary<string, string> participants)
    {
        Console.WriteLine($"[SessionView C#] SignalR: OnReceiveParticipants. Count: {participants.Count}. Payload: {string.Join(", ", participants.Select(p => $"{p.Key}={p.Value}"))}");

        await InvokeAsync(() =>
        {
            State.Participants.Clear();
            foreach (var participant in participants.OrderBy(p => p.Key))
            {
                State.AddParticipant(participant.Key, participant.Value);
            }

            Console.WriteLine($"[SessionView C#] Updated State.Participants. Count: {State.Participants.Count}. Entries: {string.Join(", ", State.Participants.Select(p => $"{p.Key}={p.Value}"))}");

            _participantPanelVersion++;
            StateHasChanged();
        });
    }

    private async Task OnReceiveParticipantStatuses(Dictionary<string, Session.StudentStatus> statuses)
    {
        Console.WriteLine($"[SessionView C#] SignalR: OnReceiveParticipantStatuses. Count: {statuses.Count}");

        await InvokeAsync(() =>
        {
            State.ParticipantStatuses.Clear();
            foreach (var status in statuses.OrderBy(s => s.Key))
            {
                State.UpdateParticipantStatus(status.Key, status.Value);
            }

            _participantPanelVersion++;
            StateHasChanged();
        });
    }

    private async Task RefreshParticipantsFromSessionAsync(Session session)
    {
        ArgumentNullException.ThrowIfNull(session);

        var participants = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var participantId in session.ParticipantIds.OrderBy(id => id, StringComparer.OrdinalIgnoreCase))
        {
            var user = await UserLookupService.GetUserByMatricNoAsync(participantId);
            participants[participantId] = user?.Name ?? participantId;
        }

        Console.WriteLine($"[SessionView C#] RefreshParticipantsFromSessionAsync. Count: {participants.Count}. Entries: {string.Join(", ", participants.Select(p => $"{p.Key}={p.Value}"))}");

        State.Participants.Clear();
        foreach (var participant in participants)
        {
            State.AddParticipant(participant.Key, participant.Value);
        }

        _participantPanelVersion++;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnAreYouThere()
    {
        Console.WriteLine("AreYouThere prompt received from lecturer");

        await InvokeAsync(() =>
        {
            if (!State.IsLecturer)
            {
                _showEngagementModal = true;
            }

            StateHasChanged();
        });
    }

    private async Task HideEngagementModal()
    {
        await InvokeAsync(() =>
        {
            _showEngagementModal = false;
            StateHasChanged();
        });
    }

    // JSInvokable Callbacks (called from JavaScript)
    [JSInvokable]
    public async Task OnLecturerPeerReady(string peerId)
    {
        Console.WriteLine($"[SessionView C#] [JSInvokable] OnLecturerPeerReady: PeerId={peerId}. Setting MyPeerId, IsPeerConnected=true, and triggering SessionStarted SignalR event.");
        State.MyPeerId = peerId;
        State.IsPeerConnected = true;

        // Notify SignalR that session started
        if (_hubConnection != null)
        {
            await _hubConnection.SendAsync("SessionStarted", SessionId);
        }

        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnStudentConnected(string peerId)
    {
        Console.WriteLine($"[SessionView C#] [JSInvokable] OnStudentConnected: Student PeerId={peerId}. Registering/updating student connection in state.");
        State.AddStudentPeer(peerId);
        if (State.IsLecturer)
        {
            var participantId = State.ConnectedStudents
                .FirstOrDefault(p => string.Equals(p.Key, peerId, StringComparison.OrdinalIgnoreCase)).Value;

            if (string.IsNullOrWhiteSpace(participantId))
            {
                participantId = State.StudentPeerIds.FirstOrDefault(id => string.Equals(id, peerId, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(participantId))
            {
                var user = await UserLookupService.GetUserByMatricNoAsync(participantId);
                State.AddParticipant(participantId, user?.Name ?? participantId);
            }

            _participantPanelVersion++;
        }
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnStudentDisconnected(string peerId)
    {
        Console.WriteLine($"[SessionView C#] [JSInvokable] OnStudentDisconnected: Student PeerId={peerId}. Removing student connection from state.");
        State.RemoveStudentPeer(peerId);
        if (State.IsLecturer)
        {
            _participantPanelVersion++;
        }
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnStreamTypeChanged(string streamType)
    {
        Console.WriteLine($"[SessionView C#] [JSInvokable] OnStreamTypeChanged: StreamType={streamType}. Updating local state and broadcasting stream change to students via SignalR.");
        State.CurrentStreamType = streamType;

        // Notify students via SignalR
        if (_hubConnection != null && State.IsLecturer)
        {
            await _hubConnection.SendAsync("NotifyStreamChange", SessionId, streamType);
        }

        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnStudentPeerReady(string peerId)
    {
        Console.WriteLine($"[SessionView C#] [JSInvokable] OnStudentPeerReady: Student PeerId={peerId}. Sending peer ID to SignalR Hub.");
        State.MyPeerId = peerId;

        // Send peer ID to SignalR so lecturer can connect
        if (_hubConnection != null && State.CurrentUser != null)
        {
            await _hubConnection.SendAsync("SendPeerId", SessionId, State.CurrentUser.MatricNo, peerId);
        }

        StateHasChanged();
    }

    [JSInvokable]
    public Task OnConnectedToLecturer(string lecturerPeerId)
    {
        Console.WriteLine($"[SessionView C#] [JSInvokable] OnConnectedToLecturer: Connected to lecturer peer {lecturerPeerId}. Marking peer connection active.");
        State.IsPeerConnected = true;
        State.StopLoading();
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public void OnStreamReceived()
    {
        Console.WriteLine($"[SessionView C#] [JSInvokable] OnStreamReceived: Media stream received from lecturer. Setting IsStreamLoaded=true, IsPeerConnected=true, stopping loading state.");
        State.IsStreamLoaded = true;
        State.IsPeerConnected = true;
        State.ShowMobilePlayOverlay = State.IsMobileDevice;
        State.StopLoading();
        StateHasChanged();
    }

    [JSInvokable]
    public void OnStreamLost()
    {
        Console.WriteLine("[SessionView C#] [JSInvokable] OnStreamLost: Media stream lost/disconnected. Setting IsStreamLoaded=false.");
        State.IsStreamLoaded = false;
        State.SetError("Connection to lecturer lost. Reconnecting...");
        StateHasChanged();
    }

    [JSInvokable]
    public void OnPeerError(string errorType)
    {
        Console.WriteLine($"[SessionView C#] [JSInvokable] OnPeerError: Error occurred: '{errorType}'. Connection attempt #{State.ConnectionAttempts}. Processing retry logic.");
        State.RecordConnectionAttempt();

        if (State.ShouldRetryConnection() && !State.HasExceededMaxAttempts)
        {
            State.SetError("Connection issue. Retrying...");
        }
        else if (State.HasExceededMaxAttempts)
        {
            State.SetError("Unable to establish connection. Please refresh the page.");
        }
    }

    [JSInvokable]
    public async Task OnTabVisibilityChanged(bool isVisible)
    {
        Console.WriteLine($"[SessionView C#] [JSInvokable] OnTabVisibilityChanged: isVisible={isVisible}. Updating participant activity state.");

        if (_hubConnection is null || State.IsLecturer || !State.IsSessionStarted)
        {
            return;
        }

        await _hubConnection.SendAsync("UpdateTabStatus", isVisible);
    }

    private async Task TryRestoreSessionStateAsync()
    {
        var restored = await SessionJsInterop.RestoreSessionStateAsync();
        if (restored is not System.Text.Json.JsonElement json || json.ValueKind != System.Text.Json.JsonValueKind.Object)
        {
            return;
        }

        if (json.TryGetProperty("isTestingCamera", out var isTestingCamera) && isTestingCamera.ValueKind == System.Text.Json.JsonValueKind.True || isTestingCamera.ValueKind == System.Text.Json.JsonValueKind.False)
        {
            State.IsTestingCamera = isTestingCamera.GetBoolean();
        }

        if (json.TryGetProperty("showTestCameraSection", out var showTestCameraSection) && (showTestCameraSection.ValueKind == System.Text.Json.JsonValueKind.True || showTestCameraSection.ValueKind == System.Text.Json.JsonValueKind.False))
        {
            State.ShowTestCameraSection = showTestCameraSection.GetBoolean();
        }
    }

    private Task SaveSessionStateAsync()
    {
        var state = new
        {
            sessionId = SessionId,
            isSessionStarted = State.IsSessionStarted,
            isLecturer = State.IsLecturer,
            isTestingCamera = State.IsTestingCamera,
            showTestCameraSection = State.ShowTestCameraSection
        };

        return SessionJsInterop.SaveSessionStateAsync(state);
    }

    private Task ClearSessionStorageAsync() => SessionJsInterop.ClearSessionStateAsync();

    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;

        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }
}

