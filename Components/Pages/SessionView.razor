    private async Task StartSession()
    {
        if (CurrentSession == null || !State.IsLecturer || State.IsLoading || State.IsWebcamActive)
        {
            Console.WriteLine($"[SessionView C#] [Lecturer] StartSession ignored: Session is null, not lecturer, already loading, or webcam already active");
            return;
        }

        Console.WriteLine($"[SessionView C#] [Lecturer] Starting Session. SessionId: {SessionId}");
        try
        {
            State.StartLoading("Starting session...");

            // Update session in service
            Console.WriteLine($"[SessionView C#] [Lecturer] Calling SessionService.StartSessionAsync...");
            var updatedSession = await SessionService.StartSessionAsync(SessionId);
            
            if (updatedSession != null)
            {
                CurrentSession = updatedSession;
                CurrentSession.IsSessionStarted = true;
                State.IsSessionStarted = true;
                State.Status = CurrentSession.Status;
                State.ShowTestCameraSection = false;
                Console.WriteLine($"[SessionView C#] [Lecturer] Session status updated to: {CurrentSession.Status}");
            }

            // Broadcast session started to all connected students via SignalR
            if (_hubConnection != null && _hubConnection.State == HubConnectionState.Connected)
            {
                Console.WriteLine($"[SessionView C#] [Lecturer] Broadcasting SessionStarted to hub for SessionId: {SessionId}");
                try
                {
                    await _hubConnection.SendAsync("SessionStarted", SessionId);
                }
                catch (Exception hubEx)
                {
                    Console.WriteLine($"[SessionView C#] [Lecturer] Failed to broadcast SessionStarted via SignalR: {hubEx.Message}");
                }
            }

            StateHasChanged();
            await Task.Yield();

            // Start webcam via JS interop
            Console.WriteLine($"[SessionView C#] [Lecturer] Calling SessionJsInterop.StartWebcamAsync...");
            var result = await SessionJsInterop.StartWebcamAsync(SessionId);

            // Parse result safely
            if (result != null)
            {
                var resultJson = System.Text.Json.JsonSerializer.Serialize(result);
                var resultDict = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, System.Text.Json.JsonElement>>(resultJson);

                if (resultDict != null && resultDict.ContainsKey("success"))
                {
                    var success = resultDict["success"].GetBoolean();
                    if (success)
                    {
                        State.IsWebcamActive = true;
                        State.StopLoading();
                        State.ClearError();
                        Console.WriteLine("[SessionView C#] [Lecturer] Webcam started successfully on client side");

                        // Publish camera to LiveKit room for students
                        try
                        {
                            await JSRuntime.InvokeAsync<object>("livekitInterop.publishCamera");
                        }
                        catch (Exception lkEx)
                        {
                            Console.WriteLine($"[SessionView C#] [Lecturer] LiveKit publishCamera threw: {lkEx.Message}");
                        }
                    }
                    else
                    {
                        var error = resultDict.ContainsKey("error") 
                            ? resultDict["error"].GetString() 
                            : "Unknown error";
                        State.SetError($"Camera failed: {error}. Please check permissions and try again.");
                        Console.WriteLine($"[SessionView C#] [Lecturer] Webcam start failed: {error}");
                    }
                }
            }
            else
            {
                Console.WriteLine("[SessionView C#] [Lecturer] Webcam start returned null result");
                State.SetError("Failed to start camera. Please refresh and try again.");
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SessionView C#] [Lecturer] Error starting session: {ex.Message}");
            State.SetError($"Failed to start session: {ex.Message}");
        }
    }

    private async Task ToggleScreenShare()
    {
        if (!State.IsLecturer || !State.IsWebcamActive || State.IsLoading)
        {
            Console.WriteLine("[SessionView C#] [Lecturer] ToggleScreenShare ignored: conditions not met");
            return;
        }

        Console.WriteLine($"[SessionView C#] [Lecturer] ToggleScreenShare. Current state: IsScreenSharing={State.IsScreenSharing}");
        try
        {
            State.IsLoading = true;
            StateHasChanged();

            if (State.IsScreenSharing)
            {
                // Switch back to webcam
                State.IsScreenSharing = false;
                Console.WriteLine("[SessionView C#] [Lecturer] Disabling ScreenShare flag (reverting to webcam)");
                try
                {
                    await JSRuntime.InvokeAsync<object>("livekitInterop.stopScreenShare");
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[SessionView C#] [Lecturer] LiveKit stopScreenShare error: {ex.Message}");
                }
            }
            else
            {
                // Start screen share
                Console.WriteLine("[SessionView C#] [Lecturer] Calling SessionJsInterop.StartScreenShareAsync...");
                var result = await SessionJsInterop.StartScreenShareAsync();
                
                if (result != null)
                {
                    var resultJson = System.Text.Json.JsonSerializer.Serialize(result);
                    var resultDict = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, System.Text.Json.JsonElement>>(resultJson);

                    if (resultDict != null && resultDict.ContainsKey("success"))
                    {
                        var success = resultDict["success"].GetBoolean();
                        if (success)
                        {
                            State.IsScreenSharing = true;
                            Console.WriteLine("[SessionView C#] [Lecturer] Screen share started successfully on client side");
                            try
                            {
                                await JSRuntime.InvokeAsync<object>("livekitInterop.startScreenShare");
                            }
                            catch (Exception ex)
                            {
                                Console.WriteLine($"[SessionView C#] [Lecturer] LiveKit startScreenShare error: {ex.Message}");
                            }
                        }
                        else
                        {
                            var error = resultDict.ContainsKey("error") 
                                ? resultDict["error"].GetString() 
                                : "Unknown error";
                            State.SetError($"Screen share failed: {error}");
                            Console.WriteLine($"[SessionView C#] [Lecturer] Screen share failed: {error}");
                        }
                    }
                }
            }

            State.IsLoading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SessionView C#] [Lecturer] Error toggling screen share: {ex.Message}");
            State.SetError($"Screen share error: {ex.Message}");
            State.IsLoading = false;
        }
    }

