    // Session Persistence (Browser Storage)
    private async Task SaveSessionStateAsync()
    {
        if (_isDisposed || State.CurrentUser == null) return;

        try
        {
            var storageKey = $"viidii_session_{SessionId}_{State.CurrentUser.MatricNo}";
            var stateData = new
            {
                SessionId = State.SessionId,
                IsSessionStarted = State.IsSessionStarted,
                IsLecturer = State.IsLecturer,
                MyPeerId = State.MyPeerId,
                LecturerPeerId = State.LecturerPeerId,
                JoinedAt = DateTime.UtcNow,
                UserId = State.CurrentUser.MatricNo
            };

            var json = System.Text.Json.JsonSerializer.Serialize(stateData);
            await JSRuntime.InvokeVoidAsync("sessionStorage.setItem", storageKey, json);
            
            Console.WriteLine($"Session state saved to storage: {storageKey}");
        }
        catch (JSDisconnectedException)
        {
            Console.WriteLine("JS disconnected, cannot save state");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving session state: {ex.Message}");
        }
    }

    private async Task TryRestoreSessionStateAsync()
    {
        try
        {
            // Try to get user MatricNo from auth service first (might not be available yet)
            var tempUser = await AuthService.GetCurrentUserAsync();
            if (tempUser == null) return;

            var storageKey = $"viidii_session_{SessionId}_{tempUser.MatricNo}";
            var json = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", storageKey);

            if (!string.IsNullOrEmpty(json))
            {
                var stateData = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, System.Text.Json.JsonElement>>(json);
                if (stateData != null)
                {
                    State.IsRestoredFromStorage = true;
                    
                    // Check if this is a recent session (within last 30 minutes)
                    if (stateData.ContainsKey("JoinedAt"))
                    {
                        var joinedAtStr = stateData["JoinedAt"].GetString();
                        if (DateTime.TryParse(joinedAtStr, out var joinedAt))
                        {
                            var timeSinceJoin = DateTime.UtcNow - joinedAt;
                            
                            // For development: 2 minutes, Production: 30 minutes
                            #if DEBUG
                            var expiryMinutes = 2;
                            #else
                            var expiryMinutes = 30;
                            #endif
                            
                            if (timeSinceJoin.TotalMinutes > expiryMinutes)
                            {
                                // Session too old, clear storage and start fresh
                                await ClearSessionStorageAsync();
                                State.IsRestoredFromStorage = false;
                                Console.WriteLine($"Session expired ({timeSinceJoin.TotalMinutes:F0} minutes old), starting fresh");
                                return;
                            }
                        }
                    }

                    Console.WriteLine($"Session state restored from storage: {storageKey}");
                }
            }
        }
        catch (JSDisconnectedException)
        {
            Console.WriteLine("JS disconnected, cannot restore state");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error restoring session state: {ex.Message}");
            State.IsRestoredFromStorage = false;
        }
    }

    private async Task ClearSessionStorageAsync()
    {
        if (_isDisposed || State.CurrentUser == null) return;

        try
        {
            var storageKey = $"viidii_session_{SessionId}_{State.CurrentUser.MatricNo}";
            await JSRuntime.InvokeVoidAsync("sessionStorage.removeItem", storageKey);
            Console.WriteLine($"Session storage cleared: {storageKey}");
        }
        catch (JSDisconnectedException)
        {
            Console.WriteLine("JS disconnected, cannot clear storage");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error clearing session storage: {ex.Message}");
        }
    }

    // Cleanup
    public async ValueTask DisposeAsync()
    {
        if (_isDisposed) return;
        _isDisposed = true;

        try
        {
            // Only clear storage if user intentionally ended/left session
            // (Not on refresh or accidental close)
            if (CurrentSession?.Status == SessionStatus.Ended)
            {
                await ClearSessionStorageAsync();
            }

            // Dispose DotNetObjectReference
            _dotNetRef?.Dispose();

            // Stop HubConnection
            if (_hubConnection != null)
            {
                try
                {
                    if (_hubConnection.State == HubConnectionState.Connected)
                    {
                        await _hubConnection.StopAsync();
                    }
                    await _hubConnection.DisposeAsync();
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error disposing HubConnection: {ex.Message}");
                }
            }

            // Cleanup JS interop
            try
            {
                await SessionJsInterop.CleanupAsync();
            }
            catch (JSDisconnectedException)
            {
                // Expected when browser closes
                Console.WriteLine("JS disconnected during cleanup (expected)");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error cleaning up JS interop: {ex.Message}");
            }

            Console.WriteLine("SessionView disposed");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in DisposeAsync: {ex.Message}");
        }
    }

