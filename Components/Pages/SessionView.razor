@page "/session/{SessionId}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable
@inject AuthService AuthService
@inject SessionService SessionService
@inject ISessionJsInterop SessionJsInterop
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@using VIIDII.Models
@using VIIDII.Services
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.JSInterop
@using System.Web

<PageTitle>Session - @SessionId</PageTitle>

@if (_isNavigating)
{
    <div class="loading-screen">
        <div class="spinner"></div>
        <p>Loading session...</p>
    </div>
}
else if (State.CurrentUser == null)
{
    <div class="alert alert-warning">Please log in first.</div>
}
else if (CurrentSession == null)
{
    <div class="alert alert-danger">Session not found or you don't have access.</div>
}
else
{
    <div class="session-container">
        <!-- Session Header -->
        <div class="session-header">
            <h1>@CurrentSession.Title</h1>
            <p>Session ID: <strong>@SessionId</strong></p>
            <p>Status: <strong>@CurrentSession.Status</strong></p>
            @if (State.IsLecturer && State.ParticipantCount > 0)
            {
                <span class="participant-badge">@State.ParticipantCount participant(s)</span>
            }
            
            <!-- Dev Tools (DEBUG mode only) -->
            #if DEBUG
            <div class="dev-tools">
                <button class="btn-dev-clear" @onclick="DevClearStorage" title="Clear session storage (Dev only)">
                    <i class="fas fa-trash"></i> Clear Storage
                </button>
                <button class="btn-dev-logout" @onclick="DevLogout" title="Logout (Dev only)">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </button>
            </div>
            #endif
        </div>

        <!-- Error Banner -->
        @if (!string.IsNullOrEmpty(State.ErrorMessage))
        {
            <div class="error-banner">
                <i class="fas fa-exclamation-triangle"></i>
                <span>@State.ErrorMessage</span>
                @if (!State.HasExceededMaxAttempts && !State.IsLecturer)
                {
                    <button class="btn-retry" @onclick="RetryConnection">Retry</button>
                }
                else if (State.HasExceededMaxAttempts)
                {
                    <button class="btn-retry" @onclick="RefreshPage">Refresh Page</button>
                }
            </div>
        }

        <!-- Test Camera Section (Lecturer Only, Before Session Starts) -->
        @if (State.IsLecturer && !State.IsSessionStarted && State.ShowTestCameraSection)
        {
            <div class="test-camera-section">
                <h3>Test Your Camera</h3>
                <p>Make sure your camera and microphone are working before starting the session.</p>
                <div class="test-video-container">
                    <video id="testVideo" autoplay playsinline muted class="test-video"></video>
                </div>
                <div class="test-controls">
                    @if (!State.IsTestingCamera)
                    {
                        <button class="btn btn-primary" @onclick="TestCamera">
                            <i class="fas fa-video"></i> Test Camera
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-secondary" @onclick="StopTestCamera">
                            <i class="fas fa-stop"></i> Stop Test
                        </button>
                        <button class="btn btn-success" @onclick="StartSessionWithCamera">
                            <i class="fas fa-play"></i> Looks Good - Start Session
                        </button>
                    }
                </div>
            </div>
        }

        <!-- Video Section -->
        @if (State.IsSessionStarted || State.IsTestingCamera)
        {
            <div class="video-section">
                <div class="video-container" id="videoContainer">
                    <!-- Main Video Element -->
                    <video id="sessionVideo" 
                           autoplay 
                           playsinline 
                           muted="@State.IsLecturer"
                           class="session-video">
                    </video>

                    <!-- Loading Overlay -->
                    @if (State.IsLoading || State.IsInitializing)
                    {
                        <div class="loading-overlay">
                            <div class="spinner"></div>
                            <p>@(State.IsLecturer ? "Initializing camera..." : "Connecting to session...")</p>
                        </div>
                    }

                    <!-- Mobile Play Overlay -->
                    @if (State.ShowMobilePlayOverlay && !State.IsLecturer)
                    {
                        <div class="mobile-play-overlay" @onclick="PlayVideo">
                            <div class="play-button">
                                <i class="fas fa-play"></i>
                                <p>Tap to start video</p>
                            </div>
                        </div>
                    }

                    <!-- Waiting for Lecturer (Student View) -->
                    @if (!State.IsLecturer && !State.IsPeerConnected && State.IsSessionStarted)
                    {
                        <div class="waiting-overlay">
                            <div class="spinner"></div>
                            <p>Waiting for lecturer to start streaming...</p>
                        </div>
                    }

                    <!-- Stream Type Indicator -->
                    @if (State.IsLecturer && State.IsWebcamActive)
                    {
                        <div class="stream-indicator">
                            <i class="fas fa-@(State.IsScreenSharing ? "desktop" : "video")"></i>
                            <span>@(State.IsScreenSharing ? "Screen Sharing" : "Camera")</span>
                        </div>
                    }
                </div>

                <!-- Video Controls (Below Video) -->
                <div class="video-controls-container">
                    @if (State.IsLecturer && State.IsWebcamActive)
                    {
                        <div class="video-controls">
                            <button class="btn-control" @onclick="ToggleScreenShare" disabled="@State.IsLoading">
                                <i class="fas fa-@(State.IsScreenSharing ? "video" : "desktop")"></i>
                                <span class="control-label">@(State.IsScreenSharing ? "Camera" : "Share Screen")</span>
                            </button>
                            
                            <button class="btn-control btn-danger" @onclick="EndSession">
                                <i class="fas fa-stop"></i>
                                <span class="control-label">End Session</span>
                            </button>
                        </div>
                    }
                    else if (State.IsLecturer && !State.IsSessionStarted)
                    {
                        <div class="video-controls">
                            <button class="btn btn-success btn-lg" @onclick="StartSession" disabled="@State.IsLoading">
                                <i class="fas fa-play"></i> Start Session
                            </button>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Tab Section (Messages & Participants) -->
        @if (State.IsSessionStarted)
        {
            <div class="tab-section @(State.IsTabExpanded ? "expanded" : "")">
                <!-- Tab Headers -->
                <div class="tab-headers">
                    <button class="tab-header @(State.ActiveTab == "messages" ? "active" : "")" 
                            @onclick='() => State.SetTab("messages")'>
                        <i class="fas fa-comments"></i>
                        <span>Messages</span>
                    </button>
                    <button class="tab-header @(State.ActiveTab == "participants" ? "active" : "")" 
                            @onclick='() => State.SetTab("participants")'>
                        <i class="fas fa-users"></i>
                        <span>Participants (@State.ParticipantCount)</span>
                    </button>
                    <button class="tab-toggle" @onclick="ToggleTabExpansion">
                        <i class="fas fa-@(State.IsTabExpanded ? "compress" : "expand")"></i>
                    </button>
                </div>

                <!-- Tab Content -->
                <div class="tab-content">
                    @if (State.ActiveTab == "messages")
                    {
                        <MessagingPanel SessionId="@SessionId"
                                       IsLecturer="@State.IsLecturer"
                                       HubConnection="@_hubConnection"
                                       CurrentUserId="@(State.CurrentUser?.MatricNo ?? "")" />
                    }
                    else
                    {
                        <ParticipantPanel Participants="@State.Participants"
                                         ParticipantStatuses="@State.ParticipantStatuses"
                                         HubConnection="@_hubConnection"
                                         SessionId="@SessionId"
                                         IsLecturer="@State.IsLecturer" />
                    }
                </div>
            </div>
        }

        <!-- Issue Buttons (Student Only) -->
        @if (!State.IsLecturer && State.IsSessionStarted)
        {
            <IssueButtons HubConnection="@_hubConnection" />
        }
    </div>

    <!-- Engagement Modal (Student Only) -->
    @if (!State.IsLecturer)
    {
        <EngagementModal HubConnection="@_hubConnection"
                         IsStudent="true"
                         ShouldShow="@_showEngagementModal"
                         OnHidden="@HideEngagementModal" />
    }
}

@code {
    [Parameter]
    public string SessionId { get; set; } = string.Empty;

    // State
    private SessionState State = new();
    private VIIDII.Models.Session? CurrentSession;
    private HubConnection? _hubConnection;
    private DotNetObjectReference<SessionView>? _dotNetRef;
    private bool _showEngagementModal = false;
    private bool _isDisposed = false;
    private bool _isNavigating = false; // Prevent render after navigation
    private bool IsLecturer => State.IsLecturer;

    // Lifecycle Methods
    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Load user FIRST
            State.CurrentUser = await AuthService.GetCurrentUserAsync();
            if (State.CurrentUser == null)
            {
                _isNavigating = true;
                Navigation.NavigateTo("/login", forceLoad: true);
                return;
            }

            // Load session
            CurrentSession = SessionService.GetSessionById(SessionId);
            if (CurrentSession == null)
            {
                _isNavigating = true;
                Navigation.NavigateTo("/dashboard", forceLoad: true);
                return;
            }

            // Check for fresh start query parameter
            var uri = new Uri(Navigation.Uri);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            bool forceFreshStart = query["fresh"] == "true";

            if (forceFreshStart)
            {
                Console.WriteLine("Fresh start requested - clearing session storage");
                await ClearSessionStorageAsync();
            }
            else
            {
                // Try to restore state (after user is loaded)
                await TryRestoreSessionStateAsync();
            }

            // Initialize state
            State.SessionId = SessionId;
            State.SessionTitle = CurrentSession.Title;
            State.Status = CurrentSession.Status;
            State.IsSessionStarted = CurrentSession.IsSessionStarted;
            State.IsLecturer = CurrentSession.LecturerId == State.CurrentUser.MatricNo;

            // Show test camera for lecturer before session starts
            if (State.IsLecturer && !State.IsSessionStarted)
            {
                State.ShowTestCameraSection = true;
            }

            // Setup SignalR Hub Connection
            await SetupHubConnectionAsync();

            // Save initial state to browser storage
            await SaveSessionStateAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Critical error in OnInitializedAsync: {ex.Message}");
            State.SetError($"Failed to load session: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Check if mobile
                State.IsMobileDevice = await SessionJsInterop.IsMobileAsync();

                // Create DotNetObjectReference for callbacks
                _dotNetRef = DotNetObjectReference.Create(this);

                // Initialize JS interop
                await SessionJsInterop.InitializeAsync(SessionId, State.IsLecturer, _dotNetRef);

                // Setup tab visibility listener for students
                if (!State.IsLecturer)
                {
                    await SessionJsInterop.SetupTabVisibilityListenerAsync();
                }

                // If student and session already started, setup peer
                if (!State.IsLecturer && State.IsSessionStarted)
                {
                    await SetupStudentPeerConnectionAsync();
                }

                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error in OnAfterRenderAsync: {ex.Message}");
                State.SetError($"Initialization error: {ex.Message}");
            }
        }
    }

    // SignalR Setup
    private async Task SetupHubConnectionAsync()
    {
        try
        {
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/sessionHub"))
                .WithAutomaticReconnect()
                .Build();

            RegisterSignalRHandlers();

            await _hubConnection.StartAsync();
            State.IsHubConnected = true;

            // Join session
            await _hubConnection.SendAsync("JoinSession", SessionId);

            Console.WriteLine($"SignalR connected and joined session: {SessionId}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SignalR connection error: {ex.Message}");
            State.SetError("Failed to connect to session. Please refresh the page.");
        }
    }

    private void RegisterSignalRHandlers()
    {
        if (_hubConnection == null) return;

        // Session lifecycle
        _hubConnection.On<string>("SessionStarted", OnSessionStarted);
        _hubConnection.On<string>("SessionEnded", OnSessionEnded);

        // Peer management
        _hubConnection.On<string, string>("ReceivePeerId", OnReceivePeerId);

        // Stream changes
        _hubConnection.On<string>("ReceiveStreamChange", OnStreamChange);

        // Participant management (lecturer only)
        if (State.IsLecturer)
        {
            _hubConnection.On<Dictionary<string, string>>("ReceiveParticipants", OnReceiveParticipants);
            _hubConnection.On<Dictionary<string, string>>("ReceiveParticipantStatuses", OnReceiveParticipantStatuses);
        }

        // Engagement tracking (student only)
        if (!State.IsLecturer)
        {
            _hubConnection.On("AreYouThere", OnAreYouThere);
        }
    }

    // Lecturer Methods
    private async Task TestCamera()
    {
        if (State.IsTestingCamera) return; // Prevent multiple clicks

        try
        {
            State.IsTestingCamera = true;
            State.StartLoading("Starting camera test...");

            // Force render to ensure test video element exists
            StateHasChanged();
            await Task.Delay(100); // Wait for DOM to update

            // Use test video element
            var result = await JSRuntime.InvokeAsync<object>("eval", @"
                (async () => {
                    try {
                        const video = document.getElementById('testVideo');
                        if (!video) return { success: false, error: 'Video element not found' };
                        
                        const stream = await navigator.mediaDevices.getUserMedia({ 
                            video: { width: { ideal: 720 }, height: { ideal: 420 } }, 
                            audio: true 
                        });
                        video.srcObject = stream;
                        window.testStream = stream;
                        return { success: true };
                    } catch (err) {
                        return { success: false, error: err.message };
                    }
                })()
            ");

            State.StopLoading();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            State.SetError($"Camera test failed: {ex.Message}");
            State.IsTestingCamera = false;
            Console.WriteLine($"TestCamera error: {ex.Message}");
        }
    }

    private async Task StopTestCamera()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                if (window.testStream) {
                    window.testStream.getTracks().forEach(track => track.stop());
                    const video = document.getElementById('testVideo');
                    if (video) video.srcObject = null;
                    delete window.testStream;
                }
            ");

            State.IsTestingCamera = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error stopping test camera: {ex.Message}");
            // Don't set error here, just log it
            State.IsTestingCamera = false;
        }
    }

    private async Task StartSessionWithCamera()
    {
        await StopTestCamera();
        await StartSession();
    }

    private async Task StartSession()
    {
        if (CurrentSession == null || !State.IsLecturer || State.IsLoading || State.IsWebcamActive)
            return;

        try
        {
            State.StartLoading("Starting session...");

            // Update session in service
            SessionService.StartSession(SessionId);
            CurrentSession.IsSessionStarted = true;
            State.IsSessionStarted = true;
            State.ShowTestCameraSection = false;

            // Force render to ensure video element exists
            StateHasChanged();
            await Task.Delay(100); // Wait for DOM to update

            // Start webcam via JS interop
            var result = await SessionJsInterop.StartWebcamAsync(SessionId);

            // Parse result safely
            if (result != null)
            {
                var resultJson = System.Text.Json.JsonSerializer.Serialize(result);
                var resultDict = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, System.Text.Json.JsonElement>>(resultJson);

                if (resultDict != null && resultDict.ContainsKey("success"))
                {
                    var success = resultDict["success"].GetBoolean();
                    if (success)
                    {
                        State.IsWebcamActive = true;
                        State.StopLoading();
                        State.ClearError();
                        Console.WriteLine("Webcam started successfully");
                    }
                    else
                    {
                        var error = resultDict.ContainsKey("error") 
                            ? resultDict["error"].GetString() 
                            : "Unknown error";
                        State.SetError($"Camera failed: {error}. Please check permissions and try again.");
                        Console.WriteLine($"Webcam start failed: {error}");
                    }
                }
            }
            else
            {
                State.SetError("Failed to start camera. Please refresh and try again.");
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error starting session: {ex.Message}");
            State.SetError($"Failed to start session: {ex.Message}");
        }
    }

    private async Task ToggleScreenShare()
    {
        if (!State.IsLecturer || !State.IsWebcamActive || State.IsLoading) return;

        try
        {
            State.IsLoading = true;
            StateHasChanged();

            if (State.IsScreenSharing)
            {
                // Switch back to webcam - JS will handle this automatically when screen share stops
                State.IsScreenSharing = false;
            }
            else
            {
                // Start screen share
                var result = await SessionJsInterop.StartScreenShareAsync();
                
                if (result != null)
                {
                    var resultJson = System.Text.Json.JsonSerializer.Serialize(result);
                    var resultDict = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, System.Text.Json.JsonElement>>(resultJson);

                    if (resultDict != null && resultDict.ContainsKey("success"))
                    {
                        var success = resultDict["success"].GetBoolean();
                        if (success)
                        {
                            State.IsScreenSharing = true;
                            Console.WriteLine("Screen share started successfully");
                        }
                        else
                        {
                            var error = resultDict.ContainsKey("error") 
                                ? resultDict["error"].GetString() 
                                : "Unknown error";
                            State.SetError($"Screen share failed: {error}");
                            Console.WriteLine($"Screen share failed: {error}");
                        }
                    }
                }
            }

            State.IsLoading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error toggling screen share: {ex.Message}");
            State.SetError($"Screen share error: {ex.Message}");
            State.IsLoading = false;
        }
    }

    private async Task EndSession()
    {
        if (CurrentSession == null || !State.IsLecturer || State.CurrentUser == null || State.IsLoading)
            return;

        try
        {
            State.StartLoading("Ending session...");

            // End session in service
            SessionService.EndSession(SessionId, State.CurrentUser.MatricNo);

            // Notify via SignalR
            if (_hubConnection != null && _hubConnection.State == HubConnectionState.Connected)
            {
                await _hubConnection.SendAsync("EndSession", SessionId);
            }

            // Clear session storage
            await ClearSessionStorageAsync();

            // Cleanup JS resources
            await SessionJsInterop.CleanupAsync();

            State.StopLoading();

            // Navigate after cleanup
            _isNavigating = true;
            Navigation.NavigateTo("/dashboard", forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error ending session: {ex.Message}");
            State.SetError($"Error ending session: {ex.Message}");
        }
    }

    // Student Methods
    private async Task SetupStudentPeerConnectionAsync()
    {
        if (State.IsLecturer) return;

        try
        {
            State.StartLoading("Setting up connection...");

            var result = await SessionJsInterop.SetupStudentPeerAsync();
            
            // Result will have { success: true, peerId: "..." }
            Console.WriteLine("Student peer setup initiated");

            State.StopLoading();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error setting up student peer: {ex.Message}");
            State.RecordConnectionAttempt();

            if (State.ShouldRetryConnection() && !State.HasExceededMaxAttempts)
            {
                // Retry after backoff delay
                await Task.Delay((int)(Math.Pow(2, State.ConnectionAttempts - 1) * 1000));
                await SetupStudentPeerConnectionAsync();
            }
            else if (State.HasExceededMaxAttempts)
            {
                State.SetError("Unable to connect to session. Please refresh the page.");
            }
        }
    }

    private async Task PlayVideo()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                const video = document.getElementById('sessionVideo');
                if (video) video.play();
            ");

            State.ShowMobilePlayOverlay = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error playing video: {ex.Message}");
        }
    }

    private async Task RetryConnection()
    {
        State.ClearError();
        State.ConnectionAttempts = 0;
        await SetupStudentPeerConnectionAsync();
    }

    private void RefreshPage()
    {
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    // SignalR Event Handlers
    private async Task OnSessionStarted(string sessionId)
    {
        Console.WriteLine($"SessionStarted event received: {sessionId}");

        if (!State.IsLecturer && sessionId == SessionId)
        {
            State.IsSessionStarted = true;
            await SetupStudentPeerConnectionAsync();
            StateHasChanged();
        }
    }

    private async Task OnSessionEnded(string sessionId)
    {
        if (_isDisposed || _isNavigating) return;

        Console.WriteLine($"SessionEnded event received: {sessionId}");

        if (sessionId == SessionId)
        {
            try
            {
                // Cleanup JS resources
                await SessionJsInterop.CleanupAsync();

                // Clear storage
                await ClearSessionStorageAsync();

                // Show brief message
                State.SetError("Session has ended");
                StateHasChanged();

                await Task.Delay(2000);

                // Navigate based on role
                _isNavigating = true;
                if (State.IsLecturer)
                {
                    Navigation.NavigateTo($"/session-recap/{sessionId}", forceLoad: true);
                }
                else
                {
                    Navigation.NavigateTo("/dashboard", forceLoad: true);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error in OnSessionEnded: {ex.Message}");
            }
        }
    }

    private void OnReceivePeerId(string userId, string peerId)
    {
        Console.WriteLine($"ReceivePeerId: {userId} -> {peerId}");

        if (State.IsLecturer)
        {
            State.AddStudentPeer(peerId, userId);
            StateHasChanged();
        }
    }

    private async Task OnStreamChange(string streamType)
    {
        Console.WriteLine($"Stream change: {streamType}");

        State.CurrentStreamType = streamType;

        if (!State.IsLecturer)
        {
            // Notify JS to handle stream change
            await SessionJsInterop.HandleStreamChangeAsync(streamType);
        }

        StateHasChanged();
    }

    private void OnReceiveParticipants(Dictionary<string, string> participants)
    {
        Console.WriteLine($"Received participants: {participants.Count}");

        foreach (var participant in participants)
        {
            State.AddParticipant(participant.Key, participant.Value);
        }

        StateHasChanged();
    }

    private void OnReceiveParticipantStatuses(Dictionary<string, string> statuses)
    {
        Console.WriteLine($"Received participant statuses: {statuses.Count}");

        foreach (var status in statuses)
        {
            if (Enum.TryParse<Session.StudentStatus>(status.Value, out var studentStatus))
            {
                State.UpdateParticipantStatus(status.Key, studentStatus);
            }
        }

        StateHasChanged();
    }

    // Engagement Handler
    private void OnAreYouThere()
    {
        Console.WriteLine("AreYouThere prompt received from lecturer");

        if (!State.IsLecturer)
        {
            _showEngagementModal = true;
        }

        StateHasChanged();
    }

    private void HideEngagementModal()
    {
        _showEngagementModal = false;
        StateHasChanged();
    }

    // JSInvokable Callbacks (called from JavaScript)
    [JSInvokable]
    public async Task OnLecturerPeerReady(string peerId)
    {
        Console.WriteLine($"Lecturer peer ready: {peerId}");
        State.MyPeerId = peerId;
        State.IsPeerConnected = true;

        // Notify SignalR that session started
        if (_hubConnection != null)
        {
            await _hubConnection.SendAsync("SessionStarted", SessionId);
        }

        StateHasChanged();
    }

    [JSInvokable]
    public void OnStudentConnected(string peerId)
    {
        Console.WriteLine($"Student connected: {peerId}");
        State.AddStudentPeer(peerId);
        StateHasChanged();
    }

    [JSInvokable]
    public void OnStudentDisconnected(string peerId)
    {
        Console.WriteLine($"Student disconnected: {peerId}");
        State.RemoveStudentPeer(peerId);
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnStreamTypeChanged(string streamType)
    {
        Console.WriteLine($"Stream type changed to: {streamType}");
        State.CurrentStreamType = streamType;

        // Notify students via SignalR
        if (_hubConnection != null && State.IsLecturer)
        {
            await _hubConnection.SendAsync("NotifyStreamChange", SessionId, streamType);
        }

        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnStudentPeerReady(string peerId)
    {
        Console.WriteLine($"Student peer ready: {peerId}");
        State.MyPeerId = peerId;

        // Send peer ID to SignalR so lecturer can connect
        if (_hubConnection != null)
        {
            await _hubConnection.SendAsync("SendPeerId", SessionId, peerId);
        }

        StateHasChanged();
    }

    [JSInvokable]
    public void OnStreamReceived()
    {
        Console.WriteLine("Stream received");
        State.IsStreamLoaded = true;
        State.IsPeerConnected = true;
        State.ShowMobilePlayOverlay = State.IsMobileDevice;
        State.StopLoading();
        StateHasChanged();
    }

    [JSInvokable]
    public void OnStreamLost()
    {
        Console.WriteLine("Stream lost");
        State.IsStreamLoaded = false;
        State.SetError("Connection to lecturer lost. Reconnecting...");
        StateHasChanged();
    }

    [JSInvokable]
    public void OnPeerError(string errorType)
    {
        Console.WriteLine($"Peer error: {errorType}");
        State.RecordConnectionAttempt();

        if (State.ShouldRetryConnection() && !State.HasExceededMaxAttempts)
        {
            State.SetError("Connection issue. Retrying...");
        }
        else if (State.HasExceededMaxAttempts)
        {
            State.SetError("Unable to establish connection. Please refresh the page.");
        }

        StateHasChanged();
    }

    [JSInvokable]
    public void OnConnectedToLecturer(string lecturerPeerId)
    {
        Console.WriteLine($"Connected to lecturer: {lecturerPeerId}");
        State.LecturerPeerId = lecturerPeerId;
        State.ClearError();
        StateHasChanged();
    }

    [JSInvokable]
    public void OnConnectionFailed(string errorType)
    {
        Console.WriteLine($"Connection failed: {errorType}");
        State.RecordConnectionAttempt();

        if (!State.HasExceededMaxAttempts)
        {
            State.SetError("Connection failed. Retrying...");
        }
        else
        {
            State.SetError("Unable to connect. Please refresh the page.");
        }

        StateHasChanged();
    }

