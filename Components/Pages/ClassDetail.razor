@page "/classes/{ClassId:int}"
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.JSInterop
@using VIIDII.Endpoints
@attribute [Authorize(Policy = ViidiiPolicies.LecturerOnly)]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthService AuthService
@inject ClassService ClassService

@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject RosterService RosterService

<PageTitle>@(Target?.Name ?? "Class") - VIIDII</PageTitle>

<div class="detail-wrap">

    <a href="/classes" class="detail-back">&larr; All classes</a>

    @if (IsLoading)
    {
        <p class="info-text">Loading...</p>
    }
    else if (Target is null)
    {
        <h1>Class not found</h1>
        <p class="info-text">It may have been removed, or the link is wrong.</p>
    }
    else
    {
        <div class="detail-head">
            <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.25rem;">
                <span class="detail-code">@Target.Code</span>
                <span class="preset-badge" style="background:rgba(59,130,246,0.12); color:#2563eb; border:1px solid rgba(59,130,246,0.25); padding:0.2rem 0.6rem; border-radius:999px; font-size:0.8rem; font-weight:600;">
                    @CurrentPreset.IconEmoji @CurrentPreset.Title
                </span>
            </div>
            <h1>@Target.Name</h1>
        </div>

        @if (!string.IsNullOrEmpty(Notice))
        {
            <div class="alert @NoticeKind">@Notice</div>
        }

        <div class="detail-card">
            <h2>Attendee Join Link</h2>
            <p class="info-text">
                Send this link to your @CurrentPreset.AttendeeLabel.ToLowerInvariant()s. They can enter from their browser with zero app installation.
            </p>

            <div class="share-row">
                <code class="share-link">@ShareUrl</code>
                <button class="btn-secondary-custom" @onclick="CopyLink">Copy</button>
            </div>
        </div>

        <div class="detail-card">
            <h2>⚡ Integrations & Automation</h2>
            <p class="info-text">
                Connect your payment gateway (Paystack / Flutterwave) or ticketing API. Paying attendees are automatically added in real-time.
            </p>
            <div class="form-group" style="margin-top:0.75rem;">
                <label class="form-label" style="font-size:0.85rem; font-weight:600;">Payment Webhook URL (Paystack / Flutterwave):</label>
                <div class="share-row">
                    <code class="share-link">@WebhookUrl</code>
                    <button class="btn-secondary-custom" @onclick="CopyWebhookUrl">Copy</button>
                </div>
                <p class="form-hint" style="font-size:0.8rem; color:var(--text-faint, #6b7280); margin-top:0.35rem;">
                    💡 Paste this URL into your Paystack / Flutterwave Webhook settings. When a customer pays, their phone/email is automatically enrolled!
                </p>
            </div>
        </div>

        <div class="detail-card">
            <h2>Attendee List & Access Control</h2>

            @if (!HasList)
            {
                <p class="info-text">
                    No attendees registered yet. Upload a roster, generate vouchers, or connect your payment webhook above.
                </p>

                <div class="btn-row" style="flex-wrap:wrap; gap:0.5rem;">
                    <button class="btn-primary-custom" @onclick="Upload">
                        Upload the list
                    </button>
                    <button class="btn-secondary-custom" @onclick="GenerateVouchersAsync" disabled="@IsGeneratingVouchers">
                        @(IsGeneratingVouchers ? "Generating..." : "🎟️ Generate 10 Vouchers")
                    </button>
                </div>
            }
            else
            {
                <p class="info-text">
                    @Students.Count registered @(CurrentPreset.AttendeeLabel.ToLowerInvariant())s, @ClaimedCount joined so far.
                </p>

                <div class="btn-row" style="flex-wrap:wrap; gap:0.5rem; margin-bottom:1rem;">
                    <button class="btn-primary-custom" @onclick="Upload">
                        Manage / Replace list
                    </button>
                    <button class="btn-secondary-custom" @onclick="GenerateVouchersAsync" disabled="@IsGeneratingVouchers">
                        @(IsGeneratingVouchers ? "Generating..." : "🎟️ Generate 10 Vouchers")
                    </button>
                    <a class="btn-secondary-custom" href="@($"/api/v1/spaces/{Target.Code}/attendance.csv")" target="_blank" download style="text-decoration:none; display:inline-flex; align-items:center;">
                        📥 Export Attendance CSV
                    </a>
                    <button class="btn-primary-custom" @onclick="StartSession" style="margin-left:auto;">
                        Start a session
                    </button>
                </div>

                <div class="student-list">
                    @foreach (var student in Students)
                    {
                        <div class="student-row">
                            <span class="student-id">@student.Identifier</span>
                            @if (string.Equals(student.DisplayName, student.Identifier, StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="student-name" style="color:var(--text-faint); font-style:italic;">(Awaiting name on join)</span>
                            }
                            else
                            {
                                <span class="student-name">@student.DisplayName</span>
                            }
                            <span class="student-state @(student.HasClaimed ? "claimed" : null)">
                                @(student.HasClaimed ? "joined" : "-")
                            </span>
                            @* Only offered once a seat is actually held. A student who
                               loses their phone or changes number is otherwise locked
                               out permanently, and the join screen tells them to ask
                               the lecturer to reset the list. *@
                            @if (student.HasClaimed)
                            {
                                <button class="btn-release"
                                        title="Free this seat so the student can join from another device"
                                        @onclick="() => ReleaseSeatAsync(student)">
                                    Release
                                </button>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

<style>
    .detail-wrap {
        max-width: 720px;
        margin: 0 auto;
        padding: 2rem 1rem 3rem;
    }

    .detail-back {
        display: inline-block;
        margin-bottom: 1rem;
        color: var(--text-mid);
        text-decoration: none;
        font-size: 0.875rem;
    }

    .detail-back:hover {
        color: var(--text);
    }

    .detail-head {
        margin-bottom: 1.5rem;
    }

    .detail-code {
        display: inline-block;
        font-size: 0.6875rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        color: var(--accent);
        background: var(--accent-dim);
        padding: 0.125rem 0.5rem;
        border-radius: var(--r-sm);
        margin-bottom: 0.5rem;
    }

    .detail-head h1 {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--text);
    }

    .detail-card {
        background: var(--surface);
        border: 1px solid var(--border-mid);
        border-radius: var(--r-lg);
        padding: 1.5rem;
        margin-bottom: 1.25rem;
    }

    .detail-card h2 {
        font-size: 1.0625rem;
        font-weight: 700;
        color: var(--text);
        margin-bottom: 0.5rem;
    }

    .share-row {
        display: flex;
        gap: 0.5rem;
        align-items: stretch;
        margin-top: 0.75rem;
    }

    .share-link {
        flex: 1;
        background: var(--bg);
        border: 1px solid var(--border-mid);
        border-radius: var(--r);
        padding: 0.625rem 0.75rem;
        font-size: 0.8125rem;
        color: var(--text);
        overflow-x: auto;
        white-space: nowrap;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    }

    .student-list {
        margin-top: 1.25rem;
        border: 1px solid var(--border-mid);
        border-radius: var(--r);
        max-height: 26rem;
        overflow-y: auto;
    }

    .student-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.5rem 0.75rem;
        border-bottom: 1px solid var(--border);
        font-size: 0.875rem;
    }

    .student-row:last-child {
        border-bottom: none;
    }

    .student-id {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        color: var(--text-mid);
        min-width: 9rem;
    }

    .student-name {
        flex: 1;
        color: var(--text);
    }

    .student-state {
        font-size: 0.6875rem;
        color: var(--text-faint);
    }

    .student-state.claimed {
        color: var(--success);
    }
</style>

@code {

    [Parameter] public int ClassId { get; set; }

    private sealed record StudentRow(int RosterEntryId, string Identifier, string DisplayName, bool HasClaimed);

    private Class? Target { get; set; }
    private List<StudentRow> Students { get; set; } = new();

    private bool IsLoading { get; set; } = true;
    private string? Notice { get; set; }
    private string NoticeKind { get; set; } = "alert-danger";

    private SpacePreset.PresetMeta CurrentPreset => SpacePreset.GetMeta(Target?.PresetType);

    private bool HasList => (Target?.RosterMappingJson is not null) || (Students.Count > 0);

    private int ClaimedCount => Students.Count(s => s.HasClaimed);

    private string ShareUrl =>
        $"{Navigation.BaseUri.TrimEnd('/')}/join/{Target?.Code}";

    private string WebhookUrl =>
        $"{Navigation.BaseUri.TrimEnd('/')}/api/v1/webhooks/payment/{Target?.Code}";

    private bool IsGeneratingVouchers { get; set; }

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        IsLoading = true;

        var user = await AuthService.GetCurrentUserAsync();

        if (user is null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        Target = await ClassService.GetByIdAsync(ClassId);

        Students = new List<StudentRow>();

        if (Target is not null)
        {
            if (Target.LecturerId != user.Id)
            {
                Target = null;
                Notice = "That space is not yours.";
                NoticeKind = "alert-danger";
            }
            else
            {
                var entries = await RosterService.GetForClassAsync(ClassId);
                Students = entries
                    .Select(e => new StudentRow(e.Id, e.Identifier, e.DisplayName, e.HasClaimed))
                    .ToList();
            }
        }

        IsLoading = false;
    }

    private async Task GenerateVouchersAsync()
    {
        if (IsGeneratingVouchers || Target is null) return;
        IsGeneratingVouchers = true;
        try
        {
            var prefix = Target.Code.Length > 4 ? Target.Code[..4] : Target.Code;
            var request = new AttendeeEndpoints.GenerateVouchersRequest(10, prefix, "Access Voucher");
            // Direct generation via context or endpoint
            var entries = await RosterService.GetForClassAsync(ClassId);
            var existingIds = new HashSet<string>(entries.Select(e => e.Identifier), StringComparer.OrdinalIgnoreCase);

            for (var i = 0; i < 10; i++)
            {
                string codeCandidate;
                do
                {
                    var randomDigits = System.Security.Cryptography.RandomNumberGenerator.GetInt32(100000, 999999);
                    codeCandidate = $"{prefix}-{randomDigits}";
                }
                while (existingIds.Contains(codeCandidate));

                existingIds.Add(codeCandidate);
                await RosterService.ImportAsync(ClassId, $"{codeCandidate},{codeCandidate}");
            }

            Notice = "10 single-use access vouchers generated successfully! Attendees can join with these codes.";
            NoticeKind = "alert-success";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Notice = $"Could not generate vouchers: {ex.Message}";
            NoticeKind = "alert-danger";
        }
        finally
        {
            IsGeneratingVouchers = false;
        }
    }

    private async Task CopyWebhookUrl()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", WebhookUrl);
            Notice = "Payment Webhook URL copied! Paste this into Paystack or Flutterwave.";
            NoticeKind = "alert-success";
        }
        catch
        {
            Notice = "Copying is not available here. Select the Webhook URL and copy it by hand.";
            NoticeKind = "alert-warning";
        }
    }

    /// <summary>
    /// Frees a seat, so a student locked out of their own place can get back in from
    /// another device. Reloads the list rather than patching the row, because the
    /// claimed count in the header has to agree with it.
    /// </summary>
    private async Task ReleaseSeatAsync(StudentRow student)
    {
        try
        {
            await RosterService.ReleaseSeatAsync(student.RosterEntryId);

            var entries = await RosterService.GetForClassAsync(ClassId);

            Students = entries
                .Select(e => new StudentRow(e.Id, e.Identifier, e.DisplayName, e.HasClaimed))
                .ToList();

            Notice = $"Released the seat for {student.DisplayName}.";
            NoticeKind = "alert-success";
        }
        catch (Exception ex)
        {
            Notice = $"Could not release that seat: {ex.Message}";
            NoticeKind = "alert-danger";
        }
    }

    private async Task CopyLink()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", ShareUrl);
            Notice = "Link copied.";
            NoticeKind = "alert-success";
        }
        catch (JSException)
        {
            Notice = "Copying is not available here. Select the link and copy it by hand.";
            NoticeKind = "alert-warning";
        }
    }

    private void Upload() => Navigation.NavigateTo($"/classes/{ClassId}/roster");

    private void StartSession() => Navigation.NavigateTo($"/create-session?classId={ClassId}");
}
