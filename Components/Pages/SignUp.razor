@page "/signup"
@using VIIDII.Components.Shared

<PageTitle>Create an account - VIIDII</PageTitle>

<AuthShell Title="Create your account"
           Subtitle="No approval needed. You are ready to run a class as soon as you finish."
           Error="@ErrorMessage">

    @* Server rendered on purpose: this posts to /auth/register, which creates
       the account and issues the cookie in one HTTP response. *@
    <form method="post" action="/auth/register">
        <AntiforgeryToken />

        <div class="auth-field">
            <label class="auth-label" for="name-input">Full name</label>
            <input id="name-input"
                   name="name"
                   type="text"
                   class="auth-input"
                   autocomplete="name"
                   required
                   autofocus
                   maxlength="100"
                   placeholder="e.g. Dr. Aisha Bello"
                   value="@Name" />
        </div>

        <div class="auth-field">
            <label class="auth-label" for="matric-input">Staff or matric number</label>
            <input id="matric-input"
                   name="matricNo"
                   type="text"
                   class="auth-input"
                   autocomplete="username"
                   autocapitalize="characters"
                   spellcheck="false"
                   required
                   maxlength="20"
                   placeholder="e.g. LEC/2019/041"
                   value="@MatricNo" />
            <p class="auth-hint">
                Used to sign in. Your students never need one.
            </p>
        </div>

        <div class="auth-field">
            <label class="auth-label" for="password-input">Password</label>
            <input id="password-input"
                   name="password"
                   type="password"
                   class="auth-input"
                   autocomplete="new-password"
                   required
                   minlength="8"
                   maxlength="256" />
            <p class="auth-hint">At least 8 characters.</p>
        </div>

        <button id="signup-submit" type="submit" class="auth-btn">Create account</button>
    </form>

    <div class="auth-divider">
        <span>or</span>
    </div>

    <a href="/auth/google" class="btn-google" id="google-signup-btn">
        <svg viewBox="0 0 24 24" width="18" height="18">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
        </svg>
        <span>Sign up with Google</span>
    </a>

    <p class="auth-alt">
        Already have an account? <a href="/login">Sign in</a>
    </p>
</AuthShell>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorCode { get; set; }

    [SupplyParameterFromQuery(Name = "name")]
    private string? Name { get; set; }

    [SupplyParameterFromQuery(Name = "matricNo")]
    private string? MatricNo { get; set; }

    private string? ErrorMessage => ErrorCode switch
    {
        "name" => "Enter your full name.",
        "matric" => "Enter a staff or matric number between 3 and 20 characters.",
        "password" => "Passwords need to be at least 8 characters.",
        "duplicate" => "That number is already registered. Try signing in instead.",
        "antiforgery" => "This page sat open too long. Please try again.",
        "google_unconfigured" => "Google Sign-In is not yet configured on this server.",
        "google_no_email" => "Could not retrieve your verified email from Google. Please try again.",
        "google_error" => "There was an error communicating with Google. Please try again.",
        _ => null
    };
}