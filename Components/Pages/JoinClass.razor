@page "/join/{code}"
@using VIIDII.Components.Shared
@using VIIDII.Models
@inject ClassService ClassService
@inject RosterService RosterService
@inject IHttpContextAccessor HttpContextAccessor
@inject StudentSeatService Seats

<PageTitle>@(Target?.Name ?? "Join class") - VIIDII</PageTitle>

@if (Target is null)
{
    <div class="auth-wrap">
        <div class="auth-card">
            <div class="auth-head">
                <div class="auth-eyebrow">Join</div>
                <h1 class="auth-title">That class link did not work</h1>
                <p class="auth-sub">Check the link your lecturer shared, or ask them to send it again.</p>
            </div>

            <a class="auth-back" href="/">Back to home</a>
        </div>
    </div>
}
else if (Waiting)
{
    <div class="auth-wrap">
        <div class="auth-card">
            <div class="auth-head">
                @if (IsRsvpGuest || MatchedRosterEntry is not null)
                {
                    <div class="rsvp-confirmed-pill">
                        <i class="fas fa-check-circle"></i> RSVP Confirmed
                    </div>
                }
                <div class="auth-eyebrow">@Target.Code</div>
                <h1 class="auth-title">Your seat is reserved</h1>
                <p class="auth-sub">
                    You are on the list for <strong>@Target.Name</strong>. The live session has not started yet.
                    When your @HostTitle.ToLowerInvariant() starts broadcasting, refresh to enter immediately.
                </p>
            </div>

            <div class="auth-seat">
                <span class="auth-seat-label">Confirmed Attendee</span>
                <span class="auth-seat-name">@SeatDisplayName</span>
                <span class="auth-seat-sub" style="font-size:0.75rem; color:var(--text-mid); font-family:monospace;">@SeatIdentifier</span>
            </div>

            <a class="auth-btn auth-btn-quiet" href="@JoinUrl">
                <i class="fas fa-sync-alt"></i> Refresh / Check for Live Session
            </a>

            <p class="auth-alt">
                Not you? <a href="@LeaveUrl">Start again</a>
            </p>
        </div>
    </div>
}
else
{
    <div class="auth-wrap">
        <div class="auth-card">
            <div class="auth-head">
                <div class="auth-eyebrow">@Target.Code</div>
                <h1 class="auth-title">@Target.Name</h1>
                <p class="auth-sub">@Prompt</p>
            </div>

            @if (IsRsvpGuest || MatchedRosterEntry is not null)
            {
                <div class="rsvp-confirmed-banner">
                    <div class="rsvp-banner-icon">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div class="rsvp-banner-text">
                        <div class="rsvp-banner-title">RSVP Confirmed &bull; Seat Reserved</div>
                        <div class="rsvp-banner-sub">
                            Welcome back, <strong>@(MatchedRosterEntry?.DisplayName ?? Name ?? Identifier)</strong>! Your place is secured for this session.
                        </div>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Error))
            {
                <div class="auth-notice" role="alert">
                    <i class="fas fa-exclamation-circle"></i>
                    <span>@Error</span>
                </div>

                @if (ErrorCode == "already-claimed")
                {
                    <form method="post" action="@ClaimUrl">
                        <AntiforgeryToken />
                        <input type="hidden" name="identifier" value="@Identifier" />
                        <input type="hidden" name="name" value="@Name" />
                        <input type="hidden" name="takeover" value="1" />
                        <button id="takeover-submit" type="submit" class="auth-btn" style="background: linear-gradient(135deg, #4f46e5, #06b6d4); display: flex; align-items: center; justify-content: center; gap: 0.5rem; margin-top: -0.25rem; margin-bottom: 1.25rem;">
                            <i class="fas fa-mobile-alt"></i> Transfer &amp; Join On This Device
                        </button>
                    </form>
                }
            }

            @* Server rendered: one request on a slow network, and the seat cookie is
               issued by the response that validates the details. An interactive form
               would need a second round trip and could not set the cookie. *@
            <form method="post" action="@ClaimUrl">
                <AntiforgeryToken />

                <div class="auth-field">
                    <label class="auth-label" for="identifier-input">@IdentifierLabel</label>
                    <input id="identifier-input"
                           name="identifier"
                           type="text"
                           class="auth-input"
                           autocomplete="off"
                           spellcheck="false"
                           required
                           autofocus
                           maxlength="64"
                           placeholder="@IdentifierPlaceholder"
                           value="@Identifier" />
                </div>

                <div class="auth-field">
                    <label class="auth-label" for="name-input">
                        @(RequiresSeparateName ? "Your name" : "Your name (optional)")
                    </label>
                    <input id="name-input"
                           name="name"
                           type="text"
                           class="auth-input"
                           autocomplete="name"
                           required="@(RequiresSeparateName ? "required" : null)"
                           maxlength="200"
                           placeholder="@(RequiresSeparateName ? "As it appears on the list" : "How you will appear in class (e.g. Aisha)")"
                           value="@Name" />
                </div>

                <button id="join-submit" type="submit" class="auth-btn">
                    @(IsRsvpGuest || MatchedRosterEntry is not null ? "Enter Session / Join" : "Join")
                </button>
            </form>

            <p class="auth-alt">
                <a href="@LeaveUrl">Not on the list, or is it someone else's name?</a>
            </p>

            <a class="auth-back" href="/">VIIDII</a>
        </div>
    </div>
}

<style>
    .auth-btn-quiet {
        display: block;
        text-align: center;
        background: var(--surface);
        color: var(--text);
        border: 1px solid var(--border-mid);
        text-decoration: none;
    }

    .auth-btn-quiet:hover {
        background: var(--surface-up);
        border-color: var(--border-strong);
        color: var(--text);
    }

    .auth-seat {
        background: var(--surface);
        border: 1px solid var(--border-mid);
        border-radius: var(--r);
        padding: 0.875rem 1rem;
        margin-bottom: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
    }

    .auth-seat-label {
        font-size: 0.6875rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-faint);
        margin-bottom: 0.25rem;
    }

    .auth-seat-name {
        font-size: 0.9375rem;
        color: var(--text);
        font-weight: 500;
    }

    .rsvp-confirmed-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #10b981;
        background: rgba(16, 185, 129, 0.12);
        border: 1px solid rgba(16, 185, 129, 0.25);
        padding: 0.25rem 0.75rem;
        border-radius: 999px;
        margin-bottom: 0.75rem;
    }

    .rsvp-confirmed-banner {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        background: rgba(16, 185, 129, 0.08);
        border: 1px solid rgba(16, 185, 129, 0.25);
        border-radius: var(--r);
        padding: 0.875rem 1rem;
        margin-bottom: 1.25rem;
        text-align: left;
    }

    .rsvp-banner-icon {
        color: #10b981;
        font-size: 1.25rem;
        margin-top: 0.1rem;
    }

    .rsvp-banner-title {
        font-size: 0.8125rem;
        font-weight: 700;
        color: #10b981;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .rsvp-banner-sub {
        font-size: 0.875rem;
        color: var(--text);
        margin-top: 0.2rem;
        line-height: 1.45;
    }
</style>

@code {
    [Parameter] public string Code { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "error")] private string? ErrorCode { get; set; }

    [SupplyParameterFromQuery(Name = "identifier")] private string? QueryIdentifier { get; set; }
    [SupplyParameterFromQuery(Name = "id")] private string? ShortId { get; set; }
    private string? Identifier => !string.IsNullOrWhiteSpace(QueryIdentifier) ? QueryIdentifier : ShortId;

    [SupplyParameterFromQuery(Name = "name")] private string? Name { get; set; }

    [SupplyParameterFromQuery(Name = "waiting")] private string? WaitingFlag { get; set; }

    [SupplyParameterFromQuery(Name = "leave")] private string? LeaveFlag { get; set; }
    [SupplyParameterFromQuery(Name = "rsvp")] private string? RsvpQuery { get; set; }

    private RosterEntry? MatchedRosterEntry { get; set; }
    private bool IsRsvpGuest => (MatchedRosterEntry?.Source == "rsvp") || (RsvpQuery == "1");

    private Class? Target { get; set; }
    private HttpContext? Http { get; set; }

    private StudentSeat? Seat { get; set; }

    private string JoinUrl => $"/join/{Code}";

    private string ClaimUrl => $"/join/claim/{Code}";

    private string LeaveUrl => $"/join/{Code}?leave=1";

    private bool Waiting => WaitingFlag == "1" && LeaveFlag != "1";

    /// <summary>
    /// Who is waiting. Read from the seat rather than the query string: the waiting
    /// redirect carries no details, deliberately, so a name never lands in a URL or in
    /// browser history. The seat cookie already holds both.
    /// </summary>
    private string SeatIdentifier => Seat?.MatricNo ?? Identifier;

    private string SeatDisplayName => Seat?.DisplayName ?? Name;

    private SpacePreset.PresetMeta Preset => SpacePreset.GetMeta(Target?.PresetType);
    private string HostTitle => Preset.HostLabel;
    private string AttendeeTitle => Preset.AttendeeLabel;

    private string? Error => ErrorCode switch
    {
        "not-found" => $"Those details were not on the list for {Target?.Name ?? "this space"}. Check them and try again.",
        "no-list" => $"Your {HostTitle.ToLowerInvariant()} has not added an attendee list yet. Try again once they have.",
        "already-claimed" => $"This place is currently registered to another device. If you switched devices or browser, click below to transfer it here.",
        _ => null
    };

    private string Prompt => Target is null
        ? string.Empty
        : string.IsNullOrWhiteSpace(Target.JoinPrompt)
            ? Preset.DefaultPrompt
            : Target.JoinPrompt;

    private (string? Identifier, string? Name) ReadRosterMapping()
    {
        if (Target?.RosterMappingJson is null) return (null, null);

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(Target.RosterMappingJson);
            string? id = null;
            string? name = null;

            if (doc.RootElement.TryGetProperty("identifierHeader", out var e1) || doc.RootElement.TryGetProperty("IdentifierHeader", out e1))
            {
                id = e1.GetString();
            }
            if (doc.RootElement.TryGetProperty("nameHeader", out var e2) || doc.RootElement.TryGetProperty("NameHeader", out e2))
            {
                name = e2.GetString();
            }

            return (id, name);
        }
        catch
        {
            return (null, null);
        }
    }

    private bool RequiresSeparateName
    {
        get
        {
            var (id, name) = ReadRosterMapping();
            if (string.IsNullOrWhiteSpace(id) || string.IsNullOrWhiteSpace(name))
            {
                return false;
            }
            return !string.Equals(id.Trim(), name.Trim(), StringComparison.OrdinalIgnoreCase);
        }
    }

    private string IdentifierLabel
    {
        get
        {
            var (id, _) = ReadRosterMapping();
            if (!string.IsNullOrWhiteSpace(id)) return id;
            return Preset.Key switch
            {
                SpacePreset.Professional => "Registration / Phone Number",
                SpacePreset.Corporate => "Shareholder ID / CSCS No.",
                SpacePreset.Masterclass => "Ticket Reference / Phone",
                _ => "Matric Number / Phone"
            };
        }
    }

    private string IdentifierPlaceholder
    {
        get
        {
            var label = IdentifierLabel;
            if (label.Contains("phone", StringComparison.OrdinalIgnoreCase) ||
                label.Contains("mobile", StringComparison.OrdinalIgnoreCase) ||
                label.Contains("whatsapp", StringComparison.OrdinalIgnoreCase) ||
                label.Contains("contact", StringComparison.OrdinalIgnoreCase) ||
                label.Contains("tel", StringComparison.OrdinalIgnoreCase))
            {
                return "e.g. 08012345678 or +234...";
            }
            if (label.Contains("email", StringComparison.OrdinalIgnoreCase) || label.Contains("mail", StringComparison.OrdinalIgnoreCase))
            {
                return "e.g. student@example.com";
            }
            if (label.Contains("matric", StringComparison.OrdinalIgnoreCase) || label.Contains("reg", StringComparison.OrdinalIgnoreCase))
            {
                return "e.g. CSC/2021/001";
            }
            return "As it appears on the list";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        Target = string.IsNullOrWhiteSpace(Code) ? null : await ClassService.GetByCodeAsync(Code);

        Seat = Seats.Read(Http);

        // Clearing the old seat so "Not you?" actually starts again.
        if (LeaveFlag == "1" && Http is not null)
        {
            Seats.Clear(Http);
            Seat = null;
        }

        if (Target is not null)
        {
            var lookupId = !string.IsNullOrWhiteSpace(Identifier) ? Identifier : Seat?.MatricNo;
            if (!string.IsNullOrWhiteSpace(lookupId))
            {
                var entries = await RosterService.GetForClassAsync(Target.Id);
                MatchedRosterEntry = entries.FirstOrDefault(r => RosterService.IdentifiersMatch(r.Identifier, lookupId));
                if (MatchedRosterEntry is not null)
                {
                    if (string.IsNullOrWhiteSpace(Name) && !string.IsNullOrWhiteSpace(MatchedRosterEntry.DisplayName))
                    {
                        Name = MatchedRosterEntry.DisplayName;
                    }
                }
            }
        }
    }

    protected override void OnInitialized()
    {
        Http = HttpContextAccessor.HttpContext;
    }

}
