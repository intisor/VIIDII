@page "/lecturer/home"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthService AuthService
@inject SessionService SessionService
@inject NavigationManager Navigation

<PageTitle>Lecturer — VIIDII</PageTitle>

@if (CurrentUser is null)
{
    <div class="alert alert-warning" style="margin:2rem auto;max-width:500px;">Please log in first.</div>
}
else if (CurrentUser.Role != Role.Lecturer)
{
    <div class="alert alert-warning" style="margin:2rem auto;max-width:500px;">Access denied — lecturer role required.</div>
}
else
{
    <div class="dashboard-container">

        <!-- Header -->
        <div class="dashboard-header">
            <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;">
                <div>
                    <h1>@CurrentUser.Name</h1>
                    <p class="subtitle">Ready to start a session?</p>
                    <span class="role-badge">Lecturer</span>
                </div>
                @if (ActiveSession is not null)
                {
                    <button id="go-active-session" class="btn-primary-custom" @onclick="() => GoSession(ActiveSession.SessionId)">
                        <i class="fas fa-circle" style="color:var(--live);font-size:0.5rem;"></i>
                        Resume Active Session
                    </button>
                }
            </div>
        </div>

        <!-- Actions -->
        <div class="section-card">
            <h2>Sessions</h2>
            <p class="info-text">Create a new class or open an existing one.</p>
            <div class="btn-row">
                <button id="create-session-btn" class="btn-primary-custom" @onclick="GoCreateSession">
                    <i class="fas fa-plus"></i> New Session
                </button>
                <button id="join-session-btn" class="btn-secondary-custom" @onclick="GoJoin">
                    <i class="fas fa-sign-in-alt"></i> Join Session
                </button>
            </div>
        </div>

        <!-- Recent sessions -->
        <div class="section-card">
            <h2>Recent Sessions</h2>
            @if (RecentSessions.Count == 0)
            {
                <p class="info-text">No sessions yet.</p>
            }
            else
            {
                <ul class="session-list">
                    @foreach (var session in RecentSessions)
                    {
                        <li class="session-item">
                            <div>
                                <div class="session-title">@session.Title</div>
                                <div class="session-meta">@session.SessionId &middot; @session.Status</div>
                            </div>
                            <button class="btn-secondary-custom" @onclick="() => GoSession(session.SessionId)">Open</button>
                        </li>
                    }
                </ul>
            }
        </div>

    </div>
}

@code {
    private User? CurrentUser;
    private Session? ActiveSession;
    private List<Session> RecentSessions = new();

    protected override async Task OnInitializedAsync()
    {
        CurrentUser = await AuthService.GetCurrentUserAsync();
        if (CurrentUser is null) { Navigation.NavigateTo("/login"); return; }
        if (CurrentUser.Role != Role.Lecturer) { Navigation.NavigateTo("/dashboard"); return; }

        RecentSessions = (await SessionService.GetSessionsByLecturerAsync(CurrentUser.MatricNo))
            .OrderByDescending(s => s.CreatedAt)
            .Take(8)
            .ToList();
        ActiveSession = RecentSessions.FirstOrDefault(s => s.Status is SessionStatus.Active or SessionStatus.Started);
    }

    private void GoCreateSession() => Navigation.NavigateTo("/create-session");
    private void GoJoin()          => Navigation.NavigateTo("/join-session");
    private void GoSession(string id) => Navigation.NavigateTo($"/session/{id}");
}
