@page "/admin"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthService AuthService
@inject SessionService SessionService
@inject NavigationManager Navigation
@using VIIDII.Models

<PageTitle>Admin Dashboard - VIIDII</PageTitle>

<style>
    .admin-container {
        max-width: 1400px;
        margin: 2rem auto;
        padding: 0 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.125rem;
    }

    .admin-header {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--r-lg);
        padding: 1.75rem;
    }

    .admin-header h1 {
        font-size: 1.625rem;
        font-weight: 700;
        margin-bottom: 0.375rem;
        color: var(--text);
    }
    
    .admin-header p {
        color: var(--text-mid);
        font-size: 0.875rem;
        margin: 0;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1.125rem;
    }

    .stat-card {
        background: var(--surface);
        border: 1px solid var(--border);
        padding: 1.375rem;
        border-radius: var(--r-lg);
    }

    .stat-number {
        font-size: 2rem;
        font-weight: 700;
        color: var(--accent);
        margin-top: 0.25rem;
    }

    .stat-label {
        color: var(--text-mid);
        font-size: 0.8125rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .admin-section {
        background: var(--surface);
        border: 1px solid var(--border);
        padding: 1.5rem;
        border-radius: var(--r-lg);
    }

    .admin-section h2 {
        color: var(--text);
        font-size: 0.9375rem;
        font-weight: 600;
        margin-top: 0;
        margin-bottom: 1.125rem;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

    .data-table th {
        background: var(--surface-up);
        padding: 0.75rem 1rem;
        text-align: left;
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--text-mid);
        border-bottom: 1px solid var(--border-mid);
    }

    .data-table td {
        padding: 0.875rem 1rem;
        border-bottom: 1px solid var(--border);
        font-size: 0.875rem;
        color: var(--text);
    }

    .data-table tr:hover td {
        background: rgba(255, 255, 255, 0.015);
    }

    .badge {
        display: inline-block;
        padding: 0.2rem 0.6rem;
        border-radius: 100px;
        font-size: 0.6875rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .badge-active {
        background: var(--success-dim);
        color: var(--success);
        border: 1px solid rgba(34, 197, 94, 0.2);
    }

    .badge-completed {
        background: var(--surface-up);
        color: var(--text-mid);
        border: 1px solid var(--border-mid);
    }

    .badge-cancelled {
        background: var(--danger-dim);
        color: var(--danger);
        border: 1px solid rgba(239, 68, 68, 0.2);
    }

    .badge-student {
        background: var(--accent-dim);
        color: var(--accent);
        border: 1px solid rgba(110, 86, 207, 0.2);
    }

    .badge-lecturer {
        background: var(--accent-dim);
        color: var(--accent);
        border: 1px solid rgba(110, 86, 207, 0.2);
    }

    .badge-admin {
        background: var(--surface-up);
        color: var(--text);
        border: 1px solid var(--border-strong);
    }

    .no-data {
        text-align: center;
        padding: 2rem;
        color: var(--text-faint);
        font-size: 0.875rem;
    }
</style>

@if (CurrentUser == null || CurrentUser.Role.ToString() != "Admin")
{
    <div class="alert alert-warning">Access denied. Admin privileges required.</div>
}
else
{
    <div class="admin-container">
        <div class="admin-header">
            <h1>Admin Dashboard</h1>
            <p>System overview and management</p>
        </div>

        @if (!string.IsNullOrEmpty(Message))
        {
            <div class="alert alert-info">@Message</div>
        }

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-label">Total Users</div>
                <div class="stat-number">@TotalUsers</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Active Sessions</div>
                <div class="stat-number">@ActiveSessions</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Total Sessions</div>
                <div class="stat-number">@TotalSessions</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Lecturers</div>
                <div class="stat-number">@TotalLecturers</div>
            </div>
        </div>

        <div class="admin-section">
            <h2>Recent Sessions</h2>
            @if (RecentSessions.Any())
            {
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Session ID</th>
                            <th>Title</th>
                            <th>Lecturer</th>
                            <th>Audience</th>
                            <th>Status</th>
                            <th>Participants</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var session in RecentSessions)
                        {
                            <tr>
                                <td>@session.SessionId</td>
                                <td>@session.Title</td>
                                <td>@session.LecturerId</td>
                                <td>
                                    <div>Dept: @FormatDepartments(session)</div>
                                    <div>Level: @FormatLevels(session)</div>
                                </td>
                                <td>
                                    <span class="badge badge-@session.Status.ToString().ToLower()">
                                        @session.Status
                                    </span>
                                </td>
                                <td>@session.ParticipantIds.Count</td>
                                <td>
                                    <button class="btn-primary-custom" @onclick="() => ViewSession(session.SessionId)">View</button>
                                    @if (session.Status == SessionStatus.Active || session.Status == SessionStatus.Started)
                                    {
                                        <button class="btn-secondary-custom" @onclick="() => EndSessionAdmin(session.SessionId)">End</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="no-data">No sessions found</div>
            }
        </div>

        <div class="admin-section">
            <h2>User Management</h2>
            @if (AllUsers.Any())
            {
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Matric No</th>
                            <th>Name</th>
                            <th>Role</th>
                            <th>Department</th>
                            <th>Level</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in AllUsers)
                        {
                            <tr>
                                <td>@user.MatricNo</td>
                                <td>@user.Name</td>
                                <td>
                                    <span class="badge badge-@user.Role.ToString().ToLower()">
                                        @user.Role
                                    </span>
                                </td>
                                <td>@(user.Department?.ToString() ?? "N/A")</td>
                                <td>@(user.Level?.ToString() ?? "N/A")</td>
                                <td>Active</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="no-data">No users found</div>
            }
        </div>
    </div>
}

@code {
    private User? CurrentUser;
    private string Message = "";
    
    private int TotalUsers;
    private int ActiveSessions;
    private int TotalSessions;
    private int TotalLecturers;
    
    private List<Session> RecentSessions = new();
    private List<User> AllUsers = new();

    protected override async Task OnInitializedAsync()
    {
        CurrentUser = await AuthService.GetCurrentUserAsync();
        
        if (CurrentUser == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (CurrentUser.Role.ToString() != "Admin")
        {
            Navigation.NavigateTo("/dashboard");
            return;
        }

        await LoadStatisticsAsync();
    }

    private async Task LoadStatisticsAsync()
    {
        // Get all users
        AllUsers = await AuthService.GetAllUsersAsync();
        TotalUsers = AllUsers.Count;
        TotalLecturers = AllUsers.Count(u => u.Role == Role.Lecturer);

        // Get all sessions
        var allSessions = SessionService.GetAllSessions();
        TotalSessions = allSessions.Count;
        ActiveSessions = allSessions.Count(s => s.Status == SessionStatus.Active || s.IsSessionStarted);
        
        // Get recent sessions (last 10)
        RecentSessions = allSessions
            .OrderByDescending(s => s.CreatedAt)
            .Take(10)
            .ToList();
    }

    private void ViewSession(string sessionId)
    {
        Navigation.NavigateTo($"/session/{sessionId}");
    }

    private void EndSessionAdmin(string sessionId)
    {
        try
        {
            var ended = SessionService.EndSession(sessionId);
            Message = ended is not null
                ? $"Session {sessionId} has been ended."
                : "Session not found.";
            _ = LoadStatisticsAsync(); // Refresh data
        }
        catch (Exception ex)
        {
            Message = $"Error ending session: {ex.Message}";
        }
    }

    private static string FormatDepartments(Session session)
    {
        return session.AllowedDepartments.Contains(User.Departments.Any)
            ? "All Departments"
            : string.Join(", ", session.AllowedDepartments);
    }

    private static string FormatLevels(Session session)
    {
        return session.AllowedLevels.Contains(User.Levels.Any)
            ? "All Levels"
            : string.Join(", ", session.AllowedLevels);
    }
}
