@page "/admin"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthService AuthService
@inject SessionService SessionService
@inject NavigationManager Navigation
@using VIIDII.Models

<PageTitle>Admin Dashboard - VIIDII</PageTitle>

@if (CurrentUser == null || CurrentUser.Role != Role.Admin)
{
    <div class="min-h-screen flex items-center justify-center bg-background">
        <div class="bg-destructive/10 text-destructive border border-destructive/20 p-4 rounded-lg flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
            <span>Access denied. Admin privileges required.</span>
        </div>
    </div>
}
else
{
    <div class="min-h-screen bg-background">
        <!-- Hero Section -->
        <section class="bg-gradient-to-br from-[#8338EC] to-[#C19BF5] text-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16 shadow-lg">
                <h1 class="text-3xl md:text-4xl font-bold mb-2">Admin Dashboard</h1>
                <p class="text-white/80">System-wide overview and monitoring</p>
                @if (!string.IsNullOrEmpty(Message))
                {
                    <div class="mt-4 bg-white/20 backdrop-blur-sm border border-white/30 text-white px-4 py-2 rounded-md flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
                        @Message
                    </div>
                }
            </div>
        </section>

        <!-- Main Content -->
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
            
            <!-- Stats Grid -->
            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                <!-- Total Users -->
                <div class="bg-card rounded-xl border border-border shadow-sm p-6 flex flex-col">
                    <div class="flex items-center justify-between mb-4">
                        <span class="text-muted-foreground font-medium text-sm">Total Users</span>
                        <div class="p-2 bg-purple-100 text-purple-600 rounded-lg">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        </div>
                    </div>
                    <div class="text-3xl font-bold text-foreground">@TotalUsers</div>
                    <div class="text-xs text-muted-foreground mt-1">Students & Lecturers</div>
                </div>

                <!-- Active Sessions -->
                <div class="bg-card rounded-xl border border-border shadow-sm p-6 flex flex-col">
                    <div class="flex items-center justify-between mb-4">
                        <span class="text-muted-foreground font-medium text-sm">Active Sessions</span>
                        <div class="p-2 bg-green-100 text-green-600 rounded-lg">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                        </div>
                    </div>
                    <div class="text-3xl font-bold text-foreground">@ActiveSessions</div>
                    <div class="text-xs text-green-600 font-medium mt-1">Currently live</div>
                </div>

                <!-- Total Sessions -->
                <div class="bg-card rounded-xl border border-border shadow-sm p-6 flex flex-col">
                    <div class="flex items-center justify-between mb-4">
                        <span class="text-muted-foreground font-medium text-sm">Total Sessions</span>
                        <div class="p-2 bg-blue-100 text-blue-600 rounded-lg">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
                        </div>
                    </div>
                    <div class="text-3xl font-bold text-foreground">@TotalSessions</div>
                    <div class="text-xs text-muted-foreground mt-1">Lifetime total</div>
                </div>
                 <!-- Total Lecturers -->
                <div class="bg-card rounded-xl border border-border shadow-sm p-6 flex flex-col">
                    <div class="flex items-center justify-between mb-4">
                        <span class="text-muted-foreground font-medium text-sm">Lecturers</span>
                        <div class="p-2 bg-orange-100 text-orange-600 rounded-lg">
                             <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                        </div>
                    </div>
                    <div class="text-3xl font-bold text-foreground">@TotalLecturers</div>
                     <div class="text-xs text-muted-foreground mt-1">Registered staff</div>
                </div>
            </div>

            <!-- Recent Sessions Section -->
            <div class="bg-card rounded-xl border border-border shadow-sm overflow-hidden mb-8">
                <div class="p-6 border-b border-border flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <h2 class="text-lg font-semibold text-foreground">Recent Sessions</h2>
                        <p class="text-sm text-muted-foreground">Monitor ongoing and past classes</p>
                    </div>
                </div>
                
                <div class="overflow-x-auto">
                    @if (RecentSessions.Any())
                    {
                        <table class="w-full text-sm">
                            <thead class="bg-muted/50">
                                <tr class="border-b border-border">
                                    <th class="px-6 py-3 text-left font-medium text-muted-foreground">Session Title</th>
                                    <th class="px-6 py-3 text-left font-medium text-muted-foreground">Lecturer</th>
                                    <th class="px-6 py-3 text-left font-medium text-muted-foreground">Audience</th>
                                    <th class="px-6 py-3 text-left font-medium text-muted-foreground">Status</th>
                                    <th class="px-6 py-3 text-left font-medium text-muted-foreground">Participants</th>
                                    <th class="px-6 py-3 text-right font-medium text-muted-foreground">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-border">
                                @foreach (var session in RecentSessions)
                                {
                                    <tr class="hover:bg-muted/30 transition-colors">
                                        <td class="px-6 py-4">
                                            <div class="font-medium text-foreground">@session.Title</div>
                                            <div class="text-xs text-muted-foreground font-mono">ID: @session.SessionId</div>
                                        </td>
                                        <td class="px-6 py-4 text-foreground">@session.LecturerId</td>
                                        <td class="px-6 py-4">
                                            <div class="text-xs text-muted-foreground">Dept: <span class="text-foreground">@FormatDepartments(session)</span></div>
                                            <div class="text-xs text-muted-foreground">Level: <span class="text-foreground">@FormatLevels(session)</span></div>
                                        </td>
                                        <td class="px-6 py-4">
                                            @if (session.Status == SessionStatus.Active)
                                            {
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 border border-green-200">
                                                    Active
                                                </span>
                                            }
                                            else if (session.Status == SessionStatus.Started)
                                            {
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 border border-blue-200">
                                                    Started
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800 border border-gray-200">
                                                    @session.Status
                                                </span>
                                            }
                                        </td>
                                        <td class="px-6 py-4 text-foreground">
                                           <div class="flex items-center gap-1">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                                @session.ParticipantIds.Count
                                           </div>
                                        </td>
                                        <td class="px-6 py-4 text-right">
                                            <div class="flex items-center justify-end gap-2">
                                                <button class="inline-flex items-center justify-center rounded-md text-xs font-medium border border-input bg-background hover:bg-accent hover:text-accent-foreground h-8 px-3 transition-colors" 
                                                        @onclick="() => ViewSession(session.SessionId)">
                                                    View
                                                </button>
                                                @if (session.Status == SessionStatus.Active || session.Status == SessionStatus.Started)
                                                {
                                                    <button class="inline-flex items-center justify-center rounded-md text-xs font-medium bg-destructive text-destructive-foreground hover:bg-destructive/90 h-8 px-3 transition-colors" 
                                                            @onclick="() => EndSessionAdmin(session.SessionId)">
                                                        End
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="p-12 text-center text-muted-foreground">
                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-4 text-muted-foreground/50"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
                            <p>No active sessions found</p>
                        </div>
                    }
                </div>
            </div>

            <!-- User Management Section -->
            <div class="bg-card rounded-xl border border-border shadow-sm overflow-hidden">
                 <div class="p-6 border-b border-border">
                    <h2 class="text-lg font-semibold text-foreground">User Management</h2>
                    <p class="text-sm text-muted-foreground">Registered users and roles</p>
                </div>
                <div class="overflow-x-auto">
                    @if (AllUsers.Any())
                    {
                        <table class="w-full text-sm">
                            <thead class="bg-muted/50">
                                <tr class="border-b border-border">
                                    <th class="px-6 py-3 text-left font-medium text-muted-foreground">Matric No</th>
                                    <th class="px-6 py-3 text-left font-medium text-muted-foreground">Name</th>
                                    <th class="px-6 py-3 text-left font-medium text-muted-foreground">Role</th>
                                    <th class="px-6 py-3 text-left font-medium text-muted-foreground">Department</th>
                                    <th class="px-6 py-3 text-left font-medium text-muted-foreground">Level</th>
                                    <th class="px-6 py-3 text-left font-medium text-muted-foreground">Status</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-border">
                                @foreach (var user in AllUsers)
                                {
                                    <tr class="hover:bg-muted/30 transition-colors">
                                        <td class="px-6 py-4 font-mono text-xs text-muted-foreground">@user.MatricNo</td>
                                        <td class="px-6 py-4 font-medium text-foreground">@user.Name</td>
                                        <td class="px-6 py-4">
                                            @if (user.Role == Role.Lecturer)
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-purple-100 text-purple-800 border border-purple-200">
                                                    Lecturer
                                                </span>
                                            }
                                            else if (user.Role == Role.Admin)
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800 border border-red-200">
                                                    Admin
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800 border border-blue-200">
                                                    Student
                                                </span>
                                            }
                                        </td>
                                        <td class="px-6 py-4 text-foreground">@(user.Department?.ToString() ?? "N/A")</td>
                                        <td class="px-6 py-4 text-foreground">@(user.Level?.ToString() ?? "N/A")</td>
                                        <td class="px-6 py-4">
                                             <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 border border-green-200">
                                                Active
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                     else
                    {
                        <div class="p-12 text-center text-muted-foreground">
                            <p>No users found</p>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
}

@code {
    private User? CurrentUser;
    private string Message = "";
    
    private int TotalUsers;
    private int ActiveSessions;
    private int TotalSessions;
    private int TotalLecturers;
    
    private List<Session> RecentSessions = new();
    private List<User> AllUsers = new();

    protected override async Task OnInitializedAsync()
    {
        CurrentUser = await AuthService.GetCurrentUserAsync();
        
        if (CurrentUser == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (CurrentUser.Role != Role.Admin)
        {
            Navigation.NavigateTo("/dashboard");
            return;
        }

        LoadStatistics();
    }

    private void LoadStatistics()
    {
        // Get all users
        AllUsers = AuthService.GetAllUsers();
        TotalUsers = AllUsers.Count;
        TotalLecturers = AllUsers.Count(u => u.Role == Role.Lecturer);

        // Get all sessions
        var allSessions = SessionService.GetAllSessions();
        TotalSessions = allSessions.Count;
        ActiveSessions = allSessions.Count(s => s.Status == SessionStatus.Active || s.IsSessionStarted);
        
        // Get recent sessions (last 10)
        RecentSessions = allSessions
            .OrderByDescending(s => s.CreatedAt)
            .Take(10)
            .ToList();
    }

    private void ViewSession(string sessionId)
    {
        Navigation.NavigateTo($"/session/{sessionId}");
    }

    private void EndSessionAdmin(string sessionId)
    {
        try
        {
            var ended = SessionService.EndSession(sessionId);
            Message = ended is not null
                ? $"Session {sessionId} has been ended."
                : "Session not found.";
            LoadStatistics(); // Refresh data
        }
        catch (Exception ex)
        {
            Message = $"Error ending session: {ex.Message}";
        }
    }

    private static string FormatDepartments(Session session)
    {
        return session.AllowedDepartments.Contains(User.Departments.Any)
            ? "All Departments"
            : string.Join(", ", session.AllowedDepartments);
    }

    private static string FormatLevels(Session session)
    {
        return session.AllowedLevels.Contains(User.Levels.Any)
            ? "All Levels"
            : string.Join(", ", session.AllowedLevels);
    }
}
