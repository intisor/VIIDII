@page "/student/home"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject SessionService SessionService

<PageTitle>Student — VIIDII</PageTitle>

@if (CurrentUser is null)
{
    <div class="alert alert-warning" style="margin:2rem auto;max-width:500px;">Please log in first.</div>
}
else if (CurrentUser.Role != Role.Student)
{
    <div class="alert alert-warning" style="margin:2rem auto;max-width:500px;">Access denied — student role required.</div>
}
else
{
    <div class="dashboard-container">

        <!-- Header -->
        <div class="dashboard-header">
            <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;">
                <div>
                    <h1>@CurrentUser.Name</h1>
                    <p class="subtitle">Ready to join a session?</p>
                    <span class="role-badge">Student</span>
                    @if (CurrentUser.Department is not null)
                    {
                        <span class="role-badge">@CurrentUser.Department</span>
                    }
                    @if (CurrentUser.Level is not null)
                    {
                        <span class="role-badge">@CurrentUser.Level</span>
                    }
                </div>
                @if (CurrentSession is not null)
                {
                    <button id="go-active-session" class="btn-primary-custom" @onclick="() => GoSession(CurrentSession.SessionId)">
                        <i class="fas fa-circle" style="color:var(--live);font-size:0.5rem;"></i>
                        Rejoin Active Session
                    </button>
                }
            </div>
        </div>

        <!-- Join -->
        <div class="section-card">
            <h2>Join a Session</h2>
            <p class="info-text">Enter a session code provided by your lecturer.</p>
            <div class="btn-row">
                <button id="join-session-btn" class="btn-primary-custom" @onclick="GoJoinSession">
                    <i class="fas fa-sign-in-alt"></i> Join Session
                </button>
            </div>
        </div>

    </div>
}

@code {
    private User? CurrentUser;
    private Session? CurrentSession;

    protected override async Task OnInitializedAsync()
    {
        CurrentUser = await AuthService.GetCurrentUserAsync();
        if (CurrentUser is null) { Navigation.NavigateTo("/login"); return; }
        if (CurrentUser.Role != Role.Student) { Navigation.NavigateTo("/dashboard"); return; }

        CurrentSession = await SessionService.GetSessionByParticipantAsync(CurrentUser.MatricNo);
    }

    private void GoJoinSession() => Navigation.NavigateTo("/join-session");
    private void GoSession(string id) => Navigation.NavigateTo($"/session/{id}");
}
