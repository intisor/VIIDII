@page "/create-session"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthService AuthService
@inject SessionService SessionService
@inject NavigationManager Navigation

<PageTitle>Create Session - VIIDII</PageTitle>

<style>
    .create-session-container { max-width: 800px; margin: 2rem auto; padding: 1rem; }
    .session-header { padding: 1rem 0; margin-bottom: 1rem; }
    .form-card { background: white; padding: 1rem; border-radius: 0.5rem; }
    .checkbox-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.5rem; margin-top: 0.5rem; }
</style>

    <div class="create-session-container">
        <div class="session-header">
            <h1>Create New Session</h1>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger">@ErrorMessage</div>
        }

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="alert alert-success">@SuccessMessage</div>
        }

        <div class="form-card">
            <EditForm Model="@SessionModel" OnValidSubmit="@HandleCreateSession" FormName="CreateSessionForm">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label class="form-label">Session Title</label>
                    <InputText class="form-control" @bind-value="SessionModel.Title" placeholder="e.g., Software Engineering Lecture - Week 5" />
                    <ValidationMessage For="@(() => SessionModel.Title)" />
                </div>

                <div class="form-group">
                    <label class="form-label">Allowed Departments</label>
                    <div class="form-check">
                        <InputCheckbox class="form-check-input" @bind-Value="SelectAllDepartments" id="selectAllDepts" @onchange="OnSelectAllDepartmentsChanged" />
                        <label class="form-check-label" for="selectAllDepts"><strong>Select All Departments</strong></label>
                    </div>
                    <div class="checkbox-grid">
                        @foreach (var dept in Enum.GetValues<User.Departments>())
                        {
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="@($"dept_{dept}")"
                                       checked="@IsDeptSelected(dept)"
                                       disabled="@SelectAllDepartments"
                                       @onchange="e => ToggleDept(dept, e)" />
                                <label class="form-check-label" for="@($"dept_{dept}")">@dept</label>
                            </div>
                        }
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Allowed Levels</label>
                    <div class="form-check">
                        <InputCheckbox class="form-check-input" @bind-Value="SelectAllLevels" id="selectAllLevels" @onchange="OnSelectAllLevelsChanged" />
                        <label class="form-check-label" for="selectAllLevels"><strong>Select All Levels</strong></label>
                    </div>
                    <div class="checkbox-grid">
                        @foreach (var level in Enum.GetValues<User.Levels>())
                        {
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="@($"level_{level}")"
                                       checked="@IsLevelSelected(level)"
                                       disabled="@SelectAllLevels"
                                       @onchange="e => ToggleLevel(level, e)" />
                                <label class="form-check-label" for="@($"level_{level}")">@level</label>
                            </div>
                        }
                    </div>
                </div>

                <button type="submit" class="btn btn-primary" disabled="@IsLoading">
                    @if (IsLoading) { <span>Creating...</span> } else { <span>Create Session</span> }
                </button>
                <button type="button" class="btn btn-secondary" @onclick="GoBack">Cancel</button>
            </EditForm>
        </div>
    </div>

@code {
    private CreateSessionRequest SessionModel = new();
    private string? ErrorMessage;
    private string? SuccessMessage;
    private bool IsLoading = false;
    private bool SelectAllDepartments = true;
    private bool SelectAllLevels = true;

    private bool IsDeptSelected(User.Departments dept) => SessionModel.AllowedDepartments.TryGetValue(dept, out var v) && v;
    private void ToggleDept(User.Departments dept, ChangeEventArgs e)
    {
        if (e?.Value is bool b)
            SessionModel.AllowedDepartments[dept] = b;
    }

    private bool IsLevelSelected(User.Levels level) => SessionModel.AllowedLevels.TryGetValue(level, out var v) && v;
    private void ToggleLevel(User.Levels level, ChangeEventArgs e)
    {
        if (e?.Value is bool b)
            SessionModel.AllowedLevels[level] = b;
    }

    private void OnSelectAllDepartmentsChanged(ChangeEventArgs e)
    {
        // ensure all dept entries follow SelectAllDepartments
        foreach (var key in SessionModel.AllowedDepartments.Keys.ToList())
            SessionModel.AllowedDepartments[key] = SelectAllDepartments;
    }

    private void OnSelectAllLevelsChanged(ChangeEventArgs e)
    {
        foreach (var key in SessionModel.AllowedLevels.Keys.ToList())
            SessionModel.AllowedLevels[key] = SelectAllLevels;
    }

    protected override async Task OnInitializedAsync()
    {
        var currentUser = await AuthService.GetCurrentUserAsync();
        
        // Check if user is authenticated
        if (currentUser == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        // Check if user is a lecturer
        if (currentUser.Role.ToString() != "Lecturer")
        {
            Navigation.NavigateTo("/dashboard");
            return;
        }

        // Initialize department and level dictionaries
        foreach (var dept in Enum.GetValues<User.Departments>())
        {
            SessionModel.AllowedDepartments[dept] = true;
        }
        foreach (var level in Enum.GetValues<User.Levels>())
        {
            SessionModel.AllowedLevels[level] = true;
        }
    }

    private async Task HandleCreateSession()
    {
        IsLoading = true;
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            var currentUser = await AuthService.GetCurrentUserAsync();
            if (currentUser == null)
            {
                ErrorMessage = "User session expired. Please log in again.";
                IsLoading = false;
                return;
            }

            var selectedDepts = SessionModel.AllowedDepartments
                .Where(x => x.Value)
                .Select(x => x.Key)
                .ToList();

            var selectedLevels = SessionModel.AllowedLevels
                .Where(x => x.Value)
                .Select(x => x.Key)
                .ToList();

            if (!selectedDepts.Any() || !selectedLevels.Any())
            {
                ErrorMessage = "Please select at least one department and one level.";
                IsLoading = false;
                return;
            }

            var session = SessionService.CreateSession(
                currentUser.MatricNo,
                SessionModel.Title,
                selectedDepts,
                selectedLevels
            );

            if (session != null)
            {
                SuccessMessage = $"Session created successfully! Redirecting...";
                await Task.Delay(1000);
                Navigation.NavigateTo($"/session/{session.SessionId}");
            }
            else
            {
                ErrorMessage = "Failed to create session. Please try again.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void GoBack() => Navigation.NavigateTo("/dashboard");

    public class CreateSessionRequest
    {
        public string Title { get; set; } = string.Empty;
        public Dictionary<User.Departments, bool> AllowedDepartments { get; set; } = new();
        public Dictionary<User.Levels, bool> AllowedLevels { get; set; } = new();
    }
}
