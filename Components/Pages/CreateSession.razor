@page "/create-session"
@attribute [Authorize(Policy = ViidiiPolicies.LecturerOnly)]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthService AuthService
@inject SessionService SessionService
@inject ClassService ClassService
@inject NavigationManager Navigation

<PageTitle>Create Session - VIIDII</PageTitle>

<style>
    .create-session-container {
        max-width: 760px;
        margin: 2rem auto;
        padding: 0 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.125rem;
    }
    
    .session-header {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--r-lg);
        padding: 1.75rem;
    }

    .session-header h1 {
        font-size: 1.625rem;
        font-weight: 700;
        margin: 0;
        color: var(--text);
    }

    .form-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--r-lg);
        padding: 1.75rem;
    }

    .checkbox-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 0.75rem;
        margin-top: 0.75rem;
        background: var(--surface-up);
        padding: 1rem;
        border: 1px solid var(--border-mid);
        border-radius: var(--r);
    }

    .form-check {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .form-check-input {
        accent-color: var(--accent);
        cursor: pointer;
        width: 14px;
        height: 14px;
    }

    .form-check-label {
        font-size: 0.875rem;
        color: var(--text-mid);
        cursor: pointer;
        user-select: none;
    }

    .form-check-input:checked + .form-check-label {
        color: var(--text);
    }
</style>

    <div class="create-session-container">
        <div class="session-header">
            <h1>Create New Session</h1>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger">@ErrorMessage</div>
        }

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="alert alert-success">@SuccessMessage</div>
        }

        <div class="form-card">
            <EditForm Model="@SessionModel" OnValidSubmit="@HandleCreateSession" FormName="CreateSessionForm">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label class="form-label" for="class-select">Class</label>
                    <InputSelect class="form-control" id="class-select" @bind-Value="SessionModel.ClassId">
                        <option value="0">Choose a class</option>
                        @foreach (var classOption in MyClasses)
                        {
                            <option value="@classOption.Id">
                                @classOption.Code - @classOption.Name@(classOption.HasList ? "" : " (no list yet)")
                            </option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => SessionModel.ClassId)" />
                    <p class="form-hint">
                        Students join from the class link, so a session has to belong to a class.
                        @if (MyClasses.Count == 0)
                        {
                            <span><a href="/classes">Create a class first</a>.</span>
                        }
                    </p>
                </div>

                <div class="form-group">
                    <label class="form-label">Session Title</label>
                    <InputText class="form-control" @bind-value="SessionModel.Title" placeholder="e.g., Software Engineering Lecture - Week 5" />
                    <ValidationMessage For="@(() => SessionModel.Title)" />
                </div>

                <div class="form-group">
                    <label class="form-label">Allowed Departments</label>
                    <div class="form-check" style="margin-bottom: 0.5rem;">
                        <InputCheckbox class="form-check-input" @bind-Value="SelectAllDepartments" id="selectAllDepts" @onchange="OnSelectAllDepartmentsChanged" />
                        <label class="form-check-label" for="selectAllDepts" style="font-weight:600; color:var(--text);">Select All Departments</label>
                    </div>
                    <div class="checkbox-grid">
                        @foreach (var dept in Enum.GetValues<User.Departments>())
                        {
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="@($"dept_{dept}")"
                                       checked="@IsDeptSelected(dept)"
                                       disabled="@SelectAllDepartments"
                                       @onchange="e => ToggleDept(dept, e)" />
                                <label class="form-check-label" for="@($"dept_{dept}")">@dept</label>
                            </div>
                        }
                    </div>
                </div>

                <div class="form-group" style="margin-bottom: 1.75rem;">
                    <label class="form-label">Allowed Levels</label>
                    <div class="form-check" style="margin-bottom: 0.5rem;">
                        <InputCheckbox class="form-check-input" @bind-Value="SelectAllLevels" id="selectAllLevels" @onchange="OnSelectAllLevelsChanged" />
                        <label class="form-check-label" for="selectAllLevels" style="font-weight:600; color:var(--text);">Select All Levels</label>
                    </div>
                    <div class="checkbox-grid">
                        @foreach (var level in Enum.GetValues<User.Levels>())
                        {
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="@($"level_{level}")"
                                       checked="@IsLevelSelected(level)"
                                       disabled="@SelectAllLevels"
                                       @onchange="e => ToggleLevel(level, e)" />
                                <label class="form-check-label" for="@($"level_{level}")">@level</label>
                            </div>
                        }
                    </div>
                </div>

                <div style="display:flex; gap:0.625rem;">
                    <button type="submit" class="btn-primary-custom" disabled="@IsLoading">
                        @if (IsLoading) { <span>Creating...</span> } else { <span>Create Session</span> }
                    </button>
                    <button type="button" class="btn-secondary-custom" @onclick="GoBack">Cancel</button>
                </div>
            </EditForm>
        </div>
    </div>

@code {
    private CreateSessionRequest SessionModel = new();
    private string? ErrorMessage;
    private string? SuccessMessage;
    private bool IsLoading = false;
    private bool SelectAllDepartments = true;
    private bool SelectAllLevels = true;

    private bool IsDeptSelected(User.Departments dept) => SessionModel.AllowedDepartments.TryGetValue(dept, out var v) && v;
    private void ToggleDept(User.Departments dept, ChangeEventArgs e)
    {
        if (e?.Value is bool b)
            SessionModel.AllowedDepartments[dept] = b;
    }

    private bool IsLevelSelected(User.Levels level) => SessionModel.AllowedLevels.TryGetValue(level, out var v) && v;
    private void ToggleLevel(User.Levels level, ChangeEventArgs e)
    {
        if (e?.Value is bool b)
            SessionModel.AllowedLevels[level] = b;
    }

    private void OnSelectAllDepartmentsChanged(ChangeEventArgs e)
    {
        // ensure all dept entries follow SelectAllDepartments
        foreach (var key in SessionModel.AllowedDepartments.Keys.ToList())
            SessionModel.AllowedDepartments[key] = SelectAllDepartments;
    }

    private void OnSelectAllLevelsChanged(ChangeEventArgs e)
    {
        foreach (var key in SessionModel.AllowedLevels.Keys.ToList())
            SessionModel.AllowedLevels[key] = SelectAllLevels;
    }

    protected override async Task OnInitializedAsync()
    {
        var currentUser = await AuthService.GetCurrentUserAsync();

        // Check if user is authenticated
        if (currentUser == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        // Check if user is a lecturer
        if (currentUser.Role.ToString() != "Lecturer")
        {
            Navigation.NavigateTo("/lecturer/home");
            return;
        }

        // A session has to belong to one of this lecturer's classes, otherwise no
        // student could ever be routed to it from the join link.
        var owned = await ClassService.GetForLecturerAsync(currentUser.Id);

        MyClasses = owned
            .Select(c => new ClassOption(c.Id, c.Code, c.Name, c.RosterMappingJson is not null))
            .ToList();

        // One class means there is nothing to choose, so pick it and skip the question.
        if (MyClasses.Count == 1)
        {
            SessionModel.ClassId = MyClasses[0].Id;
        }

        // Initialize department and level dictionaries
        foreach (var dept in Enum.GetValues<User.Departments>())
        {
            SessionModel.AllowedDepartments[dept] = true;
        }
        foreach (var level in Enum.GetValues<User.Levels>())
        {
            SessionModel.AllowedLevels[level] = true;
        }
    }

    private async Task HandleCreateSession()
    {
        IsLoading = true;
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            var currentUser = await AuthService.GetCurrentUserAsync();
            if (currentUser == null)
            {
                ErrorMessage = "User session expired. Please log in again.";
                IsLoading = false;
                return;
            }

            if (SessionModel.ClassId <= 0)
            {
                ErrorMessage = "Choose the class this session is for.";
                IsLoading = false;
                return;
            }

            var selectedDepts = SessionModel.AllowedDepartments
                .Where(x => x.Value)
                .Select(x => x.Key)
                .ToList();

            var selectedLevels = SessionModel.AllowedLevels
                .Where(x => x.Value)
                .Select(x => x.Key)
                .ToList();

            if (!selectedDepts.Any() || !selectedLevels.Any())
            {
                ErrorMessage = "Please select at least one department and one level.";
                IsLoading = false;
                return;
            }

            var session = await SessionService.CreateSession(
                currentUser.MatricNo,
                SessionModel.Title,
                selectedDepts,
                selectedLevels,
                SessionModel.ClassId
            );

            if (session != null)
            {
                SuccessMessage = "Session created. Share your class link with your students.";
                await Task.Delay(1000);
                Navigation.NavigateTo($"/session/{session.SessionId}");
            }
            else
            {
                ErrorMessage = "Failed to create session. Please try again.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void GoBack() => Navigation.NavigateTo("/lecturer/home");

    private sealed record ClassOption(int Id, string Code, string Name, bool HasList);

    private List<ClassOption> MyClasses { get; set; } = new();

    public class CreateSessionRequest
    {
        public int ClassId { get; set; }
        public string Title { get; set; } = string.Empty;
        public Dictionary<User.Departments, bool> AllowedDepartments { get; set; } = new();
        public Dictionary<User.Levels, bool> AllowedLevels { get; set; } = new();
    }
}
