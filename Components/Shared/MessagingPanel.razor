@using VIIDII.Services
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Forms
@inject IJSRuntime JSRuntime
@inject ISessionJsInterop SessionJsInterop

<div class="flex flex-col h-full bg-white">
    <!-- Header -->
    <div class="p-4 border-b border-border flex items-center justify-between flex-shrink-0">
        <h2 class="font-medium flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
            Discussion
        </h2>
    </div>

    <!-- Messages List -->
    <div class="flex-1 overflow-y-auto p-4 space-y-6 messages-wrapper scrollbar-thin scrollbar-thumb-gray-300 scrollbar-track-transparent">
        @if (!Messages.Any())
        {
            <div class="flex flex-col items-center justify-center h-full text-muted-foreground">
                <div class="w-12 h-12 rounded-full bg-secondary flex items-center justify-center mb-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
                </div>
                <p>No messages yet</p>
                @if (IsLecturer)
                {
                    <p class="text-sm mt-1">Start the conversation below</p>
                }
            </div>
        }
        else
        {
            @foreach (var message in GetPostMessages())
            {
                <div class="group">
                    <!-- Post -->
                     <div class="flex gap-3">
                         <div class="flex-shrink-0 w-8 h-8 rounded-full bg-gradient-to-br from-[#8338EC] to-[#C19BF5] text-white flex items-center justify-center text-xs font-bold">
                             @GetInitials(message.UserName)
                         </div>
                         <div class="flex-1 min-w-0">
                             <div class="flex items-center gap-2 mb-1">
                                 <span class="font-semibold text-sm">@message.UserName</span>
                                 <span class="px-1.5 py-0.5 rounded-full bg-primary/10 text-primary text-[10px] font-medium uppercase">Lecturer</span>
                                 <span class="text-xs text-muted-foreground ml-auto">@FormatTimestamp(message.createdAt)</span>
                             </div>
                             
                             <div class="bg-secondary/30 rounded-lg p-3 text-sm text-foreground/90">
                                 @if (message.messageType == MessageType.File)
                                 {
                                     <div class="flex items-center gap-2 p-2 bg-background border border-border rounded">
                                         <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                                         <span class="flex-1 truncate font-medium">@message.content.Replace("File: ", "")</span>
                                         @if (!IsLecturer)
                                         {
                                             <button class="p-1 hover:bg-secondary rounded" data-file-id="@message.id">
                                                 <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                                             </button>
                                         }
                                     </div>
                                 }
                                 else
                                 {
                                     <p class="whitespace-pre-wrap">@message.content</p>
                                 }
                             </div>

                             <!-- Actions -->
                             <div class="flex items-center gap-3 mt-1 ml-1">
                                 <button class="flex items-center gap-1.5 text-xs text-muted-foreground hover:text-primary transition-colors @(message.HasUserReacted(CurrentUserId) ? "text-primary font-medium" : "")"
                                        @onclick="() => ToggleReaction(message.id)">
                                     <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 10v12"/><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2h0a3.13 3.13 0 0 1 3 3.88Z"/></svg>
                                     @if (message.ThumbsUpCount > 0) { <span>@message.ThumbsUpCount</span> }
                                 </button>
                                 
                                 @if (!IsLecturer)
                                {
                                    <button class="flex items-center gap-1.5 text-xs text-muted-foreground hover:text-primary transition-colors" @onclick="() => StartReply(message.id)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 17 4 12 9 7"/><path d="M20 18v-2a4 4 0 0 0-4-4H4"/></svg>
                                        Reply
                                    </button>
                                }
                             </div>
                         </div>
                     </div>

                    <!-- Replies (Comments) -->
                    @if (GetComments(message.id).Any())
                    {
                        <div class="ml-11 mt-3 space-y-3 border-l-2 border-border pl-4">
                             @foreach (var comment in GetComments(message.id))
                            {
                                <div class="flex gap-2.5">
                                    <div class="flex-shrink-0 w-6 h-6 rounded-full bg-secondary text-secondary-foreground flex items-center justify-center text-[10px] font-bold">
                                        @GetInitials(comment.UserName)
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-baseline gap-2">
                                            <span class="font-medium text-xs">@comment.UserName</span>
                                            <span class="text-[10px] text-muted-foreground">@FormatTimestamp(comment.createdAt)</span>
                                        </div>
                                        <p class="text-sm mt-0.5 text-foreground/80">@comment.content</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>

    <!-- Input Section -->
    @if (IsLecturer)
    {
        <div class="p-4 border-t border-border bg-white flex-shrink-0">
            <div class="flex items-end gap-2">
                <InputFile id="fileInput" class="hidden" @ref="_fileInput" OnChange="HandleFileSelected" accept="*/*" />
                <button class="p-2.5 text-muted-foreground hover:bg-secondary rounded-lg transition-colors" @onclick="TriggerFileInput" disabled="@IsUploadingFile" title="Attach file">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
                </button>
                
                <input type="text" 
                       class="flex-1 min-h-[44px] max-h-32 p-2.5 bg-secondary/50 rounded-lg text-sm border-0 focus:ring-2 focus:ring-primary focus:bg-background transition-all placeholder:text-muted-foreground" 
                       placeholder="Type a message..." 
                       @bind="NewMessageContent"
                       @onkeypress="HandleKeyPress"
                       disabled="@IsUploadingFile" />
                       
                <button class="p-2.5 bg-primary text-primary-foreground hover:bg-primary/90 rounded-lg transition-colors disabled:opacity-50 disabled:pointer-events-none" 
                        @onclick="SendMessage" 
                        disabled="@(string.IsNullOrWhiteSpace(NewMessageContent) || IsUploadingFile)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" x2="11" y1="2" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                </button>
            </div>

            @if (IsUploadingFile)
            {
                <div class="mt-2 text-xs text-muted-foreground">
                    <div class="flex justify-between mb-1">
                        <span>Sending @SelectedFileName...</span>
                        <span>@UploadProgress.ToString("F0")%</span>
                    </div>
                    <div class="h-1 bg-secondary rounded-full overflow-hidden">
                        <div class="h-full bg-primary transition-all duration-300" style="width: @(UploadProgress)%"></div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Reply Dialog (Students) -->
    @if (!IsLecturer && !string.IsNullOrEmpty(ReplyingToMessageId))
    {
        <div class="p-4 border-t border-border bg-muted/30 flex-shrink-0">
            <div class="flex items-center justify-between mb-2 text-xs text-muted-foreground">
                <span>Replying to lecturer</span>
                <button @onclick="CancelReply" class="hover:text-foreground">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" x2="6" y1="6" y2="18"/><line x1="6" x2="18" y1="6" y2="18"/></svg>
                </button>
            </div>
            <div class="flex items-end gap-2">
                 <input type="text" 
                       class="flex-1 p-2.5 bg-white rounded-lg text-sm border border-input focus:ring-2 focus:ring-primary focus:border-primary placeholder:text-muted-foreground" 
                       placeholder="Type your reply..." 
                       @bind="ReplyContent"
                       @onkeypress="HandleReplyKeyPress" />
                <button class="p-2.5 bg-primary text-primary-foreground hover:bg-primary/90 rounded-lg transition-colors disabled:opacity-50" @onclick="SendReply" disabled="@string.IsNullOrWhiteSpace(ReplyContent)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" x2="11" y1="2" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string SessionId { get; set; } = string.Empty;
    [Parameter] public bool IsLecturer { get; set; }
    [Parameter] public HubConnection? HubConnection { get; set; }
    [Parameter] public string CurrentUserId { get; set; } = string.Empty;

    private List<Message> Messages = new();
    private string NewMessageContent = "";
    private string ReplyContent = "";
    private string? ReplyingToMessageId = null;
    private InputFile? _fileInput;
    private IBrowserFile? SelectedFile;
    private string SelectedFileName = "";
    private bool IsUploadingFile = false;
    private double UploadProgress = 0;

    protected override async Task OnInitializedAsync()
    {
        if (HubConnection == null) return;

        // Register SignalR handlers
        HubConnection.On<Message>("ReceivePost", HandleReceivePost);
        HubConnection.On<Message>("ReceiveComment", HandleReceiveComment);
        HubConnection.On<List<Message>>("ReceiveMessages", HandleReceiveMessages);
        HubConnection.On<string, string, string, bool>("ReceiveReaction", HandleReceiveReaction);
        HubConnection.On<string>("PostCreated", HandlePostCreated);

        // Load existing messages
        try
        {
            await HubConnection.SendAsync("GetMessages", SessionId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading messages: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ScrollToBottom();
        }
    }

    // SignalR Handlers
    private async Task HandleReceivePost(Message message)
    {
        if (message.sessionId != SessionId) return;

        Messages.Add(message);
        StateHasChanged();
        await ScrollToBottom();
    }

    private async Task HandleReceiveComment(Message comment)
    {
        if (comment.sessionId != SessionId) return;

        Messages.Add(comment);
        StateHasChanged();
        await ScrollToBottom();
    }

    private void HandleReceiveMessages(List<Message> messages)
    {
        Messages = messages.Where(m => m.sessionId == SessionId).ToList();
        StateHasChanged();
    }

    private void HandleReceiveReaction(string messageId, string userId, string emoji, bool isAdd)
    {
        var message = Messages.FirstOrDefault(m => m.id == messageId);
        if (message == null) return;

        if (isAdd)
        {
            if (!message.Reactions.Any(r => r.UserId == userId && r.Emoji == emoji))
            {
                message.Reactions.Add(new Reaction
                {
                    UserId = userId,
                    Emoji = emoji,
                    Timestamp = DateTime.UtcNow
                });
            }
        }
        else
        {
            var reaction = message.Reactions.FirstOrDefault(r => r.UserId == userId && r.Emoji == emoji);
            if (reaction != null)
            {
                message.Reactions.Remove(reaction);
            }
        }

        StateHasChanged();
    }

    private void HandlePostCreated(string postId)
    {
        // Clear input after successful post
        NewMessageContent = "";
        StateHasChanged();
    }

    // Message Sending
    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(NewMessageContent) || HubConnection == null || !IsLecturer)
            return;

        try
        {
            await HubConnection.SendAsync("CreatePost", SessionId, NewMessageContent, false);
            // Input cleared in PostCreated handler
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error sending message: {ex.Message}");
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(NewMessageContent))
        {
            await SendMessage();
        }
    }

    // Reply System
    private void StartReply(string messageId)
    {
        ReplyingToMessageId = messageId;
        ReplyContent = "";
    }

    private void CancelReply()
    {
        ReplyingToMessageId = null;
        ReplyContent = "";
    }

    private async Task SendReply()
    {
        if (string.IsNullOrWhiteSpace(ReplyContent) || HubConnection == null || IsLecturer || string.IsNullOrEmpty(ReplyingToMessageId))
            return;

        try
        {
            await HubConnection.SendAsync("CreateComment", SessionId, ReplyingToMessageId, ReplyContent);
            CancelReply();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error sending reply: {ex.Message}");
        }
    }

    private async Task HandleReplyKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(ReplyContent))
        {
            await SendReply();
        }
    }

    // Reactions
    private async Task ToggleReaction(string messageId)
    {
        if (HubConnection == null) return;

        var message = Messages.FirstOrDefault(m => m.id == messageId);
        if (message == null) return;

        try
        {
            if (message.HasUserReacted(CurrentUserId))
            {
                await HubConnection.SendAsync("RemoveReaction", SessionId, messageId, "??");
            }
            else
            {
                await HubConnection.SendAsync("AddReaction", SessionId, messageId, "??");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error toggling reaction: {ex.Message}");
        }
    }

    // File Handling
    private async Task TriggerFileInput()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('fileInput').click()");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error triggering file input: {ex.Message}");
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        SelectedFile = e.File;
        SelectedFileName = e.File.Name;

        if (SelectedFile.Size > 50 * 1024 * 1024)
        {
            Console.WriteLine("File too large (max 50MB)");
            // TODO: Show error to user
            return;
        }

        IsUploadingFile = true;
        UploadProgress = 0;
        string? messageId = null;

        try
        {
            // Create file message first
            await HubConnection!.SendAsync("CreatePost", SessionId, $"File: {SelectedFileName}", true);
            
            // Wait a moment for message to be created and get its ID
            await Task.Delay(200);
            
            // Get the latest file message ID (the one we just created)
            var latestFileMessage = Messages.LastOrDefault(m => m.messageType == MessageType.File);
            messageId = latestFileMessage?.id;

            if (string.IsNullOrEmpty(messageId))
            {
                Console.WriteLine("Failed to get message ID for file");
                return;
            }

            // Convert IBrowserFile to a format JS can use
            // We'll pass the file via a stream reference
            using var stream = SelectedFile.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
            var dotNetStreamRef = new DotNetStreamReference(stream);

            // Send file via P2P
            var result = await SessionJsInterop.SendFileToStudentsAsync(dotNetStreamRef, messageId);

            Console.WriteLine($"File transfer initiated: {SelectedFileName}");
            UploadProgress = 100;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error uploading file: {ex.Message}");
            // TODO: Show error to user
        }
        finally
        {
            IsUploadingFile = false;
            SelectedFile = null;
            SelectedFileName = "";
            StateHasChanged();
        }
    }

    // Helper Methods
    private List<Message> GetPostMessages() => Messages.Where(m => m.parentId == m.id).OrderBy(m => m.createdAt).ToList();

    private List<Message> GetComments(string postId) => Messages.Where(m => m.parentId == postId && m.id != postId).OrderBy(m => m.createdAt).ToList();

    private string GetInitials(string name)
    {
        if (string.IsNullOrEmpty(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpper();
    }

    private string FormatTimestamp(DateTime timestamp)
    {
        var now = DateTime.UtcNow.AddHours(1);
        var diff = now - timestamp;

        if (diff.TotalMinutes < 1) return "Just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        return timestamp.ToString("MMM d, h:mm tt");
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                const container = document.querySelector('.messages-container');
                if (container) {
                    container.scrollTop = container.scrollHeight;
                }
            ");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error scrolling: {ex.Message}");
        }
    }
}
