@using VIIDII.Services
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Forms
@inject IJSRuntime JSRuntime

<div class="messaging-panel">
    <!-- Tab Filter Bar -->
    <div class="messaging-filters">
        <button class="filter-tab @(ActiveTab == "all" ? "active" : "")" @onclick='() => SetFilter("all")'>
            <span>All</span>
            <span class="count-pill">@Messages.Count(m => m.parentId == m.id)</span>
        </button>
        <button class="filter-tab @(ActiveTab == "questions" ? "active" : "")" @onclick='() => SetFilter("questions")'>
            <span>Questions</span>
            @{
                var qCount = Messages.Count(m => m.parentId == m.id && m.isQuestion);
                var unansCount = Messages.Count(m => m.parentId == m.id && m.isQuestion && !m.isAnswered);
            }
            <span class="count-pill @(unansCount > 0 ? "highlight" : "")">@qCount</span>
        </button>
        <button class="filter-tab @(ActiveTab == "files" ? "active" : "")" @onclick='() => SetFilter("files")'>
            <span>Files</span>
            <span class="count-pill">@Messages.Count(m => m.parentId == m.id && (m.messageType == MessageType.File || !string.IsNullOrEmpty(m.fileUrl)))</span>
        </button>
    </div>

    <!-- Messages List -->
    <div class="messages-container" @ref="_messagesContainer">
        @{
            var filteredPosts = GetFilteredPosts();
        }

        @if (!filteredPosts.Any())
        {
            <div class="empty-state">
                <i class="@GetEmptyStateIcon()"></i>
                <p>@GetEmptyStateTitle()</p>
                <p class="hint">@GetEmptyStateHint()</p>
            </div>
        }
        else
        {
            @foreach (var message in filteredPosts)
            {
                <div class="message-card @(message.isLecturerPost ? "lecturer-post" : "") @(message.isQuestion ? "question-post" : "")">
                    <!-- Message Header -->
                    <div class="message-header">
                        <div class="user-info">
                            <div class="user-avatar @(message.isLecturerPost ? "lecturer-avatar" : "")">
                                @GetInitials(message.UserName)
                            </div>
                            <div class="user-meta">
                                <div class="name-line">
                                    <span class="user-name">@message.UserName</span>
                                    @if (message.isLecturerPost)
                                    {
                                        <span class="lecturer-badge">Lecturer</span>
                                    }
                                    @if (message.isQuestion)
                                    {
                                        <span class="question-badge">
                                            <i class="fas fa-question-circle"></i> Question
                                        </span>
                                    }
                                </div>
                                <span class="timestamp">@FormatTimestamp(message.createdAt)</span>
                            </div>
                        </div>

                        <!-- Question Status Badge / Action -->
                        @if (message.isQuestion)
                        {
                            <div class="question-status-container">
                                @if (message.isAnswered)
                                {
                                    <span class="status-answered">
                                        <i class="fas fa-check-circle"></i> Answered
                                    </span>
                                }
                                else
                                {
                                    <span class="status-pending">
                                        <i class="fas fa-clock"></i> Open
                                    </span>
                                }

                                @if (IsLecturer || message.userId == CurrentUserId)
                                {
                                    <button class="btn-toggle-answered" 
                                            title="@(message.isAnswered ? "Reopen question" : "Mark as answered")"
                                            @onclick="() => ToggleQuestionAnswered(message.id, !message.isAnswered)">
                                        @(message.isAnswered ? "Reopen" : "Mark Answered")
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <!-- Message Content -->
                    <div class="message-content">
                        @if (!string.IsNullOrWhiteSpace(message.content))
                        {
                            <p class="message-text">@message.content</p>
                        }

                        <!-- File Attachment Card -->
                        @if (!string.IsNullOrEmpty(message.fileUrl) || message.messageType == MessageType.File)
                        {
                            var fName = !string.IsNullOrEmpty(message.fileName) ? message.fileName : message.content.Replace("File: ", "");
                            var fUrl = !string.IsNullOrEmpty(message.fileUrl) ? message.fileUrl : $"/uploads/sessions/{SessionId}/{fName}";
                            
                            <div class="file-attachment">
                                <div class="file-icon-box">
                                    <i class="@GetFileIcon(fName)"></i>
                                </div>
                                <div class="file-details">
                                    <span class="file-name" title="@fName">@fName</span>
                                    @if (!string.IsNullOrEmpty(message.fileSizeFormatted))
                                    {
                                        <span class="file-size">@message.fileSizeFormatted</span>
                                    }
                                </div>
                                <a href="@fUrl" data-file-id="@message.id" data-file-name="@fName" class="btn-download" onclick="window.downloadP2PFile && window.downloadP2PFile(event, '@message.id', '@fName')">
                                    <i class="fas fa-download"></i>
                                    <span class="download-text">Download</span>
                                </a>
                            </div>
                        }
                    </div>

                    <!-- Message Actions / Footer -->
                    <div class="message-footer">
                        <button class="btn-reaction @(message.HasUserReacted(CurrentUserId) ? "reacted" : "")"
                                @onclick="() => ToggleReaction(message.id)">
                            <i class="fas fa-thumbs-up"></i>
                            @if (message.ThumbsUpCount > 0)
                            {
                                <span>@message.ThumbsUpCount</span>
                            }
                        </button>

                        <button class="btn-reply" @onclick="() => StartReply(message.id, message.UserName)">
                            <i class="fas fa-reply"></i>
                            <span>Reply</span>
                            @{
                                var commentCount = GetComments(message.id).Count;
                                if (commentCount > 0)
                                {
                                    <span class="reply-count">(@commentCount)</span>
                                }
                            }
                        </button>
                    </div>

                    <!-- Threaded Replies -->
                    @{
                        var comments = GetComments(message.id);
                    }
                    @if (comments.Any())
                    {
                        <div class="comments-thread">
                            @foreach (var comment in comments)
                            {
                                <div class="comment-card @(comment.isLecturerPost ? "lecturer-comment" : "")">
                                    <div class="comment-header">
                                        <div class="user-info">
                                            <div class="user-avatar small @(comment.isLecturerPost ? "lecturer-avatar" : "")">
                                                @GetInitials(comment.UserName)
                                            </div>
                                            <span class="user-name">@comment.UserName</span>
                                            @if (comment.isLecturerPost)
                                            {
                                                <span class="lecturer-badge">Lecturer</span>
                                            }
                                        </div>
                                        <span class="timestamp">@FormatTimestamp(comment.createdAt)</span>
                                    </div>
                                    <div class="comment-content">
                                        <p>@comment.content</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>

    <!-- Active Reply Banner -->
    @if (!string.IsNullOrEmpty(ReplyingToMessageId))
    {
        <div class="replying-banner">
            <div class="replying-info">
                <i class="fas fa-reply"></i>
                <span>Replying to <strong>@ReplyingToAuthor</strong></span>
            </div>
            <button class="btn-close-reply" @onclick="CancelReply" title="Cancel reply">
                <i class="fas fa-times"></i>
            </button>
        </div>
    }

    <!-- Universal Composer Section -->
    <div class="composer-section @(IsComposingQuestion ? "question-mode" : "")">
        <!-- Selected File Pill -->
        @if (SelectedFile != null)
        {
            <div class="selected-file-chip">
                <div class="chip-icon">
                    <i class="@GetFileIcon(SelectedFileName)"></i>
                </div>
                <span class="chip-name">@SelectedFileName</span>
                <span class="chip-size">(@SelectedFileSizeFormatted)</span>
                <button class="btn-remove-chip" @onclick="ClearSelectedFile" title="Remove attachment">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        }

        <!-- Composer Actions & Input Bar -->
        <div class="composer-row">
            <!-- Hidden InputFile -->
            <InputFile id="messagingFileInput" 
                       @ref="_fileInput" 
                       OnChange="HandleFileSelected" 
                       accept="*/*" 
                       style="display: none;" />

            <!-- Attachment Button -->
            <button class="btn-tool @(SelectedFile != null ? "active" : "")" 
                    @onclick="TriggerFileInput" 
                    disabled="@IsUploadingFile"
                    title="Attach file (PDF, slides, images, code up to 50MB)">
                <i class="fas fa-paperclip"></i>
            </button>

            <!-- Question Mode Toggle -->
            <button class="btn-tool btn-question-toggle @(IsComposingQuestion ? "active" : "")" 
                    @onclick="ToggleQuestionMode"
                    disabled="@IsUploadingFile"
                    title="@(IsComposingQuestion ? "Switch to standard message" : "Ask as question to the class")">
                <i class="fas fa-question"></i>
                <span class="toggle-text">Question</span>
            </button>

            <!-- Main Text Input -->
            <input type="text" 
                   class="composer-input" 
                   placeholder="@GetComposerPlaceholder()" 
                   @bind="ComposerText"
                   @bind:event="oninput"
                   @onkeypress="HandleKeyPress"
                   disabled="@IsUploadingFile" />

            <!-- Send Button -->
            <button class="btn-send @(CanSend ? "ready" : "")" 
                    @onclick="SubmitMessage" 
                    disabled="@(!CanSend || IsUploadingFile)"
                    title="Send message">
                @if (IsUploadingFile)
                {
                    <i class="fas fa-spinner fa-spin"></i>
                }
                else
                {
                    <i class="fas fa-paper-plane"></i>
                }
            </button>
        </div>

        <!-- Upload Progress Bar -->
        @if (IsUploadingFile)
        {
            <div class="upload-progress">
                <div class="progress-info">
                    <span>Uploading @SelectedFileName...</span>
                    <span>@UploadProgress.ToString("F0")%</span>
                </div>
                <div class="progress-bar">
                    <div class="progress-fill" style="width: @(UploadProgress)%"></div>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="error-banner">
                <i class="fas fa-exclamation-circle"></i>
                <span>@ErrorMessage</span>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string SessionId { get; set; } = string.Empty;
    [Parameter] public bool IsLecturer { get; set; }
    [Parameter] public HubConnection? HubConnection { get; set; }
    [Parameter] public string CurrentUserId { get; set; } = string.Empty;
    [Parameter] public string CurrentUserName { get; set; } = string.Empty;

    private List<VIIDII.Services.Message> Messages = new();
    private string ActiveTab = "all";
    private string ComposerText = "";
    private bool IsComposingQuestion = false;

    // Replying
    private string? ReplyingToMessageId = null;
    private string ReplyingToAuthor = "";

    // File Uploading
    private ElementReference _messagesContainer;
    private InputFile? _fileInput;
    private IBrowserFile? SelectedFile;
    private string SelectedFileName = "";
    private string SelectedFileSizeFormatted = "";
    private bool IsUploadingFile = false;
    private double UploadProgress = 0;
    private string? ErrorMessage = null;

    private bool CanSend => !string.IsNullOrWhiteSpace(ComposerText) || SelectedFile != null;

    protected override async Task OnInitializedAsync()
    {
        if (HubConnection == null) return;

        // Register SignalR handlers
        HubConnection.On<VIIDII.Services.Message>("ReceivePost", HandleReceivePost);
        HubConnection.On<VIIDII.Services.Message>("ReceiveComment", HandleReceiveComment);
        HubConnection.On<List<VIIDII.Services.Message>>("ReceiveMessages", HandleReceiveMessages);
        HubConnection.On<string, string, string, bool>("ReceiveReaction", HandleReceiveReaction);
        HubConnection.On<string, bool>("ReceiveQuestionAnswered", HandleReceiveQuestionAnswered);
        HubConnection.On<string>("PostCreated", HandlePostCreated);

        // Load existing session messages
        try
        {
            await HubConnection.SendAsync("GetMessages", SessionId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MessagingPanel] Error requesting messages: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ScrollToBottom();
        }
    }

    private void SetFilter(string filter)
    {
        ActiveTab = filter;
    }

    private IEnumerable<VIIDII.Services.Message> GetFilteredPosts()
    {
        var posts = Messages.Where(m => m.parentId == m.id).OrderBy(m => m.createdAt);
        return ActiveTab switch
        {
            "questions" => posts.Where(m => m.isQuestion),
            "files" => posts.Where(m => m.messageType == MessageType.File || !string.IsNullOrEmpty(m.fileUrl)),
            _ => posts
        };
    }

    private List<VIIDII.Services.Message> GetComments(string postId)
    {
        return Messages.Where(m => m.parentId == postId && m.id != postId).OrderBy(m => m.createdAt).ToList();
    }

    // SignalR Handlers
    private Task HandleReceivePost(VIIDII.Services.Message message)
    {
        if (message.sessionId != SessionId) return Task.CompletedTask;

        return InvokeAsync(async () =>
        {
            if (!Messages.Any(m => m.id == message.id))
            {
                Messages.Add(message);
            }
            StateHasChanged();
            await ScrollToBottom();
        });
    }

    private Task HandleReceiveComment(VIIDII.Services.Message comment)
    {
        if (comment.sessionId != SessionId) return Task.CompletedTask;

        return InvokeAsync(async () =>
        {
            if (!Messages.Any(m => m.id == comment.id))
            {
                Messages.Add(comment);
            }
            StateHasChanged();
            await ScrollToBottom();
        });
    }

    private Task HandleReceiveMessages(List<VIIDII.Services.Message> messages)
    {
        return InvokeAsync(() =>
        {
            Messages = messages.Where(m => m.sessionId == SessionId).ToList();
            StateHasChanged();
        });
    }

    private Task HandleReceiveReaction(string messageId, string userId, string emoji, bool isAdd)
    {
        var message = Messages.FirstOrDefault(m => m.id == messageId);
        if (message == null) return Task.CompletedTask;

        return InvokeAsync(() =>
        {
            if (isAdd)
            {
                if (!message.Reactions.Any(r => r.UserId == userId && r.Emoji == emoji))
                {
                    message.Reactions.Add(new Reaction
                    {
                        UserId = userId,
                        Emoji = emoji,
                        Timestamp = DateTime.UtcNow
                    });
                }
            }
            else
            {
                message.Reactions.RemoveAll(r => r.UserId == userId && r.Emoji == emoji);
            }
            StateHasChanged();
        });
    }

    private Task HandleReceiveQuestionAnswered(string messageId, bool isAnswered)
    {
        var message = Messages.FirstOrDefault(m => m.id == messageId);
        if (message == null) return Task.CompletedTask;

        return InvokeAsync(() =>
        {
            message.isAnswered = isAnswered;
            StateHasChanged();
        });
    }

    private async Task HandlePostCreated(string postId)
    {
        if (SelectedFile != null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("livekitInterop.sendP2PFile", "messagingFileInput", postId);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[MessagingPanel] sendP2PFile error: {ex.Message}");
            }
        }

        await InvokeAsync(() =>
        {
            ComposerText = "";
            ClearSelectedFile();
            IsComposingQuestion = false;
            ErrorMessage = null;
            IsUploadingFile = false;
            StateHasChanged();
        });
    }

    // Message Sending
    private async Task SubmitMessage()
    {
        if (!CanSend || HubConnection == null) return;

        ErrorMessage = null;

        // If in reply mode, send as comment
        if (!string.IsNullOrEmpty(ReplyingToMessageId))
        {
            try
            {
                await HubConnection.SendAsync("CreateComment", SessionId, ReplyingToMessageId, ComposerText);
                CancelReply();
                ComposerText = "";
            }
            catch (Exception ex)
            {
                ErrorMessage = $"Failed to send reply: {ex.Message}";
            }
            return;
        }

        // Post creation (P2P zero server storage)
        string? fileName = null;
        long? fileSizeBytes = null;
        bool isFile = false;

        if (SelectedFile != null)
        {
            fileName = SelectedFile.Name;
            fileSizeBytes = SelectedFile.Size;
            isFile = true;
            IsUploadingFile = true;
            UploadProgress = 100;
        }

        try
        {
            var contentToSend = string.IsNullOrWhiteSpace(ComposerText) 
                ? (isFile ? $"Shared file: {fileName}" : "") 
                : ComposerText;

            await HubConnection.SendAsync(
                "SendRoomMessage",
                SessionId,
                contentToSend,
                isFile,
                null,
                fileName,
                fileSizeBytes,
                IsComposingQuestion);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error sending message: {ex.Message}";
            IsUploadingFile = false;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && CanSend && !IsUploadingFile)
        {
            await SubmitMessage();
        }
    }

    // Question Answering
    private async Task ToggleQuestionAnswered(string messageId, bool newStatus)
    {
        if (HubConnection == null) return;
        try
        {
            await HubConnection.SendAsync("MarkQuestionAnswered", SessionId, messageId, newStatus);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ToggleQuestionAnswered] Error: {ex.Message}");
        }
    }

    // Reply System
    private void StartReply(string messageId, string authorName)
    {
        ReplyingToMessageId = messageId;
        ReplyingToAuthor = authorName;
        IsComposingQuestion = false;
        ClearSelectedFile();
    }

    private void CancelReply()
    {
        ReplyingToMessageId = null;
        ReplyingToAuthor = "";
    }

    // Reaction
    private async Task ToggleReaction(string messageId)
    {
        if (HubConnection == null) return;

        var message = Messages.FirstOrDefault(m => m.id == messageId);
        if (message == null) return;

        try
        {
            if (message.HasUserReacted(CurrentUserId))
            {
                await HubConnection.SendAsync("RemoveReaction", SessionId, messageId, "👍");
            }
            else
            {
                await HubConnection.SendAsync("AddReaction", SessionId, messageId, "👍");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ToggleReaction] Error: {ex.Message}");
        }
    }

    // File Handling
    private async Task TriggerFileInput()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('messagingFileInput').click()");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error triggering file input: {ex.Message}");
        }
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        ErrorMessage = null;
        if (e.File.Size > 50 * 1024 * 1024)
        {
            ErrorMessage = "File size exceeds the 50 MB limit.";
            return;
        }

        SelectedFile = e.File;
        SelectedFileName = e.File.Name;
        SelectedFileSizeFormatted = MessageService.FormatFileSize(e.File.Size);
        StateHasChanged();
    }

    private void ClearSelectedFile()
    {
        SelectedFile = null;
        SelectedFileName = "";
        SelectedFileSizeFormatted = "";
    }

    private void ToggleQuestionMode()
    {
        IsComposingQuestion = !IsComposingQuestion;
    }

    // UI Helpers
    private string GetComposerPlaceholder()
    {
        if (!string.IsNullOrEmpty(ReplyingToMessageId))
        {
            return $"Write reply to {ReplyingToAuthor}...";
        }
        if (IsComposingQuestion)
        {
            return "Ask a question to the lecturer and class...";
        }
        if (SelectedFile != null)
        {
            return "Add an optional note about this file...";
        }
        return IsLecturer 
            ? "Type an announcement or message..." 
            : "Type a message to the room...";
    }

    private string GetEmptyStateIcon() => ActiveTab switch
    {
        "questions" => "fas fa-question-circle",
        "files" => "fas fa-folder-open",
        _ => "fas fa-comments"
    };

    private string GetEmptyStateTitle() => ActiveTab switch
    {
        "questions" => "No questions asked yet",
        "files" => "No files shared yet",
        _ => "No messages yet"
    };

    private string GetEmptyStateHint() => ActiveTab switch
    {
        "questions" => "Need clarification? Click the Question button below to ask.",
        "files" => "Click the paperclip button to share lecture slides, notes, or code.",
        _ => "Start the conversation by posting below."
    };

    private string GetFileIcon(string fileName)
    {
        var ext = Path.GetExtension(fileName).ToLowerInvariant();
        return ext switch
        {
            ".pdf" => "fas fa-file-pdf file-icon-pdf",
            ".jpg" or ".jpeg" or ".png" or ".webp" or ".gif" or ".svg" => "fas fa-file-image file-icon-img",
            ".zip" or ".rar" or ".7z" or ".tar" or ".gz" => "fas fa-file-archive file-icon-zip",
            ".cs" or ".js" or ".ts" or ".py" or ".java" or ".c" or ".cpp" or ".html" or ".css" or ".json" => "fas fa-file-code file-icon-code",
            ".doc" or ".docx" or ".txt" or ".md" => "fas fa-file-alt file-icon-doc",
            _ => "fas fa-file file-icon-default"
        };
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpper();
    }

    private string FormatTimestamp(DateTime timestamp)
    {
        var now = DateTime.UtcNow.AddHours(1);
        var diff = now - timestamp;

        if (diff.TotalMinutes < 1) return "Just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        return timestamp.ToString("MMM d, h:mm tt");
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                const container = document.querySelector('.messages-container');
                if (container) {
                    container.scrollTop = container.scrollHeight;
                }
            ");
        }
        catch
        {
            // Ignore scroll errors during hot reloads
        }
    }
}
