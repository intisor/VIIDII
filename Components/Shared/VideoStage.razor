@using Microsoft.AspNetCore.SignalR.Client

<div class="flex-1 flex flex-col relative bg-black">
    <VideoPlayer IsLecturer="@IsLecturer"
                 IsLoading="@IsLoading"
                 IsStreamLoaded="@IsStreamLoaded"
                 IsSessionStarted="@IsSessionStarted" />

    <ControlsBar IsLecturer="@IsLecturer"
                 IsWebcamActive="@IsWebcamActive"
                 IsScreenSharing="@IsScreenSharing"
                 IsSessionStarted="@IsSessionStarted"
                 IsLoading="@IsLoading"
                 HubConnection="@HubConnection"
                 OnToggleScreenShare="@OnToggleScreenShare"
                 OnEndSession="@OnEndSession"
                 OnStartSession="@OnStartSession" />
</div>

@code {
    [Parameter]
    public bool IsLecturer { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public bool IsStreamLoaded { get; set; }

    [Parameter]
    public bool IsSessionStarted { get; set; }

    [Parameter]
    public bool IsWebcamActive { get; set; }

    [Parameter]
    public bool IsScreenSharing { get; set; }

    [Parameter]
    public HubConnection? HubConnection { get; set; }

    [Parameter]
    public EventCallback OnToggleScreenShare { get; set; }

    [Parameter]
    public EventCallback OnEndSession { get; set; }

    [Parameter]
    public EventCallback OnStartSession { get; set; }
}
