@inject IJSRuntime JS
@implements IAsyncDisposable

<button @onclick="ToggleTheme" 
        class="flex items-center justify-center w-9 h-9 rounded-md border border-input bg-background hover:bg-accent hover:text-accent-foreground transition-colors"
        title="Toggle theme"
        aria-label="@(isDark ? "Switch to light mode" : "Switch to dark mode")">
    @if (isDark)
    {
        <!-- Sun icon for light mode -->
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2"/>
            <path d="M12 20v2"/>
            <path d="m4.93 4.93 1.41 1.41"/>
            <path d="m17.66 17.66 1.41 1.41"/>
            <path d="M2 12h2"/>
            <path d="M20 12h2"/>
            <path d="m6.34 17.66-1.41 1.41"/>
            <path d="m19.07 4.93-1.41 1.41"/>
        </svg>
    }
    else
    {
        <!-- Moon icon for dark mode -->
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
        </svg>
    }
</button>

@code {
    private bool isDark = false;
    private IJSObjectReference? themeModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeTheme();
        }
    }

    private async Task InitializeTheme()
    {
        try
        {
            // Get current theme from localStorage (already applied by blazor-theme.js)
            var savedTheme = await JS.InvokeAsync<string>("blazorTheme.getTheme");
            isDark = savedTheme == "dark";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error initializing theme: {ex.Message}");
            // Fallback to light theme
            isDark = false;
        }
    }

    private async Task ToggleTheme()
    {
        try
        {
            isDark = !isDark;
            var theme = isDark ? "dark" : "light";
            
            // Apply theme immediately using our JS helper
            await JS.InvokeVoidAsync("blazorTheme.applyTheme", theme);
            
            // Force UI update
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error toggling theme: {ex.Message}");
            // Revert on error
            isDark = !isDark;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (themeModule is not null)
        {
            await themeModule.DisposeAsync();
        }
    }
}