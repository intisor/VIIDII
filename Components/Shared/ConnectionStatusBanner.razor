@using VIIDII.Models

@if (ShowBanner)
{
    <div class="fixed top-16 left-1/2 transform -translate-x-1/2 z-50 transition-all duration-300">
        <div class="@GetBannerClass() px-6 py-3 rounded-lg shadow-lg border flex items-center gap-3 max-w-md">
            @if (Status == SessionState.ConnectionStatusType.Reconnecting)
            {
                <div class="w-5 h-5 border-2 border-yellow-600 border-t-transparent rounded-full animate-spin"></div>
                <span class="text-sm font-medium text-yellow-900">Reconnecting...</span>
            }
            else if (Status == SessionState.ConnectionStatusType.Reconnected)
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-600">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                    <polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
                <div class="flex-1">
                    <span class="text-sm font-medium text-green-900">@Message</span>
                    @if (IsLecturer)
                    {
                        <p class="text-xs text-green-700 mt-0.5">Students are still in session</p>
                    }
                </div>
            }
            else if (Status == SessionState.ConnectionStatusType.Disconnected)
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-red-600">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="15" x2="9" y1="9" y2="15"/>
                    <line x1="9" x2="15" y1="9" y2="15"/>
                </svg>
                <span class="text-sm font-medium text-red-900">@Message</span>
            }
        </div>
    </div>
}

@code {
    [Parameter] public SessionState.ConnectionStatusType Status { get; set; }
    [Parameter] public string Message { get; set; } = string.Empty;
    [Parameter] public bool IsLecturer { get; set; }

    private bool ShowBanner => Status != SessionState.ConnectionStatusType.Connected;

    private string GetBannerClass()
    {
        return Status switch
        {
            SessionState.ConnectionStatusType.Reconnecting => "bg-yellow-50 border-yellow-200",
            SessionState.ConnectionStatusType.Reconnected => "bg-green-50 border-green-200",
            SessionState.ConnectionStatusType.Disconnected => "bg-red-50 border-red-200",
            _ => "bg-gray-50 border-gray-200"
        };
    }
}

