@using VIIDII.Models
@using Microsoft.AspNetCore.SignalR.Client

<div class="flex flex-col h-full bg-card">
    <div class="p-4 border-b border-border flex items-center justify-between flex-shrink-0">
        <h3 class="font-semibold flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            Participants <span class="text-muted-foreground ml-1 text-sm font-normal">(@Participants.Count)</span>
        </h3>
        
        @if (IsLecturer && Participants.Count > 0)
        {
            <button class="text-xs px-2.5 py-1.5 bg-primary/10 hover:bg-primary/20 text-primary font-medium rounded-md transition-colors flex items-center gap-1.5" @onclick="PromptEngagement">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 11V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v0"/><path d="M14 10V4a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v2"/><path d="M10 10.5V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v8"/><path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"/></svg>
                Prompt All
            </button>
        }
    </div>

    @if (Participants.Count == 0)
    {
        <div class="flex flex-col items-center justify-center h-full text-muted-foreground">
             <div class="w-12 h-12 rounded-full bg-secondary flex items-center justify-center mb-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/><line x1="2" x2="22" y1="2" y2="22"/></svg>
             </div>
            <p>No participants yet</p>
            <p class="text-sm mt-1">Students will appear here</p>
        </div>
    }
    else
    {
        <!-- Engagement Stats (Lecturer Only) -->
        @if (IsLecturer)
        {
            <div class="grid grid-cols-3 gap-2 p-3 border-b border-border bg-muted/20">
                <div class="bg-card p-2 rounded border border-border flex flex-col items-center text-center">
                    <span class="text-lg font-bold text-green-600">@ActiveCount</span>
                    <span class="text-[10px] uppercase tracking-wider text-muted-foreground font-medium">Active</span>
                </div>
                <div class="bg-card p-2 rounded border border-border flex flex-col items-center text-center">
                     <span class="text-lg font-bold text-amber-500">@InactiveCount</span>
                    <span class="text-[10px] uppercase tracking-wider text-muted-foreground font-medium">Idle</span>
                </div>
                <div class="bg-card p-2 rounded border border-border flex flex-col items-center text-center">
                     <span class="text-lg font-bold text-red-500">@IssuesCount</span>
                    <span class="text-[10px] uppercase tracking-wider text-muted-foreground font-medium">Issues</span>
                </div>
            </div>
        }

        <!-- Participant List -->
        <div class="flex-1 overflow-y-auto p-2 space-y-1">
            @foreach (var participant in Participants.OrderBy(p => p.Value))
            {
                var status = ParticipantStatuses.ContainsKey(participant.Key)
                    ? ParticipantStatuses[participant.Key]
                    : Session.StudentStatus.Disconnected;

                <div class="flex items-center gap-3 p-2 rounded-lg hover:bg-secondary/50 transition-colors group">
                    <div class="flex-shrink-0 w-8 h-8 rounded-full bg-secondary flex items-center justify-center text-xs font-bold text-foreground">
                         @GetInitials(participant.Value)
                    </div>
                    <div class="flex-1 min-w-0">
                         <div class="flex items-center justify-between">
                            <span class="text-sm font-medium truncate">@participant.Value</span>
                         </div>
                         <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                            <span class="font-mono">@participant.Key</span>
                         </div>
                    </div>
                    
                    <div class="flex-shrink-0" title="@GetStatusLabel(status)">
                         @switch (status)
                         {
                             case Session.StudentStatus.Active:
                                 <div class="text-green-500">
                                     <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                                 </div>
                                 break;
                             case Session.StudentStatus.InActive:
                                 <div class="text-amber-500">
                                     <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
                                 </div>
                                 break;
                             case Session.StudentStatus.BatteryLow:
                                 <div class="text-red-500 animate-pulse">
                                     <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="10" x="2" y="7" rx="2" ry="2"/><line x1="22" x2="22" y1="11" y2="13"/></svg>
                                 </div>
                                 break;
                             case Session.StudentStatus.DataFinished:
                                 <div class="text-red-500 animate-pulse">
                                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h.01"/><path d="M8.5 16.429a5 5 0 0 1 7 0"/><path d="M5 12.859a10 10 0 0 1 14 0"/><path d="M1.5 9.289a15 15 0 0 1 21 0"/><line x1="1" x2="23" y1="2" y2="22"/></svg>
                                 </div>
                                 break;
                             default:
                                 <div class="text-gray-300">
                                     <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" x2="9" y1="9" y2="15"/><line x1="9" x2="15" y1="9" y2="15"/></svg>
                                 </div>
                                 break;
                         }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Dictionary<string, string> Participants { get; set; } = new();
    [Parameter] public Dictionary<string, Session.StudentStatus> ParticipantStatuses { get; set; } = new();
    [Parameter] public HubConnection? HubConnection { get; set; }
    [Parameter] public string SessionId { get; set; } = string.Empty;
    [Parameter] public bool IsLecturer { get; set; }

    private int ActiveCount => ParticipantStatuses.Count(p => p.Value == Session.StudentStatus.Active);
    private int InactiveCount => ParticipantStatuses.Count(p => p.Value == Session.StudentStatus.InActive);
    private int IssuesCount => ParticipantStatuses.Count(p => 
        p.Value == Session.StudentStatus.BatteryLow || 
        p.Value == Session.StudentStatus.DataFinished);

    private async Task PromptEngagement()
    {
        if (HubConnection == null || !IsLecturer) return;

        try
        {
            await HubConnection.SendAsync("PromptEngagement", SessionId);
            Console.WriteLine("Engagement prompt sent to all students");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error prompting engagement: {ex.Message}");
        }
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrEmpty(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpper();
    }

    private string GetStatusIcon(Session.StudentStatus status)
    {
        return status switch
        {
            Session.StudentStatus.Active => "check-circle",
            Session.StudentStatus.InActive => "exclamation-circle",
            Session.StudentStatus.BatteryLow => "battery-quarter",
            Session.StudentStatus.DataFinished => "signal",
            Session.StudentStatus.Disconnected => "times-circle",
            _ => "user"
        };
    }

    private string GetStatusLabel(Session.StudentStatus status)
    {
        return status switch
        {
            Session.StudentStatus.Active => "Active",
            Session.StudentStatus.InActive => "Inactive",
            Session.StudentStatus.BatteryLow => "Low Battery",
            Session.StudentStatus.DataFinished => "Poor Network",
            Session.StudentStatus.Disconnected => "Disconnected",
            _ => "Unknown"
        };
    }
}
