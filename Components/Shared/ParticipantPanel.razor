@using VIIDII.Models
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime

<div class="participant-panel">
    <div class="panel-header">
        <h3>
            <i class="fas fa-users"></i>
            @(IsLecturer && ExpectedStudents.Count > 0
                ? $"Class list ({HereCount}/{ExpectedCount})"
                : $"Participants ({ParticipantCount})")
        </h3>
        
        @if (IsLecturer && ParticipantCount > 0)
        {
            <button class="btn-prompt" @onclick="PromptEngagement">
                <i class="fas fa-hand-paper"></i> Prompt All
            </button>
        }
    </div>

    @* Who is expected but has not joined is the number a lecturer actually
       cares about mid-lecture, so it is stated up front rather than left to be
       inferred from an empty panel. *@
    @if (IsLecturer && ExpectedCount > 0)
    {
        <div class="engagement-stats">
            <div class="stat-card active">
                <i class="fas fa-check-circle"></i>
                <div>
                    <span class="count">@HereCount</span>
                    <span class="label">Here now</span>
                </div>
            </div>
            <div class="stat-card inactive">
                <i class="fas fa-user-slash"></i>
                <div>
                    <span class="count">@(MissingCount)</span>
                    <span class="label">Not joined</span>
                </div>
            </div>
        </div>
    }

    @* Expected but absent. Students do not hold accounts, so these are matched
       on the identifier they typed when claiming their seat. *@
    @if (IsLecturer && MissingStudents.Count > 0)
    {
        <details class="absent-list">
            <summary>
                <i class="fas fa-user-clock"></i>
                Not yet joined (@MissingStudents.Count)
            </summary>
            <div class="absent-items">
                @foreach (var student in MissingStudents)
                {
                    <div class="absent-item">
                        <span class="absent-name">@student.Name</span>
                        <span class="absent-id">@student.Identifier</span>
                    </div>
                }
            </div>
        </details>
    }

    @if (ParticipantCount == 0)
    {
        <div class="empty-state">
            <i class="fas fa-user-slash"></i>
            <p>No participants yet</p>
            <p class="hint">Students will appear here when they join</p>
        </div>
    }
    else
    {
        <!-- Engagement Stats (Lecturer Only) -->
        @if (IsLecturer)
        {
            <div class="engagement-stats">
                <div class="stat-card active">
                    <i class="fas fa-check-circle"></i>
                    <div>
                        <span class="count">@ActiveCount</span>
                        <span class="label">Active</span>
                    </div>
                </div>
                <div class="stat-card inactive">
                    <i class="fas fa-exclamation-circle"></i>
                    <div>
                        <span class="count">@InactiveCount</span>
                        <span class="label">Inactive</span>
                    </div>
                </div>
                <div class="stat-card issues">
                    <i class="fas fa-flag"></i>
                    <div>
                        <span class="count">@IssuesCount</span>
                        <span class="label">Issues</span>
                    </div>
                </div>
            </div>
        }

        <!-- Participant List -->
        <div class="participants-list">
            @foreach (var participant in OrderedParticipants)
            {
                var status = SafeParticipantStatuses.TryGetValue(participant.Key, out var participantStatus)
                    ? participantStatus
                    : Session.StudentStatus.Active;

                <div class="participant-item status-@status.ToString().ToLower()">
                    <div class="participant-info">
                        <div class="participant-avatar">
                            @GetInitials(participant.Value)
                        </div>
                        <div class="participant-details">
                            <span class="participant-name">@participant.Value</span>
                            <span class="participant-id">@participant.Key</span>
                        </div>
                    </div>
                    <div class="participant-status">
                        <i class="fas fa-@GetStatusIcon(status)"></i>
                        <span>@GetStatusLabel(status)</span>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Dictionary<string, string> Participants { get; set; } = new();
    [Parameter] public Dictionary<string, Session.StudentStatus> ParticipantStatuses { get; set; } = new();
    [Parameter] public HubConnection? HubConnection { get; set; }
    [Parameter] public string SessionId { get; set; } = string.Empty;
    [Parameter] public bool IsLecturer { get; set; }

    /// <summary>
    /// Everyone on the class list, lecturer only. Empty when there is no class, and
    /// the panel falls back to showing participants alone.
    /// </summary>
    [Parameter] public IReadOnlyList<ExpectedStudent> ExpectedStudents { get; set; } = [];

    /// <param name="Identifier">What the student types to join.</param>
    /// <param name="Name">Name as the lecturer spelled it on the list.</param>
    public sealed record ExpectedStudent(string Identifier, string Name);

    private Dictionary<string, string> SafeParticipants => Participants ?? new();
    private Dictionary<string, Session.StudentStatus> SafeParticipantStatuses => ParticipantStatuses ?? new();
    private IEnumerable<KeyValuePair<string, string>> OrderedParticipants =>
        SafeParticipants
            .Where(static p => !string.IsNullOrWhiteSpace(p.Key) && !string.IsNullOrWhiteSpace(p.Value))
            .OrderBy(static p => p.Value, StringComparer.OrdinalIgnoreCase);
    private int ParticipantCount => OrderedParticipants.Count();

    /// <summary>
    /// Expected students who are not in the room. Matched on the identifier, which
    /// is what the student typed when claiming a seat, because that is what the
    /// hub records them under.
    /// </summary>
    private IReadOnlyList<ExpectedStudent> MissingStudents => ExpectedStudents
        .Where(student =>
            !SafeParticipants.Keys.Any(id =>
                string.Equals(id, student.Identifier, StringComparison.OrdinalIgnoreCase)))
        .OrderBy(student => student.Name, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private int ExpectedCount => ExpectedStudents.Count;
    private int HereCount => ExpectedStudents.Count - MissingStudents.Count;
    private int MissingCount => MissingStudents.Count;
    private int ActiveCount => SafeParticipantStatuses.Count(p => p.Value == Session.StudentStatus.Active);
    private int InactiveCount => SafeParticipantStatuses.Count(p => p.Value == Session.StudentStatus.InActive);
    private int IssuesCount => SafeParticipantStatuses.Count(p => 
        p.Value == Session.StudentStatus.BatteryLow || 
        p.Value == Session.StudentStatus.DataFinished);

    private async Task PromptEngagement()
    {
        if (HubConnection == null || !IsLecturer) return;

        try
        {
            await JSRuntime.InvokeVoidAsync("console.log", $"[VIIDII] Lecturer Prompt All clicked. session={SessionId}, participants={ParticipantCount}");
            await HubConnection.SendAsync("PromptEngagement", SessionId);
            Console.WriteLine("Engagement prompt sent to all students");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error prompting engagement: {ex.Message}");
        }
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrEmpty(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpper();
    }

    private string GetStatusIcon(Session.StudentStatus status)
    {
        return status switch
        {
            Session.StudentStatus.Active => "check-circle",
            Session.StudentStatus.InActive => "exclamation-circle",
            Session.StudentStatus.BatteryLow => "battery-quarter",
            Session.StudentStatus.DataFinished => "signal",
            Session.StudentStatus.Disconnected => "times-circle",
            _ => "user"
        };
    }

    private string GetStatusLabel(Session.StudentStatus status)
    {
        return status switch
        {
            Session.StudentStatus.Active => "Active",
            Session.StudentStatus.InActive => "Inactive",
            Session.StudentStatus.BatteryLow => "Low Battery",
            Session.StudentStatus.DataFinished => "Poor Network",
            Session.StudentStatus.Disconnected => "Disconnected",
            _ => "Unknown"
        };
    }
}
