@using VIIDII.Models
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime

<div class="participant-panel">
    <div class="panel-header">
        <h3>
            <i class="fas fa-users"></i>
            @(IsLecturer && ExpectedStudents.Count > 0
                ? $"Class list ({HereCount}/{ExpectedCount})"
                : $"Participants ({ParticipantCount})")
        </h3>
        
        @if (IsLecturer && ParticipantCount > 0)
        {
            <div class="prompt-actions">
                <button class="btn-prompt btn-quiz" @onclick="PrepareCaptionQuiz" title="Extract smart attention check question from live captions">
                    <i class="fas fa-brain"></i> Quiz Check
                </button>
                <button class="btn-prompt btn-ping" @onclick="PromptEngagement" title="Quick 'Are you there' ping">
                    <i class="fas fa-hand-paper"></i> Ping All
                </button>
            </div>
        }
    </div>

    @* Live Quiz Stats Banner (Lecturer Only) *@
    @if (IsLecturer && _hasLiveQuizStats)
    {
        <div class="live-quiz-card">
            <div class="quiz-stat-header">
                <span class="quiz-stat-title"><i class="fas fa-brain"></i> Latest Quiz Check</span>
                <span class="quiz-stat-badge">@(_quizResponses)/@(_quizTotalEligible > 0 ? _quizTotalEligible : ParticipantCount) Responded</span>
            </div>
            <div class="quiz-stat-progress">
                @{
                    var eligible = _quizTotalEligible > 0 ? _quizTotalEligible : Math.Max(1, ParticipantCount);
                    var pct = Math.Min(100, (int)((double)_quizResponses / eligible * 100));
                }
                <div class="quiz-stat-bar" style="width: @(pct)%;"></div>
            </div>
            <div class="quiz-stat-footer">
                <span>Accuracy: @(_quizResponses > 0 ? $"{(_quizCorrect * 100 / _quizResponses)}%" : "—")</span>
                <span>Response Rate: @pct%</span>
            </div>
        </div>
    }

    @* Who is expected but has not joined *@
    @if (IsLecturer && ExpectedCount > 0)
    {
        <div class="engagement-stats">
            <div class="stat-card active">
                <i class="fas fa-check-circle"></i>
                <div>
                    <span class="count">@HereCount</span>
                    <span class="label">Here now</span>
                </div>
            </div>
            <div class="stat-card inactive">
                <i class="fas fa-user-slash"></i>
                <div>
                    <span class="count">@(MissingCount)</span>
                    <span class="label">Not joined</span>
                </div>
            </div>
        </div>
    }

    @* Expected but absent *@
    @if (IsLecturer && MissingStudents.Count > 0)
    {
        <details class="absent-list">
            <summary>
                <i class="fas fa-user-clock"></i>
                Not yet joined (@MissingStudents.Count)
            </summary>
            <div class="absent-items">
                @foreach (var student in MissingStudents)
                {
                    <div class="absent-item">
                        <span class="absent-name">@student.Name</span>
                        <span class="absent-id">@student.Identifier</span>
                    </div>
                }
            </div>
        </details>
    }

    @if (ParticipantCount == 0)
    {
        <div class="empty-state">
            <i class="fas fa-user-slash"></i>
            <p>No participants yet</p>
            <p class="hint">Students will appear here when they join</p>
        </div>
    }
    else
    {
        <!-- Engagement Stats (Lecturer Only) -->
        @if (IsLecturer)
        {
            <div class="engagement-stats">
                <div class="stat-card active">
                    <i class="fas fa-check-circle"></i>
                    <div>
                        <span class="count">@ActiveCount</span>
                        <span class="label">Active</span>
                    </div>
                </div>
                <div class="stat-card inactive">
                    <i class="fas fa-exclamation-circle"></i>
                    <div>
                        <span class="count">@InactiveCount</span>
                        <span class="label">Inactive</span>
                    </div>
                </div>
                <div class="stat-card issues">
                    <i class="fas fa-flag"></i>
                    <div>
                        <span class="count">@IssuesCount</span>
                        <span class="label">Issues</span>
                    </div>
                </div>
            </div>
        }

        <!-- Participant List -->
        <div class="participants-list">
            @foreach (var participant in OrderedParticipants)
            {
                var status = SafeParticipantStatuses.TryGetValue(participant.Key, out var participantStatus)
                    ? participantStatus
                    : Session.StudentStatus.Active;

                <div class="participant-item status-@status.ToString().ToLower()">
                    <div class="participant-info">
                        <div class="participant-avatar">
                            @GetInitials(participant.Value)
                        </div>
                        <div class="participant-details">
                            <span class="participant-name">@participant.Value</span>
                            <span class="participant-id">@participant.Key</span>
                        </div>
                    </div>
                    <div class="participant-status">
                        <i class="fas fa-@GetStatusIcon(status)"></i>
                        <span>@GetStatusLabel(status)</span>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* Lecturer Quiz Review & Customization Modal *@
@if (_showQuizModal)
{
    <div class="quiz-preview-overlay" @onclick="() => _showQuizModal = false">
        <div class="quiz-preview-modal natural-glass" @onclick:stopPropagation="true">
            <div class="quiz-preview-header">
                <h4><i class="fas fa-brain"></i> Lecture Check: Question Preview</h4>
                <button type="button" class="btn-close-preview" @onclick="() => _showQuizModal = false">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="quiz-preview-body">
                @if (!string.IsNullOrEmpty(_quizSourceQuote))
                {
                    <div class="preview-quote">
                        <i class="fas fa-quote-left"></i> Spoken in lecture: "@_quizSourceQuote"
                    </div>
                }
                <div class="preview-field">
                    <label>Question to Attendees</label>
                    <textarea class="preview-textarea" @bind="_quizQuestion" rows="2"></textarea>
                </div>
                <div class="preview-field">
                    <label>Options (Click check to mark correct answer)</label>
                    @for (int i = 0; i < _quizOptions.Count; i++)
                    {
                        var idx = i;
                        var isCorrect = idx == _quizCorrectIndex;
                        <div class="preview-option-row @(isCorrect ? "correct-row" : "")">
                            <span class="option-tag">@((char)('A' + idx))</span>
                            <input type="text" class="preview-input" @bind="_quizOptions[idx]" />
                            <button type="button" class="btn-set-correct @(isCorrect ? "active" : "")" 
                                    @onclick="() => _quizCorrectIndex = idx" 
                                    title="@(isCorrect ? "Correct answer" : "Mark as correct answer")">
                                <i class="fas fa-check"></i>
                            </button>
                        </div>
                    }
                </div>
                <div class="preview-field">
                    <label>Response Timer</label>
                    <select class="preview-select" @bind="_quizTimeout">
                        <option value="20">20 seconds</option>
                        <option value="30">30 seconds</option>
                        <option value="45">45 seconds</option>
                    </select>
                </div>
            </div>
            <div class="quiz-preview-footer">
                <button type="button" class="btn btn-secondary" @onclick="() => _showQuizModal = false">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="BroadcastQuiz" disabled="@_isSendingQuiz">
                    @if (_isSendingQuiz)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span>Broadcasting...</span>
                    }
                    else
                    {
                        <i class="fas fa-paper-plane"></i>
                        <span>Broadcast to Class</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Dictionary<string, string> Participants { get; set; } = new();
    [Parameter] public Dictionary<string, Session.StudentStatus> ParticipantStatuses { get; set; } = new();
    [Parameter] public HubConnection? HubConnection { get; set; }
    [Parameter] public string SessionId { get; set; } = string.Empty;
    [Parameter] public string SessionTitle { get; set; } = string.Empty;
    [Parameter] public bool IsLecturer { get; set; }

    [Parameter] public IReadOnlyList<ExpectedStudent> ExpectedStudents { get; set; } = [];

    public sealed record ExpectedStudent(string Identifier, string Name);

    private Dictionary<string, string> SafeParticipants => Participants ?? new();
    private Dictionary<string, Session.StudentStatus> SafeParticipantStatuses => ParticipantStatuses ?? new();
    private IEnumerable<KeyValuePair<string, string>> OrderedParticipants =>
        SafeParticipants
            .Where(static p => !string.IsNullOrWhiteSpace(p.Key) && !string.IsNullOrWhiteSpace(p.Value))
            .OrderBy(static p => p.Value, StringComparer.OrdinalIgnoreCase);
    private int ParticipantCount => OrderedParticipants.Count();

    private IReadOnlyList<ExpectedStudent> MissingStudents => ExpectedStudents
        .Where(student =>
            !SafeParticipants.Keys.Any(id =>
                string.Equals(id, student.Identifier, StringComparison.OrdinalIgnoreCase)))
        .OrderBy(student => student.Name, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private int ExpectedCount => ExpectedStudents.Count;
    private int HereCount => ExpectedStudents.Count - MissingStudents.Count;
    private int MissingCount => MissingStudents.Count;
    private int ActiveCount => SafeParticipantStatuses.Count(p => p.Value == Session.StudentStatus.Active);
    private int InactiveCount => SafeParticipantStatuses.Count(p => p.Value == Session.StudentStatus.InActive);
    private int IssuesCount => SafeParticipantStatuses.Count(p => 
        p.Value == Session.StudentStatus.BatteryLow || 
        p.Value == Session.StudentStatus.DataFinished);

    // Quiz Generation & Live Stats State
    private bool _showQuizModal;
    private string _quizQuestion = "";
    private List<string> _quizOptions = new();
    private int _quizCorrectIndex = 0;
    private string _quizSourceQuote = "";
    private int _quizTimeout = 30;
    private bool _isSendingQuiz;
    private bool _hasLiveQuizStats;
    private int _quizTotalEligible;
    private int _quizResponses;
    private int _quizCorrect;

    protected override void OnInitialized()
    {
        if (HubConnection != null && IsLecturer)
        {
            HubConnection.On<string, int, int, int>("ReceiveQuizLiveStats", (quizId, totalEligible, totalResponses, correctCount) =>
            {
                _hasLiveQuizStats = true;
                _quizTotalEligible = totalEligible;
                _quizResponses = totalResponses;
                _quizCorrect = correctCount;
                InvokeAsync(StateHasChanged);
            });
        }
    }

    private async Task PrepareCaptionQuiz()
    {
        try
        {
            var res = await JSRuntime.InvokeAsync<System.Text.Json.JsonElement>("captionInterop.generateEngagementQuiz", SessionTitle);
            if (res.ValueKind == System.Text.Json.JsonValueKind.Object)
            {
                _quizQuestion = res.GetProperty("question").GetString() ?? "";
                _quizCorrectIndex = res.GetProperty("correctIndex").GetInt32();
                _quizSourceQuote = res.TryGetProperty("sourceQuote", out var q) ? q.GetString() ?? "" : "";
                _quizOptions.Clear();
                if (res.TryGetProperty("options", out var opts) && opts.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    foreach (var opt in opts.EnumerateArray())
                    {
                        _quizOptions.Add(opt.GetString() ?? "");
                    }
                }
                _showQuizModal = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error preparing quiz: {ex.Message}");
            // Fallback: ping all
            await PromptEngagement();
        }
    }

    private async Task BroadcastQuiz()
    {
        if (HubConnection == null || string.IsNullOrWhiteSpace(_quizQuestion) || _quizOptions.Count == 0 || _isSendingQuiz)
            return;

        _isSendingQuiz = true;
        try
        {
            await HubConnection.SendAsync(
                "PromptEngagementWithQuiz", 
                SessionId, 
                _quizQuestion, 
                _quizOptions.ToArray(), 
                _quizCorrectIndex, 
                _quizTimeout, 
                _quizSourceQuote);

            _showQuizModal = false;
            _hasLiveQuizStats = true;
            _quizTotalEligible = ParticipantCount;
            _quizResponses = 0;
            _quizCorrect = 0;
            Console.WriteLine($"[ParticipantPanel] Broadcast caption quiz to session {SessionId}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error sending quiz: {ex.Message}");
        }
        finally
        {
            _isSendingQuiz = false;
        }
    }

    private async Task PromptEngagement()
    {
        if (HubConnection == null || !IsLecturer) return;

        try
        {
            await JSRuntime.InvokeVoidAsync("console.log", $"[VIIDII] Lecturer Prompt All clicked. session={SessionId}, participants={ParticipantCount}");
            await HubConnection.SendAsync("PromptEngagement", SessionId);
            Console.WriteLine("Engagement prompt sent to all students");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error prompting engagement: {ex.Message}");
        }
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrEmpty(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpper();
    }

    private string GetStatusIcon(Session.StudentStatus status)
    {
        return status switch
        {
            Session.StudentStatus.Active => "check-circle",
            Session.StudentStatus.InActive => "exclamation-circle",
            Session.StudentStatus.BatteryLow => "battery-quarter",
            Session.StudentStatus.DataFinished => "signal",
            Session.StudentStatus.Disconnected => "times-circle",
            _ => "user"
        };
    }

    private string GetStatusLabel(Session.StudentStatus status)
    {
        return status switch
        {
            Session.StudentStatus.Active => "Active",
            Session.StudentStatus.InActive => "Inactive",
            Session.StudentStatus.BatteryLow => "Low Battery",
            Session.StudentStatus.DataFinished => "Poor Network",
            Session.StudentStatus.Disconnected => "Disconnected",
            _ => "Unknown"
        };
    }
}
