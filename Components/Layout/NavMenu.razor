@inject NavigationManager Navigation
@inject AuthService AuthService
@using VIIDII.Models

<nav class="viidii-nav">
    <div class="nav-inner">

        <!-- Wordmark -->
        <a class="nav-logo" href="/">VIIDII</a>

        <!-- Primary links -->
        <div class="nav-links">
            <a class="nav-link" href="/">Home</a>
            <a class="nav-link" href="/about">About</a>

            @if (CurrentUser != null)
            {
                <a class="nav-link" href="@DashboardLink">Dashboard</a>

                @if (CurrentUser.Role == Role.Lecturer)
                {
                    <a class="nav-link" href="/create-session">New Session</a>
                }

                @if (CurrentUser.Role == Role.Student || CurrentUser.Role == Role.Lecturer)
                {
                    <a class="nav-link" href="/join-session">Join Session</a>
                }

                @if (CurrentUser.Role == Role.Admin)
                {
                    <a class="nav-link" href="/admin">Admin</a>
                }
            }
        </div>

        <!-- Right-side actions -->
        <div class="nav-actions">
            @if (CurrentUser != null)
            {
                <div class="nav-user-chip">
                    <span class="nav-user-role">@CurrentUser.Role</span>
                    <span class="nav-user-name">@CurrentUser.Name</span>
                </div>
                <button class="nav-logout" @onclick="Logout">Sign out</button>
            }
            else
            {
                <a class="nav-login-btn" href="/login">Sign in</a>
            }
        </div>

    </div>
</nav>

@code {
    private User? CurrentUser;

    private string DashboardLink => CurrentUser switch
    {
        { Role: Role.Admin }    => "/admin",
        { Role: Role.Lecturer } => "/lecturer/home",
        { Role: Role.Student }  => "/student/home",
        _                       => "/dashboard"
    };

    protected override async Task OnInitializedAsync()
    {
        CurrentUser = await AuthService.GetCurrentUserAsync();
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
