@inject NavigationManager Navigation
@inject AuthService AuthService

<div class="navbar navbar-expand-lg">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">VIIDII</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="/">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/about">About</a>
                </li>
                @if (CurrentUser != null)
                {
                    <li class="nav-item">
                        <a class="nav-link" href="@DashboardLink">Dashboard</a>
                    </li>
                    @if (CurrentUser.Role == Role.Lecturer)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/create-session">Create Session</a>
                        </li>
                    }
                    @if (CurrentUser.Role == Role.Student || CurrentUser.Role == Role.Lecturer)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/join-session">Join Session</a>
                        </li>
                    }
                    @if (CurrentUser.Role == Role.Admin)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/admin">Admin Panel</a>
                        </li>
                    }
                }
            </ul>
            <ul class="navbar-nav ms-auto">
                @if (CurrentUser != null)
                {
                    <li class="nav-item">
                        <span class="nav-link text-light">
                            <strong>@CurrentUser.Name</strong> (@CurrentUser.Role)
                        </span>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link btn btn-link text-danger" @onclick="Logout">Logout</button>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link btn btn-outline-light" href="/login">Login</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

@code {
    private User? CurrentUser;
    private string DashboardLink => CurrentUser switch
    {
        { Role: Role.Admin } => "/admin",
        { Role: Role.Lecturer } => "/lecturer/home",
        { Role: Role.Student } => "/student/home",
        _ => "/dashboard"
    };

    protected override async Task OnInitializedAsync()
    {
        CurrentUser = await AuthService.GetCurrentUserAsync();
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
