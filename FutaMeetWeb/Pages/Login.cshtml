@page
@model FutaMeetWeb.Pages.LoginModel
@{
    Layout = null;

}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
        margin: 0;
        padding: 0;
        background: #F9FAFB;
        font-family: 'Poppins', sans-serif;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        color: #333;
        position: relative;
        overflow: hidden;
        }
        /* Top Curves Wrapper */
        .top-curve-wrapper {
        position: absolute;
        top: -100px;
        left: -100px;
        z-index: 0;
        width: 300px;
        height: 300px;
        }

        .top-curve-rect-1 {
        position: absolute;
        width: 245px;
        height: 245px;
        background: linear-gradient(128.97deg, #8338EC 2.4%, #C19BF5 85.87%);
        border-radius: 50%;
        top: 0;
        left: 0;
        filter: blur(2.5px);
        z-index: 1;
        }

        .top-curve-rect-2 {
        position: absolute;
        width: 140px;
        height: 140px;
        background: linear-gradient(151.12deg, #3A86FF 29.33%, #9CC3FF 86.49%);
        border-radius: 50%;
        top: 30px;
        left: 30px;
        filter: blur(2.5px);
        z-index: 2;
        }

        .message-popup {
        position: fixed;
        bottom: 20px;
        right: 20px;
        background-color: #333;
        color: #fff;
        padding: 15px;
        border-radius: 5px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        opacity: 0;
        transition: opacity 0.5s ease-in-out;
        z-index: 1000;
        }

        .message-popup.show {
        opacity: 1;
        }

        .mobile-header{
        display:none;
        }
        .login-container {
        text-align: center;
        background: white;
        padding: 2rem;
        border-radius: 20px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
        max-width: 400px;
        width: 100%;
        z-index: 1;
        }

        h1 {
        font-size: 2rem;
        margin-bottom: 1.5rem;
        color: #FFFFFF;
        text-align: center;
        background: linear-gradient(135deg, #8338EC, #3A86FF);
        padding: 1rem;
        border-radius: 12px 12px 0 0;
        }

        .input-group {
        margin-bottom: 1rem;
        text-align: left;
        padding: 0 1rem;
        }

        .password-input-group {
        margin-top: 1rem; /* Adjust this value to move the password label down */
        }

        label {
        display: block;
        margin-bottom: 0.5rem;
        color: #565D68;
        }

        select, input {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid #A26AF1;
        border-radius: 8px;
        box-sizing: border-box;
        font-family: 'Poppins', sans-serif;
        }

        input[type="password"] {
        position: relative;
        }

        .password-toggle {
        position: absolute;
        right: 1rem;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        color: #A26AF1;
        }

        .sign-in-btn {
        display: inline-block;
        width: 100%;
        padding: 12px;
        background: linear-gradient(135deg, #8338EC, #3A86FF);
        color: white;
        border: none;
        border-radius: 24px;
        font-size: 1rem;
        cursor: pointer;
        margin-top: 1rem;
        text-decoration: none;
        }

        .gradient-background {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 50%;
        background: linear-gradient(135deg, #8338EC, #3A86FF);
        z-index: 0;
        }
        /*After signin*/ 
        .nav-item .big-nav-btn {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        max-width: 400px;
        height: 60px;
        font-size: 1.3rem;
        font-weight: 600;
        border-radius: 30px;
        background: linear-gradient(135deg, #8338EC, #3A86FF);
        color: #fff !important;
        text-decoration: none;
        box-shadow: 0 8px 24px rgba(58,134,255,0.15);
        border: 2.5px solid #FFFFFF;
        margin: 0 auto;
        transition: background 0.2s, color 0.2s;
        }

        .nav-item .big-nav-btn:active,
        .nav-item .big-nav-btn:focus,
        .nav-item .big-nav-btn:hover {
        background: rgba(131, 56, 236, 0.85);
        color: #fff !important;
        }

        .top-action-btn {
        display: flex;
        justify-content: center;
        align-items: center;
        min-width: 120px;
        height: 48px;
        font-size: 1.1rem;
        font-weight: 600;
        border-radius: 20px;
        color: #fff !important;
        text-decoration: none;
        border: none;
        outline: none;
        margin: 0 0 0 12px;
        padding: 0 24px;
        box-shadow: 0 4px 16px rgba(58,134,255,0.10);
        transition: background 0.2s, color 0.2s;
        cursor: pointer;
        }

        .top-action-btn.home {
        background: linear-gradient(135deg, #3A86FF 0%, #6DD5FA 100%);
        }

        .top-action-btn.logout {
        background: linear-gradient(135deg, #8338EC 0%, #C19BF5 100%);
        }

        .top-action-btn:active,
        .top-action-btn:focus,
        .top-action-btn:hover {
        opacity: 0.92;
        color: #fff !important;
        }

        /* Mobile Design */
        @@media only screen and (max-width: 480px) {
        body {
        background: #F9FAFB;
        justify-content: flex-start;
        padding-top: 0;
        min-height: 60vh;
        margin: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        }

        .top-curve-wrapper {
        position: absolute;
        top: -2px;
        left: -200px;
        width: 100%;
        height: 20vh;
        z-index: 2;
        }


        .top-curve-rect-1 {
        position: absolute;
        width: 300px;
        height: 300px;
        left: calc(50% - 150px);
        top: -150px;
        background: linear-gradient(128.97deg, #8338EC 2.4%, #C19BF5 85.87%);
        border-radius: 150px;
        z-index: 3;
        }

        .top-curve-rect-2 {
        position: absolute;
        width: 191.23px;
        height: 191.23px;
        left: calc(50% - 95.615px - 20px); /* Slight offset to center within purple */
        top: -100px;
        background: linear-gradient(151.12deg, #3A86FF 29.33%, #9CC3FF 86.49%);
        border-radius: 95.6133px;
        transform: rotate(-19.72deg);
        z-index: 4;
        }

        .mobile-header {
        position: absolute;
        display:contents;
        top: 0;
        left: 0;
        width: 100%;
        height: 30vh;
        min-height: 150px;
        background: linear-gradient(135deg, #8338EC, #3A86FF);
        border-radius: 0 0 50px 50px;
        z-index: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        }
        h2{
        margin-top:20vh;
        }

        h1 {
        display:none;
        font-size: 2.1rem;
        color: #FFFFFF;
        text-align: center;
        padding: 1rem;
        margin: 0;
        z-index: 3;
        }

        .login-container {
        position: absolute;
        top: 30vh;
        left: 50%;
        transform: translateX(-50%);
        width: 80%;
        max-width: 333px;
        background: none;
        box-shadow: none;
        border-radius: 0;
        z-index: 4;
        }

        .input-group {
        margin-bottom: 1rem;
        width: 90%;
        position: relative;
        z-index: 5;
        }

        .password-input-group {
        position: relative;
        margin-top: 1rem;
        margin-bottom: 1rem;
        z-index: 5;
        padding-left: 0; /* Reset any extra padding */
        width:100%;
        }

        select, input {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid #A26AF1;
        border-radius: 8px;
        box-sizing: border-box;
        background: rgba(255, 255, 255, 0.9);
        color: #333;
        }

        .password-input-group input[type="password"] {
        padding-right: 2.5rem;
        }

        .password-toggle {
        position: absolute;
        right: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: #A26AF1;
        cursor: pointer;
        z-index: 6;
        }

        .sign-in-btn {
        width: 100%;
        max-width: 333px;
        height: 56px;
        border: 2px solid #A26AF1;
        border-radius: 24px;
        background: linear-gradient(135deg, #8338EC, #3A86FF);
        color: #FFFFFF;
        font-size: 1.2rem;
        display: flex;
        justify-content: center;
        align-items: center;
        margin: 1rem auto;
        z-index: 5;
        }

        .sign-in-btn:active,
        .sign-in-btn:focus,
        .sign-in-btn:hover {
        background: linear-gradient(135deg, #3A86FF, #8338EC);
        color: #FFFFFF;
        }

        .forgot-password {
        margin-top: 1rem;
        color: rgba(31, 41, 55, 0.75);
        text-align: center;
        font-size: 1rem;
        z-index: 5;
        }

        /* after logged in */

        .logged-in-content > div:first-child {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 100;
        display: flex;
        margin-right:-20px;
        flex-direction: column;
        align-items: flex-end;
        gap: 10px;
        }

        .logged-in-actions {
        margin-top: auto; /* Move down further */
        text-align: center;
        width: 70%;
        max-width: 400px;
        margin-left: auto;
        margin-right: auto;
        margin-bottom: 30vh; /* Use viewport height for responsive spacing */
        }

        }
    </style>
</head>
<body>
    <div class="mobile-header" style="display: none;">
    </div>

    <div class="top-curve-wrapper">
        <div class="top-curve-rect-1"></div>
        <div class="top-curve-rect-2"></div>
    </div>
    <div class="mobile-header">
        <h2 style="color:white">Sign in</h2>
    </div>
    @if (!Model.IsLoggedIn)
    {                                            
        <div class="login-container">
            <h1>Sign in</h1>
            <form method="post">
                <input type="hidden" name="returnUrl" value="@(Request.Query["ReturnUrl"])" />
                <div class="input-group">
                    <label for="MatricNo">Matric No.</label>
                    <select asp-for="MatricNo" asp-items="Model.UserOptions" required>
                        <option value="">-- Pick a user --</option>
                    </select>
                    <div class="input-group password-input-group">
                        <label for="Password">Password</label>
                        <input type="password" asp-for="Password" required />
                    </div>
                </div>
                <button type="submit" class="sign-in-btn">Sign In</button>
            </form>
            <a href="#" class="forgot-password">Forgot Password?</a>
        </div>
    }
    else
    {
        <div class="logged-in-content">
            <div style="position:fixed;top:24px;right:32px;z-index:100;display:flex;gap:12px;">
                <a asp-page="/Index" class="top-action-btn home">Home</a>
                <form method="post" asp-page-handler="Logout" style="display:inline;">
                    <button type="submit" class="top-action-btn logout">Sign Out</button>
                </form>
            </div>
        </div>

        <div class="logged-in-actions" style="text-align:center;">
            <h1>Already Signed In</h1>
            <p>Hey,<strong>@Model.UserName</strong></p>
            @if (Model.Department != null && Model.Level != null)
            {
                <p> <b>Department:</b> @Model.Department</p>
                <p> <b>Level:</b> @Model.Level</p>
            }

            <nav>
                <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 20px; width: 100%; max-width: 400px;">

                    @if (Model.Role == "Admin")
                    {
                        <li class="nav-item">
                            <a asp-page="/Admin" class="nav-link big-nav-btn">Admin</a>
                        </li>
                    }
                    @if (Model.Role == "Lecturer")
                    {
                        <p><strong>Your students are waiting!</strong></p>

                        <li class="nav-item">
                            <a asp-page="/CreateSession" class="nav-link big-nav-btn">Create Session</a>
                        </li>
                    }
                    @if (Model.Role == "Student")
                    {
                        <p><strong>Classes are ongoing. You dont want to miss out!</strong></p>

                        <li class="nav-item">
                            <a asp-page="/JoinSession" class="nav-link big-nav-btn">Join Session</a>
                        </li>
                    }    
                </ul>
             </nav>
        </div>
           
        }
    <div id="messagePopup" class="message-popup">
        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <p>@Model.Message</p>
        }
    </div>
    <script>
            document.addEventListener('DOMContentLoaded', function() {
            const messagePopup = document.getElementById('messagePopup');

            if (messagePopup && messagePopup.innerText.trim() !== "") {
                // Show the popup
                messagePopup.classList.add('show');

                // Hide the popup after 5 seconds
                setTimeout(function() {
                    messagePopup.classList.remove('show');
                }, 5000); // 5000 milliseconds = 5 seconds
            }
        });

    </script>
</body>
</html>