<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VIIDII</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>$(NoWarn);CS8602;CS8603;CS8604;CS8618;CS8619;CS8629;CS8714</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="figma\**" />
    <Content Remove="figma\**" />
    <EmbeddedResource Remove="figma\**" />
    <None Remove="figma\**" />
    <!-- Exclude Aspire sub-projects from this web project -->
    <Compile Remove="VIIDII.AppHost\**" />
    <Content Remove="VIIDII.AppHost\**" />
    <EmbeddedResource Remove="VIIDII.AppHost\**" />
    <None Remove="VIIDII.AppHost\**" />
    <Compile Remove="VIIDII.ServiceDefaults\**" />
    <Content Remove="VIIDII.ServiceDefaults\**" />
    <EmbeddedResource Remove="VIIDII.ServiceDefaults\**" />
    <None Remove="VIIDII.ServiceDefaults\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".github\instructions\bug-reports.instructions.md" />
    <None Include=".github\instructions\bug-template.instructions.md" />
    <None Include=".github\instructions\copilot-instructions.md" />
    <None Include=".github\instructions\README.md" />
  </ItemGroup>
	
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="VIIDII.ServiceDefaults\VIIDII.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
